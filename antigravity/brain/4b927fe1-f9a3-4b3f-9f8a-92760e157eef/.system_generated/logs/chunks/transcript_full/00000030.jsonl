a(139, 92, 246, 0.15);\n}\n\n.quiz-option-btn:disabled {\n  cursor: default;\n}\n\n.quiz-option-btn.is-correct {\n  background: #ecfdf5 !important;\n  border: 2px solid #10b981 !important;\n  color: #065f46 !important;\n  font-weight: 800 !important;\n  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);\n}\n\n.quiz-option-btn.is-wrong {\n  background: #fff1f2 !important;\n  border: 2px solid #f43f5e !important;\n  color: #9f1239 !important;\n  font-weight: 700 !important;\n  opacity: 0.85;\n}\n\n.quiz-option-btn.is-revealed-correct {\n  background: #ecfdf5 !important;\n  border: 2px dashed #10b981 !important;\n  color: #065f46 !important;\n  font-weight: 700 !important;\n}\n\n.quiz-option-tag {\n  font-family: var(--font-sans);\n  font-size: 11px;\n  font-weight: 800;\n  padding: 2px 7px;\n  border-radius: 999px;\n  white-space: nowrap;\n}\n\n.quiz-option-tag.tag-correct {\n  background: #10b981;\n  color: #ffffff;\n}\n\n.quiz-option-tag.tag-wrong {\n  background: #f43f5e;\n  color: #ffffff;\n}\n\n.quiz-explanation-box {\n  background: #ffffff;\n  border: 1px solid #ddd6fe;\n  border-left: 4px solid #8b5cf6;\n  border-radius: 6px;\n  padding: 10px 14px;\n  font-size: 14px;\n  color: #1e1b4b;\n  line-height: 1.5;\n  animation: popIn 0.35s ease;\n}\n\n.quiz-explanation-box strong {\n  color: #5b21b6;\n}\n\n.quiz-explanation-box code {\n  font-family: var(--font-mono);\n  font-size: 13px;\n  background: #f5f3ff;\n  padding: 2px 6px;\n  border-radius: 4px;\n  color: #4338ca;\n  font-weight: 700;\n}\n\n.quiz-actions-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  margin-top: 4px;\n}\n\n.btn-quiz-continue {\n  background: #7c3aed;\n  color: #ffffff;\n  border: none;\n  font-family: var(--font-sans);\n  font-size: 13.5px;\n  font-weight: 700;\n  padding: 7px 16px;\n  border-radius: 6px;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  transition: all 0.15s ease;\n}\n\n.btn-quiz-continue:hov