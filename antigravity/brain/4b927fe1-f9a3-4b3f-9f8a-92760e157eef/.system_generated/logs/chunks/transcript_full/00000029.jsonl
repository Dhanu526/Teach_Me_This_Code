s.showAdvanced;\n225:       this.advancedViewPanel.classList.toggle(\"hidden\", !this.showAdvanced);\n226:       this.btnToggleAdvanced.classList.toggle(\"active\", this.showAdvanced);\n227:       this.btnToggleAdvanced.textContent = this.showAdvanced\n228:         ? \"Hide Advanced View\"\n229:         : \"Advanced View\";\n230:       if (this.showAdvanced) {\n231:         this.renderStep();\n232:       }\n233:     });\n234: \n235:     this.btnEditCode.addEventListener(\"click\", () => {\n236:       if (this.isEditing) {\n237:         this.sourceCode = this.codeTextarea.value;\n238:         this.inputCode = \"\";\n239:         this.setEditMode(false);\n240:         this.analyzeAndRun();\n241:       } else {\n242:         this.setEditMode(true);\n243:       }\n244:     });\n245: \n246:     this.btnAnalyzeCode.addEventListener(\"click\", () => {\n247:       this.sourceCode = this.codeTextarea.value;\n248:       this.inputCode = \"\";\n249:       this.setEditMode(false);\n250:       this.analyzeAndRun();\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
