nt-sans);\n  font-size: 13.5px;\n  font-weight: 800;\n  padding: 3px 12px;\n  border-radius: 999px;\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  letter-spacing: 0.3px;\n  animation: decisionSpring calc(0.45s * var(--anim-speed-factor, 1)) cubic-bezier(0.175, 0.885, 0.32, 1.275);\n}\n\n.decision-badge.is-true {\n  background: #ecfdf5;\n  border: 1.5px solid #10b981;\n  color: #065f46;\n  box-shadow: 0 1px 5px rgba(16, 185, 129, 0.25);\n}\n\n.decision-badge.is-false {\n  background: #fff1f2;\n  border: 1.5px solid #f43f5e;\n  color: #9f1239;\n  box-shadow: 0 1px 5px rgba(244, 63, 94, 0.25);\n}\n\n.decision-badge.is-pending {\n  background: #fef3c7;\n  border: 1.5px solid #f59e0b;\n  color: #92400e;\n  box-shadow: 0 1px 4px rgba(245, 158, 11, 0.2);\n}\n\n.branch-decision-wrap {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 10px;\n}\n\n.branch-option {\n  border: 1.5px solid var(--border-light);\n  border-radius: 8px;\n  padding: 6px 11px;\n  background: #ffffff;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  transition: all 0.2s ease;\n}\n\n.branch-option-tag {\n  font-size: 11.5px;\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n  padding: 2px 8px;\n  border-radius: 999px;\n  align-self: flex-start;\n}\n\n.branch-option code {\n  font-family: var(--font-mono);\n  font-size: 14.5px;\n  font-weight: 700;\n}\n\n.branch-option.is-active-branch {\n  border: 2px solid #10b981;\n  background: #f0fdf4;\n  box-shadow: 0 2px 8px rgba(16, 185, 129, 0.2);\n  animation: activeBranchPop calc(0.4s * var(--anim-speed-factor, 1)) ease-out;\n}\n\n.branch-option.is-active-branch .branch-option-tag {\n  background: #10b981;\n  color: #ffffff;\n}\n\n.branch-option.is-active-branch code {\n  color: #065f46;\n}\n\n.branch-option.is-skipped-branch {\n  border: 1.5px dashed #cbd5e1;\n  background: #f8fafc;\n  opacity: 0.6;\n}\n\n.branch-option.is-skipped-branch .branch-option-tag {\n  background: #e2e8f0;\n  color: