    return False, f\"Unsupported Construct: {msg}\", getattr(node, \"lineno\", 1)\n95: \n96:         if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):\n97:             if node.func.id in FORBIDDEN_CALLS:\n98:                 return (\n99:                     False,\n100:                     f\"Restricted Function: `{node.func.id}()` is disabled for security.\",\n101:                     getattr(node, \"lineno\", 1),\n102:                 )\n103: \n104:     return True, None, None\n105: \n106: \n107: def format_py_val(val: Any) -> str:\n108:     if isinstance(val, str):\n109:         return repr(val)\n110:     if isinstance(val, (int, float, bool, list, dict, tuple, set)) or val is None:\n111:         return repr(val)\n112:     return f\"<{type(val).__name__} instance>\"\n113: \n114: \n115: def get_py_type(val: Any) -> str:\n116:     if val is None:\n117:         return \"NoneType\"\n118:     return type(val).__name__\n119: \n120: \n121: def trace_python_program(\n122:     source_code: str,\n123:     custom_input_code: str = \"\",\n124:     max_steps: int = 400,\n125: ) -> Dict[str, Any]:\n126:     \"\"\"\n127:     Executes supported Python code step-by-step using `sys.settrace` and AST inspection.\n128:     If the code defines `class Solution:` with a method (like `maxSubArray`) and does not\n129:     invoke it at the bottom, automatically appends the invocation using `custom_input_code`.\n130:     \"\"\"\n131:     is_valid, err_msg, err_line = validate_python_support(source_code)\n132:     raw_lines = source_code.replace(\"\\r\\n\", \"\\n\").split(\"\\n\")\n133: \n134:     if not is_valid:\n135:         return {\n136:             \"ok\": False,\n137:             \"errorType\": \"VALIDATION_ERROR\",\n138:             \"errorMessage\": err_msg,\n139:             \"errorLine\": err_line,\n140:             \"rawLines\": raw_lines,\n141:             \"steps\": [],\n142:         }\n143: \n144:     # Check if custom_input_code has syntax errors\n145:     if custom_input_code.strip():\n146:         in_valid, in_err, in_line = validate_python_support(custom_input_code)\n147:         if not in_valid:\n148:             return {\n149:                 \"ok\": False,\n150:                 \"errorType\": \"INPUT_ERROR\",\n151:                 \"errorMessage\": f\"Invalid Input Playground value: {in_err}\",\n152:                 \"errorLine\": in_line,\n153:                 \"rawLines\": raw_lines,\n154:                 \"steps\": [],\n155:             }\n156: \n157:     full_code = source_code\n158:     has_solution_class = \"class Solution\" in source_code and \"def maxSubArray\" in source_code\n159:     has_explicit_call = (\n160:         \"Solution()\" in source_code\n161:         or \"maxSubArray(\" in source_code.split(\"def maxSubArray\")[-1]\n162:     )\n163: \n164:     if has_solution_class and not has_explicit_call:\n165:         input_line = custom_input_code.strip() or \"nums = [-2, 1, -3, 4, -1, 2, 1, -5, 4]\"\n166:         full_code = (\n167:             source_code.rstrip()\n168:             + \"\\n\\n# --- Runner Invocation ---\\n\"\n169:             + input_line\n170:             + \"\\nresult = Solution().maxSubArray(nums)\\n\"\n171:         )\n172:         raw_lines = full_code.replace(\"\\r\\n\", \"\\n\").split(\"\\n\")\n173: \n174:     tree = ast.parse(full_code)\n175:     line_ast_map: Dict[int, ast.AST] = {}\n176:     for node in ast.walk(tree):\n177:         if hasattr(node, \"lineno\") and isinstance(\n178:             node,\n179:             (\n180:                 ast.Assign,\n181:                 ast.AugAssign,\n182:                 ast.AnnAssign,\n183:                 ast.If,\n184:                 ast.For,\n185:                 ast.While,\n186:                 ast.Return,\n187:                 ast.FunctionDef,\n188:                 ast.ClassDef,\n189:                 ast.Expr,\n190:                 ast.Break,\n191:                 ast.Continue,\n192:             ),\n193:         ):\n194:         