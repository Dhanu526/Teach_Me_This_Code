rame(stmt_node.test, frame))\n238:                 left_str, op_str, right_str = \"\", \"\", \"\"\n239:                 if isinstance(stmt_node.test, ast.Compare) and len(stmt_node.test.ops) == 1:\n240:                     lval = eval_in_frame(stmt_node.test.left, frame)\n241:                     rval = eval_in_frame(stmt_node.test.comparators[0], frame)\n242:                     op_map = {\n243:                         ast.Eq: \"==\",\n244:                         ast.NotEq: \"!=\",\n245:                         ast.Lt: \"<\",\n246:                         ast.LtE: \"<=\",\n247:                         ast.Gt: \">\",\n248:                         ast.GtE: \">=\",\n249:                     }\n250:                     op_str = op_map.get(type(stmt_node.test.ops[0]), \"?\")\n251:                     left_str = format_py_val(lval)\n252:                     right_str = format_py_val(rval)\n253:                 condition_info = {\n254:                     \"expr\": ast.unparse(stmt_node.test) if hasattr(ast, \"unparse\") else code_text,\n255:                     \"leftVal\": left_str,\n256:                     \"operator\": op_str,\n257:                     \"rightVal\": right_str,\n258:                     \"result\": cond_val,\n259:                 }\n260:             except Exception:\n261:                 pass\n262: \n263:         if event == \"line\" and isinstance(stmt_node, (ast.For, ast.While)):\n264:             key = (frame_id, lineno)\n265:             loop_iter_counts[key] = loop_iter_counts.get(key, 0) + 1\n266:             loop_info = {\n267:                 \"loopType\": \"for\" if isinstance(stmt_node, ast.For) else \"while\",\n268:                 \"iteration\": loop_iter_counts[key],\n269:             }\n270: \n271:         if event == \"line\" and isinstance(stmt_node, ast.AugAssign):\n272:             try:\n273:                 target_name = stmt_node.target.id if isinstance(stmt_node.target, ast.Name) else \"var\"\n274:                 before_v = current_vars.get(target_name)\n275:                 rhs_v = eval_in_frame(stmt_node.value, frame)\n276:                 op_char = (\n277:                     \"+\"\n278:                     if isinstance(stmt_node.op, ast.Add)\n279:                     else \"-\"\n280:                     if isinstance(stmt_node.op, ast.Sub)\n281:                     else \"*\"\n282:                 )\n283:                 operation_detail = {\n284:                     \"kind\": \"aug_assign\",\n285:                     \"target\": target_name,\n286:                     \"beforeVal\": format_py_val(before_v),\n287:                     \"rhsExpr\": ast.unparse(stmt_node.value) if hasattr(ast, \"unparse\") else \"\",\n288:                     \"rhsVal\": format_py_val(rhs_v),\n289:                     \"op\": op_char,\n290:                 }\n291:             except Exception:\n292:                 pass\n293: \n294:         var_inspector_rows = []\n295:         changed_vars = []\n296:         for k, v in current_vars.items():\n297:             curr_str = format_py_val(v)\n298:             if k not in prev_map:\n299:                 status = \"created\"\n300:                 prev_str = \"—\"\n301:                 changed_vars.append({\"name\": k, \"prev\": \"—\", \"curr\": curr_str, \"status\": \"created\"})\n302:             elif format_py_val(prev_map[k]) != curr_str:\n303:                 status = \"updated\"\n304:                 prev_str = format_py_val(prev_map[k])\n305:                 changed_vars.append({\"name\": k, \"prev\": prev_str, \"curr\": curr_str, \"status\": \"updated\"})\n306:             else:\n307:                 status = \"unchanged\"\n308:                 prev_str = curr_str\n309: \n310:             var_inspector_rows.append(\n311:                 {\n312:                     \"name\": k,\n313:                     \"previous\": prev_str,\n314:                     \"current\": curr_str,\n315:                     \"rawValue\": v if isinstance(v, (int, float, bool, str, list)) else curr_str,\n316:                     \"type\": get_py_type(v),\n317:                     \"status\": status,\n318:                 }\n319:             )\n320: \n321:         prev_vars_by_frame[frame_id] = copy.deepcopy(current_vars)\n322: \n323:         steps.append(\n324:             {\n325:                 \"stepIndex\": len(steps) + 1,\n326:                 \"event\": event,\n327:                 \"line\": lineno,\n328:                 \"codeText\": code_text,\n329:                 \"functionName\": scope_title,\n330:                 \"variables\": var_inspector_rows,\n331:                 \"changedVars\": changed_vars,\n332:                 \"condition\": condition_info,\n333:                 \"loop\": loop_info,\n334:                 \"operationDetail\": operation_detail,\n335:                 \"returnValue\": format_py_val(arg) if event == \"return\" else None,\n336:                 \"stdout\": stdout_buf.getvalue().splitlines(),\n337:             }\n338:         )\n339: \n340:     def trace_dispatch(frame, event, arg):\n341:         if frame.f_code.co_filename != \"<user_code>\":\n342:             return trace_dispatch\n343:         if event in (\"line\", \"call\", \"return\"):\n344:             record_snapshot(frame, event, arg)\n345:         return trace_dispatch\n346: \n347:     compiled = compile(full_code, \"<user_code>\", \"exec\")\n348:     sandbox_globals = {\"__builtins__\": SUPPORTED_BUILTINS, \"__name__\": \"__main__\"}\n349:     old_stdout = sys.stdout\n350:     error_info = None\n351: \n352:     try:\n353:         sys.stdout = stdout_buf\n354:         sys.settrace(trace_dispatch)\n355:         exec(compiled, sandbox_globals)\n356:     except Exception as exc:\n357:         tb = sys.exc_info()[2]\n358:         err_ln = 1\n359:         while tb is not None:\n360:             if tb.tb_frame.f_code.co_filename == \"<user_code>\":\n361:                 err_ln = tb.tb_lineno\n362:             tb = tb.tb_next\n363:         error_info = {\n364:             \"type\": type(exc).__name__,\n365:             \"message\": str(exc),\n366:             \"line\": err_ln,\n367:         }\n368:     finally:\n369:         sys.settrace(None)\n370:         sys.stdout = old_stdout\n371: \n372:     aligned_steps = _align_post_execution_variables(steps)\n373: \n374:     return {\n375:         \"ok\": error_info is None,\n376:         \"error\": error_info,\n377:         \"rawLines\": raw_lines,\n378:         \"steps\": aligned_steps,\n379:         \"finalResult\": format_py_val(sandbox_globals.get(\"result\")) if \"result\" in sandbox_globals else None,\n380:     }\n381: \n382: \n383: def _align_post_execution_variables(raw_steps: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n384:     if not raw_steps:\n385:         return []\n386: \n387:     aligned = []\n388:     for i, step in enumerate(raw_steps):\n389:         step_copy = copy.deepcopy(step)\n390:         before_vars = {v[\"name\"]: v[\"current\"] for v in step[\"variables\"]}\n391: \n392:         after_vars_list = step[\"variables\"]\n393:         for j in range(i + 1, len(raw_steps)):\n394:             if raw_steps[j][\"functionName\"] == step[\"functionName\"]:\n395:                 after_vars_list = raw_steps[j][\"variables\"]\n396:                 break\n397: \n398:         recomputed_vars = []\n399:         changed_summary = []\n400:         for v in after_vars_list:\n401:             name = v[\"name\"]\n402:             curr_val = v[\"current\"]\n403:             if name not in before_vars:\n404:                 status = \"created\"\n405:                 prev_val = \"—\"\n406:                 changed_summary.append(f\"{name}: (created) -> {curr_val}\")\n407:             elif before_vars[name] != curr_val:\n408:                 status = \"updated\"\n409:                 prev_val = before_vars[name]\n410:                 changed_summary.append(f\"{name}: {prev_val} -> {curr_val}\")\n411:             else:\n412:                 status = \"unchanged\"\n413:  