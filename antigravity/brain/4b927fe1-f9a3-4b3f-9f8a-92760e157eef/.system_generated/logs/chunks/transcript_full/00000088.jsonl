MockElement {\n26:   constructor(tagName = 'div', id = '') {\n27:     this.tagName = tagName.toUpperCase();\n28:     this.id = id;\n29:     this.className = '';\n30:     this.classList = {\n31:       classes: new Set(),\n32:       add: (c) => this.classList.classes.add(c),\n33:       remove: (c) => this.classList.classes.delete(c),\n34:       contains: (c) => this.classList.classes.has(c),\n35:       toggle: (c) => {\n36:         if (this.classList.classes.has(c)) this.classList.classes.delete(c);\n37:         else this.classList.classes.add(c);\n38:       }\n39:     };\n40:     this.innerHTML = '';\n41:     this.value = '';\n42:     this.textContent = '';\n43:     this.attributes = new Map();\n44:     this.eventListeners = {};\n45:     this.children = [];\n46:   }\n47: \n48:   getAttribute(name) {\n49:     return this.attributes.get(name) || null;\n50:   }\n51: \n52:   setAttribute(name, val) {\n53:     this.attributes.set(name, String(val));\n54:   }\n55: \n56:   addEventListener(event, fn) {\n57:     if (!this.eventListeners[event]) this.eventListeners[event] = [];\n58:     this.eventListeners[event].push(fn);\n59:   }\n60: \n61:   dispatchEvent(event) {\n62:     const list = this.eventListeners[event.type] || [];\n63:     list.forEach(fn => fn(event));\n64:   }\n65: \n66:   querySelector(selector) {\n67:     return new MockElement('div');\n68:   }\n69: \n70:   querySelectorAll(selector) {\n71:     return [];\n72:   }\n73: \n74:   scrollIntoView() {}\n75:   remove() {}\n76: }\n77: \n78: const mockLocalStorage = {\n79:   store: {},\n80:   getItem(k) { return this.store[k] !== undefined ? this.store[k] : null; },\n81:   setItem(k, v) { this.store[k] = String(v); },\n82:   removeItem(k) { delete this.store[k]; },\n83:   clear() { this.store = {}; }\n84: };\n85: \n86: const sandbox = {\n87:   window: {\n88:     location: { hash: '', origin: 'http://localhost', pathname: '/' },\n89:     history: { replaceState: () => {} },\n90:     navigator: { clipboard: { writeText: () => Promise.resolve() } },\n91:     addEventListener: () => {},\n92:     scrollTo: () => {},\n93:     confirm: () => true,\n94:     prompt: () => 'RESET',\n95:     alert: () => {}\n96:   },\n97:   document: {\n98:     body: new MockElement('body'),\n99:     getElementById: (id) => new MockElement('div', id),\n100:     querySelector: () => new MockElement('div'),\n101:     querySelectorAll: () => [],\n102:     createElement: (tag) => new MockElement(tag)\n103:   },\n104:   localStorage: mockLocalStorage,\n105:   console: console,\n106:   setTimeout: (fn) => fn(),\n107:   clearTimeout: () => {}\n108: };\n109: \n110: sandbox.window.document = sandbox.document;\n111: sandbox.window.localStorage = sandbox.localStorage;\n112: \n113: vm.createContext(sandbox);\n114: vm.runInContext(engineCode, sandbox);\n115: vm.runInContext(problemsCode, sandbox);\n116: vm.runInContext(solutionsCode, sandbox);\n117: vm.runInContext(dashboardCode, sandbox);\n118: \n119: let testsPassed = 0;\n120: function pass(msg) {\n121:   testsPassed++;\n122:   console.log(`  ✓ [PASS] ${msg}`);\n123: }\n124: \n125: // -----------------------------------------------------------------------------\n126: // [TEST SECTION 1]: Local Persistence Verification (Zero Cloud Backend)\n127: // -----------------------------------------------------------------------------\n128: console.log('\\n[1] Testing Local Storage Persistence Components:');\n129: \n130: const dsa = new sandbox.window.DsaDashboard();\n131: assert(dsa.indexedDbBackup, 'IndexedDB backup manager instantiated');\n132: pass('IndexedDB offline backup manager instantiated');\n133: \n134: // 1. Mark problem 1 (Two Sum) and 3 (Valid Anagram) solved\n135: dsa.markSolved(1);\n136: dsa.markSolved(3);\n137: // 2. Mark problem 33 attempted\n138: dsa.markAttempted(33);\n139: // 3. Bookmark problem 52\n140: dsa.toggleBookmark(52);\n141: // 4. Mark review 69\n142: dsa.toggleReview(69);\n143: // 5. Add personal notes for problem 1\n144: dsa.saveNote(1, 'Use hash map complement lookup in O(n) single pass.');\n145: // 6. Save user code\n146: dsa.saveUserCode(1, 'def twoSum(nums, target):\\n    seen = {}\\n    for i, n in enumerate(nums):\\n        if target - n in seen: return [seen[target - n], i]\\n        seen[n] = i');\n147: // 7. Set active stage to 4\n148: dsa.setActiveStage(4);\n149: // 8. Open problem 89 (Binary Search)\n150: dsa.openProblemWorkspace(89);\n151: // 9. Save preferred learning settings\n152: dsa.saveSettings({ pageSize: 50, selectedSort: 'diff_asc', codeFontSize: '15px', animationSpeed: 'fast' });\n153: \n154: // Verify keys in localStorage\n155: assert(mockLocalStorage.getItem('dsa_learning_progress_v1'), 'dsa_learning_progress_v1 present in localStorage');\n156: assert(mockLocalStorage.getItem('dsa_user_code_v1'), 'dsa_user_code_v1 present in localStorage');\n157: assert(mockLocalStorage.getItem('dsa_learning_settings_v1'), 'dsa_learning_settings_v1 present in localStorage');\n158: assert.strictEqual(mockLocalStorage.getItem('dsa_active_stage'), '4', 'dsa_active_stage saved as 4');\n159: pass('All progress facets successfully stored in local computer storage');\n160: \n161: // -----------------------------------------------------------------------------\n162: // [TEST SECTION 2]: Page Refresh & Application Restart Restoration\n163: // -----------------------------------------------------------------------------\n164: console.log('\\n[2] Testing State Restoration Across Page Refresh / App Restart:');\n165: \n166: // Create brand new DsaDashboard instance (simulating browser reload / restart)\n167: const reloadedDsa = new sandbox.window.DsaDashboard();\n168: \n169: assert(reloadedDsa.progress.solved.includes(1), 'Problem 1 solved status restored');\n170: assert(reloadedDsa.progress.solved.includes(3), 'Problem 3 solved status restored');\n171: assert(reloadedDsa.progress.attempted.includes(33), 'Problem 33 attempted status restored');\n172: assert(reloadedDsa.progress.bookmarked.includes(52), 'Problem 5