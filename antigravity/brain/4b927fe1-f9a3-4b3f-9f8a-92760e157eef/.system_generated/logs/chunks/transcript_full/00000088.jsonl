 contains user code');\n197: \n198: const downloadResult = reloadedDsa.downloadProgressBackup();\n199: assert(downloadResult.success, 'downloadProgressBackup executes successfully');\n200: assert(downloadResult.fileName.startsWith('teach_me_this_code_backup_'), 'Backup filename format verified');\n201: pass('Export Progress produces structured, comprehensive JSON backup');\n202: \n203: // -----------------------------------------------------------------------------\n204: // [TEST SECTION 4]: Pre-Import Validation & Corruption Protection\n205: // -----------------------------------------------------------------------------\n206: console.log('\\n[4] Testing Pre-Import Validation & Corruption Protection:');\n207: \n208: // Test 1: Empty input\n209: const valEmpty = reloadedDsa.validateProgressImport('');\n210: assert.strictEqual(valEmpty.isValid, false, 'Empty input must be rejected');\n211: assert(valEmpty.errors.length > 0, 'Produces error for empty input');\n212: pass('Validation rejects empty input');\n213: \n214: // Test 2: Malformed JSON syntax\n215: const valMalformedJson = reloadedDsa.validateProgressImport('{ \"progress\": { \"solved\": [1, 2, }');\n216: assert.strictEqual(valMalformedJson.isValid, false, 'Malformed JSON must be rejected');\n217: assert(valMalformedJson.errors[0].includes('Invalid JSON'), 'Provides specific syntax error');\n218: pass('Validation rejects malformed JSON without crashing');\n219: \n220: // Test 3: Root not an object\n221: const valArrayRoot = reloadedDsa.validateProgressImport('[1, 2, 3]');\n222: assert.strictEqual(valArrayRoot.isValid, false, 'Non-object root must be rejected');\n223: pass('Validation rejects invalid root schema');\n224: \n225: // Test 4: Completely empty object without data\n226: const valEmptyObj = reloadedDsa.validateProgressImport({});\n227: assert.strictEqual(valEmptyObj.isValid, false, 'Empty object must be rejected');\n228: pass('Validation rejects empty backup file without progress');\n229: \n230: // Test 5: Verify corruption protection\n231: // Attempt to import corrupted input -> existing progress MUST NOT change!\n232: const existingSolvedSnapshot = [...reloadedDsa.progress.solved];\n233: try {\n234:   reloadedDsa.importProgress('{ invalid json }');\n235:   assert.fail('Should have thrown error on malformed import');\n236: } catch (e) {\n237:   // Expected\n238: }\n239: assert.deepStrictEqual(reloadedDsa.progress.solved, existingSolvedSnapshot, 'Existing solved list remained uncorrupted');\n240: pass('Malformed imports are blocked: existing progress is 100% protected against corruption');\n241: \n242: // -----------------------------------------------------------------------------\n243: // [TEST SECTION 5]: Import Strategies (Merge vs. Replace)\n244: // -----------------------------------------------------------------------------\n245: console.log('\\n[5] Testing Import Strategies (Merge vs. Replace):');\n246: \n247: const backupToImport = {\n248:   $schema: 'teach_me_this_code_progress_v1',\n249:   version: '1.0',\n250:   progress: {\n251:     solved: [1, 2, 10], // Note: 1 was already solved, 2 and 10 are new\n252:     attempted: [20],\n253:     bookmarked: [15],\n254:     notes: {\n255:       '2': 'Contains duplicate with hash set in O(n).'\n256:     },\n257:     lastOpenedProblemId: 10\n258:   },\n259:   roadmap: {\n260:     activeStage: 2\n261:   },\n262:   settings: {\n263:     pageSize: 100\n264:   },\n265:   userCode: {\n266:     '10': 'def singleNumber(nums):\\n    res = 0\\n    for n in nums: res ^= n\\n    return res'\n267:   }\n268: };\n269: \n270: // 1. Test Merge Strategy\n271: const mergeResult = reloadedDsa.importProgress(backupToImport, { mode: 'merge' });\n272: assert(mergeResult.success, 'Merge import succeeded');\n273: // Solved should now include 1, 3 (from before) AND 2, 10 (from import)\n274: assert(reloadedDsa.progress.solved.includes(1), 'Problem 1 preserved in merge');\n275: assert(reloadedDsa.progress.solved.includes(3), 'Problem 3 preserved in merge');\n276: assert(reloadedDsa.progress.solved.includes(2), 'Problem 2 added from merge');\n277: assert(reloadedDsa.progress.solved.includes(10), 'Problem 10 added from merge');\n278: // Notes: problem 1 note preserved AND problem 2 note added\n279: assert(reloadedDsa.getNote(1).includes('hash map complement'), 'Original note 1 preserved in merge');\n280: assert(reloadedDsa.getNote(2).includes('hash set'), 'Imported note 2 merged');\n281: assert(reloadedDsa.getUserCode(10).includes('singleNumber'), 'Imported code 10 merged');\n282: pass('Merge strategy successfully combines incoming and existing data without data loss');\n283: \n284: // 2. Test Replace Strategy\n285: const freshReplaceBackup = {\n286:   progress: {\n287:     solved: [89],\n288:     attempted: [],\n289:     bookmarked: [],\n290:     notes: { '89': 'Binary search template [low, high]' },\n291:     lastOpenedProblemId: 89\n292:   },\n293:   roadmap: { activeStage: 4 },\n294:   settings: { pageSize: 25 },\n295:   userCode: { '89': 'def search(nums, target): return -1' }\n296: };\n297: \n298: const replaceResult = reloadedDsa.importProgress(freshReplaceBackup, { mode: 'replace' });\n299: assert(replaceResult.success, 'Replace import succeeded');\n300: assert.deepStrictEqual(reloadedDsa.progress.solved, [89], 'Solved list replaced cleanly');\n301: assert.strictEqual(reloadedDsa.getNote(1), '', 'Old note 1 cleared in replace');\n302: assert(reloadedDsa.getNote(89).includes('Binary search'), 'New note 89 active');\n303: assert.strictEqual(reloadedDsa.pageSize, 25, 'Settings replaced');\n304: pass('Replace strategy cleanly overwrites local storage with verified backup data');\n305: \n306: // -----------------------------------------------------------------------------\n307: // [TEST SECTION 6]: UI Modal, Notice & Reset Protection\n308: // -----------------------------------------------------------------------------\n309: console.log('\\n[6] Testing UI Notice, Modal & Reset Protection:');\n310: \n311: // Notice text test\n312: assert(stylesCss.includes('.storage-notice-banner'), 'CSS includes .storage-notice-banner');\n313: assert(stylesCss.includes('.storage-validation-box'), 'CSS includes .storage-validation-box');\n314: assert(stylesCss.includes('.btn-header-storage'), 'CSS includes .btn-header-storage');\n315: pass('Storage notice, validation boxes, and header button styles verified in CSS');\n316: \n317: // Test resetProgress requires 'RESET' password\n318: const resetFailed = reloadedDsa.resetProgress('wrong_password');\n319: assert.strictEqual(resetFailed, false, 'Reset rejected on invalid password');\n320: assert.strictEqual(reloadedDsa.progress.solved.length, 1, 'Progress preserved when reset rejected');\n321: \n322: const resetSuccess = reloadedDsa.resetProgress('RESET');\n323: assert.strictEqual(resetSuccess, true, 'Reset approved on RESET keyword');\n324: assert.strictEqual(reloadedDsa.progress.solved.length, 0, 'Progress reset to empty');\n325: assert.strictEqual(reloadedDsa.activeStage, 1, 'Active stage reset to 1');\n326: pass('Reset protection requires explicit confirmation keyword');\n327: \n328: // -----------------------------------------------------------------------------\n329: // [TEST SECTION 7]: Visualizer Non-Negotiable (Kadane = 6)\n330: // -----------------------------------------------------------------------------\n331: console.log('\\n[7] Testing Visualizer Execution & Non-Negotiables:');\n332: \n333: const engine = new sandbox.window.PythonExecutionEngine();\n334: const kadaneCode = `nums = [-2, 1, -3, 4, -1, 2, 1, -5, 4]\n335: c = 0\n336: ans = nums[0]\n337: for i in range(len(nums)):\n338:     c += nums[i]\n339:     if c >= ans:\n340:         ans = c\n341:     if c < 0:\n342:         c = 0\n343: print(ans)`;\n344: \n345: const rawDefault = engine.trace(kadaneCode, \"\");\n346: assert(rawDefault && rawDefault.ok === true, 'Execution must succeed with ok: true');\n347: assert.strictEqual(String(rawDefault.finalResult), '6', 'K