\r\n1915:       }\r\n1916: \r\n1917:       return list;\r\n1918:     }\r\n1919: \r\n1920:     renderProblemTableContent(topicOverride = null) {\r\n1921:       const filtered = this.getFilteredProblems(topicOverride);\r\n1922:       const totalFiltered = filtered.length;\r\n1923: \r\n1924:       const totalPages = Math.max(1, Math.ceil(totalFiltered / this.pageSize));\r\n1925:       if (this.currentPage > totalPages) this.currentPage = totalPages;\r\n1926:       const startIdx = (this.currentPage - 1) * this.pageSize;\r\n1927:       const paginated = filtered.slice(startIdx, startIdx + this.pageSize);\r\n1928: \r\n1929:       if (totalFiltered === 0) {\r\n1930:         return `\r\n1931:           <div class=\"empty-state-box\">\r\n1932:             <div class=\"empty-state-icon\">🔍</div>\r\n1933:             <p class=\"empty-state-text\">No problems match your current search and filter criteria.</p>\r\n1934:             <button class=\"btn-hero-primary\" data-action=\"clear-filters\">Reset All Filters</button>\r\n1935:           </div>\r\n1936:         `;\r\n1937:       }\r\n1938: \r\n1939:       const rows = paginated.map(p => {\r\n1940:         const isSolved = this.progress.solved.includes(p.id);\r\n1941:         const isAttempted = this.progress.attempted.includes(p.id) && !isSolved;\r\n1942:         const isBookmarked = this.isBookmarked(p.id);\r\n1943:         const diffClass = p.difficulty.toLowerCase();\r\n1944: \r\n1945:         // Render multi-topic badges (up to 3)\r\n1946:         const topicList = p.topics && p.topics.length > 0 ? p.topics : [p.topic];\r\n1947:         const topicBadges = topicList.slice(0, 3).map(top => {\r\n1948:           return `<button class=\"mini-topic-chip\" data-open-topic=\"${this.escapeHTML(top)}\">${this.escapeHTML(top)}</button>`;\r\n1949:         }).join('');\r\n1950:         const moreTopics = topicList.length > 3 ? `<span class=\"more-topics-tag\">+${topicList.length - 3}</span>` : '';\r\n1951: \r\n1952:         return `\r\n1953:           <tr class=\"problem-row ${isSolved ? 'row-solved' : ''}\">\r\n1954:             <td class=\"col-star\">\r\n1955:               <button class=\"star-btn ${isBookmarked ? 'active' : ''}\" data-action=\"toggle-bookmark\" data-id=\"${p.id}\" title=\"${isBookmarked ? 'Remove bookmark' : 'Bookmark for revision'}\">\r\n1956:                 ${isBookmarked ? '★' : '☆'}\r\n1957:               </button>\r\n1958:             </td>\r\n1959: \r\n1960:             <td class=\"col-lc\">\r\n1961:               <span class=\"lc-badge\">#${p.leetcodeNumber}</span>\r\n1962:             </td>\r\n1963: \r\n1964:             <td class=\"col-title\">\r\n1965:               <div class=\"title-wrap\">\r\n1966:                 <a href=\"javascript:void(0)\" class=\"problem-title-link\" data-action=\"view-problem-details\" data-id=\"${p.id}\">\r\n1967:                   ${this.escapeHTML(p.title)}\r\n1968:                 </a>\r\n1969:                 ${this.hasNote(p.id) ? '<span class=\"note-pill-indicator\" title=\"Personal learning note saved\">📝</span>' : ''}\r\n1970:                 <span class=\"pattern-chip\" title=\"Algorithm Pattern\">${this.escapeHTML(p.pattern)}</span>\r\n1971:               </div>\r\n1972:             </td>\r\n1973: \r\n1974:             <td class=\"col-topics-multi\">\r\n1975:               <div class=\"multi-topics-wrap\">\r\n1976:                 ${topicBadges}\r\n1977:                 ${moreTopics}\r\n1978:               </div>\r\n1979:             </td>\r\n1980: \r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
