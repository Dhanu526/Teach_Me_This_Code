onst svgW = 320;\n532:     const svgH = Math.max(180, cfg.nodes.length * vGap + 30);\n533: \n534:     const positions = {};\n535:     cfg.nodes.forEach((n, idx) => {\n536:       positions[n.id] = { x: svgW / 2, y: 26 + idx * vGap };\n537:     });\n538: \n539:     let edgesSVG = \"\";\n540:     cfg.edges.forEach((edge) => {\n541:       const p1 = positions[edge.from];\n542:       const p2 = positions[edge.to];\n543:       if (!p1 || !p2) return;\n544:       const stroke = edge.isBackEdge ? \"#2563eb\" : \"#cbd5e1\";\n545:       if (edge.isBackEdge || p2.y <= p1.y) {\n546:         edgesSVG += `<path d=\"M ${p1.x - nodeW / 2} ${p1.y} C 22 ${p1.y}, 22 ${p2.y}, ${p2.x - nodeW / 2} ${p2.y}\" fill=\"none\" stroke=\"${stroke}\" stroke-width=\"1.5\" stroke-dasharray=\"4 2\" />`;\n547:       } else {\n548:         edgesSVG += `<line x1=\"${p1.x}\" y1=\"${p1.y + nodeH / 2}\" x2=\"${p2.x}\" y2=\"${p2.y - nodeH / 2}\" stroke=\"${stroke}\" stroke-width=\"1.5\" />`;\n549:       }\n550:     });\n551: \n552:     let nodesSVG = \"\";\n553:     cfg.nodes.forEach((node) => {\n554:       const pos = positions[node.id];\n555:       const isCurrent = node.line === step.line;\n556:       const fill = isCurrent ? \"#dbeafe\" : \"#ffffff\";\n557:       const stroke = isCurrent ? \"#2563eb\" : \"#cbd5e1\";\n558:       nodesSVG += `\n559:         <g transform=\"translate(${pos.x - nodeW / 2}, ${pos.y - nodeH / 2})\">\n560:           <rect width=\"${nodeW}\" height=\"${nodeH}\" rx=\"6\" fill=\"${fill}\" stroke=\"${stroke}\" stroke-width=\"${isCurrent ? 2 : 1.2}\" />\n561:           <text x=\"${nodeW / 2}\" y=\"${nodeH / 2 + 4}\" text-anchor=\"middle\" fill=\"#0f172a\" font-family=\"JetBrains Mono, monospace\" font-size=\"10\" font-weight=\"${isCurrent ? \"700\" : \"500\"}\">\n562:             ${this.escapeHTML(node.label)}\n563:           </text>\n564:         </g>\n565:       `;\n566:     });\n567: \n568:     this.flowchartSvgWrap.innerHTML = `<svg width=\"${svgW}\" height=\"${svgH}\" viewBox=