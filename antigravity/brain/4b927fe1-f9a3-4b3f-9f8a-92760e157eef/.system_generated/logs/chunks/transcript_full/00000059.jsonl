s[j + 1 : j + 1 + length])\n        i = j + 1 + length\n    return res\n\nenc = encode([\"neet\",\"code\"])\nprint(\"Decoded:\", decode(enc))''', \"O(n)\", \"O(n)\")\n\nadd(380, \"Insert Delete GetRandom O(1)\", \"Medium\", \"Arrays & Hashing\", \"Array + Hash Map Swap\",\n    \"Design a data structure supporting insert, remove, and getRandom in O(1) time.\",\n    '''class RandomizedSet:\n    def __init__(self):\n        self.numMap = {}\n        self.numList = []\n    def insert(self, val):\n        if val in self.numMap: return False\n        self.numMap[val] = len(self.numList)\n        self.numList.append(val)\n        return True\n    def remove(self, val):\n        if val not in self.numMap: return False\n        idx = self.numMap[val]\n        last = self.numList[-1]\n        self.numList[idx] = last\n        self.numMap[last] = idx\n        self.numList.pop()\n        del self.numMap[val]\n        return True\n\nr = RandomizedSet()\nr.insert(10)\nr.insert(20)\nprint(\"Remove 10:\", r.remove(10))''', \"O(1)\", \"O(n)\")\n\nprint(f\"Total problems after Topic 1: {len(problems)}\")\n","Description":"Create scratch script with Topic 1 problems","Overwrite":true,"TargetFile":"C:/Users/CVT/.gemini/antigravity/brain/4b927fe1-f9a3-4b3f-9f8a-92760e157eef/scratch/build_all_problems.py","toolAction":"Writing initial topics in python script","toolSummary":"Topic 1 definition in script"}}]}
