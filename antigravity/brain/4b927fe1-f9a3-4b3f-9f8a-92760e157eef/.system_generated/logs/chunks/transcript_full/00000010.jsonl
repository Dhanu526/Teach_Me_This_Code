ngle assignment (`varName = expr` or `arr[i] = expr`)\n      const cleanTarget = lhsRaw.split(\":\")[0].trim();\n      const indexAssignMatch = cleanTarget.match(/^([a-zA-Z_]\\w*)\\[(.+)\\]$/);\n      if (indexAssignMatch) {\n        const arrName = indexAssignMatch[1];\n        const idxVal = this.evalExpr(\n          indexAssignMatch[2],\n          activeFrame.vars,\n          functions,\n          classes,\n          callStack,\n          steps,\n          stdout,\n          loopStack,\n          node.line\n        );\n        const evalRes = this.evaluateExpressionWithSteps(\n          rhsRaw,\n          `${arrName}[${idxVal}] = `,\n          \"\",\n          activeFrame.vars,\n          functions,\n          classes,\n          callStack,\n          steps,\n          stdout,\n          loopStack,\n          node.line\n        );\n        const newVal = evalRes.value;\n        if (Array.isArray(activeFrame.vars[arrName])) {\n          const prevArr = [...activeFrame.vars[arrName]];\n          activeFrame.vars[arrName][idxVal] = newVal;\n          const changeObj = { name: arrName, status: \"updated\", prevValue: prevArr };\n          this.pushStepSnapshot(steps, {\n            line: node.line,\n            codeText: text,\n            eventType: \"ASSIGN\",\n            callStack,\n            beforeVars: beforeMap,\n            changedVars: [changeObj],\n            changedSummary: `${arrName}[${idxVal}] = ${this.formatVal(newVal)}`,\n            condition: null,\n            loop: this.getCurrentLoopSnapshot(loopStack),\n            operationDetail: {\n              kind: \"assign\",\n              target: `${arrName}[${idxVal}]`,\n              isCreated: false,\n              beforeVal: this.formatVal(prevArr[idxVal]),\n              rhsExpr: rhsRaw,\n              substituted: this.formatVal(newVal),\n              afterVal: this.formatVal(newVal)\n            },\n            exprFrames: evalRes.frames,\n            returnValue: null,\n            stdout: [