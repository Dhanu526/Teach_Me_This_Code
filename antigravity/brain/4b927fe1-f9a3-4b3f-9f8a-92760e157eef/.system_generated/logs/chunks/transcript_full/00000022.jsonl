is.setEditMode(false);\n230:       this.analyzeAndRun();\n231:     });\n232: \n233:     // Keyboard shortcuts: Left / Right arrows + F7 for Thonny sub-expression stepping\n234:     window.addEventListener(\"keydown\", (e) => {\n235:       if (document.activeElement === this.codeTextarea) {\n236:         return;\n237:       }\n238:       if (e.key === \"ArrowRight\") {\n239:         e.preventDefault();\n240:         this.stopAutoPlay();\n241:         this.goToStep(this.currentStepIdx + 1);\n242:       } else if (e.key === \"ArrowLeft\") {\n243:         e.preventDefault();\n244:         this.stopAutoPlay();\n245:         this.goToStep(this.currentStepIdx - 1);\n246:       } else if (e.key === \"F7\") {\n247:         e.preventDefault();\n248:         this.stopAutoPlay();\n249:         this.advanceSubExpression();\n250:       }\n251:     });\n252:   }\n253: \n254:   setEditMode(editing) {\n255:     this.isEditing = editing;\n256:     if (editing) {\n257:       this.stopAutoPlay();\n258:       this.codeTextarea.value = this.sourceCode;\n259:       this.liveEditorWrap.classList.remove(\"hidden\");\n260:       this.codeLinesContainer.classList.add(\"hidden\");\n261:       this.btnAnalyzeCode.classList.remove(\"hidden\");\n262:       this.btnEditCode.textContent = \"▶ Run Code\";\n263:       this.codeTextarea.focus();\n264:     } else {\n265:       this.liveEditorWrap.classList.add(\"hidden\");\n266:       this.codeLinesContainer.classList.remove(\"hidden\");\n267:       this.btnAnalyzeCode.classList.add(\"hidden\");\n268:       this.btnEditCode.textContent = \"✏️ Paste / Edit Code\";\n269:     }\n270:   }\n271: \n272:   buildDynamicOverview(code) {\n273:     if (code.includes(\"class Stack\")) {\n274:       return \"This code defines a Stack data structure (Last-In, First-Out) using a Python class and tests push, pop, peek, size, and is_empty.\";\n275:     }\n276:     if (code.includes(\"binary_search\")) {\n277:       return \"This code searches a sorted list for a target