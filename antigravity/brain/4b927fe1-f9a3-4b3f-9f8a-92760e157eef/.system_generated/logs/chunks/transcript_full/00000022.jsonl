.showIterationsPanel = true;\n28: \n29:     this.currentStepIdx = 0;\n30:     this.currentSubStepIdx = 0;\n31:     this.showGCObjects = false;\n32: \n33:     this.isPlaying = false;\n34:     this.playInterval = null;\n35:     this.playSpeedMs = 1200;\n36:     this.isEditing = false;\n37:     this.showAdvanced = false;\n38: \n39:     this.initDOM();\n40:     this.bindEvents();\n41:     this.codeTextarea.value = this.sourceCode;\n42:     this.analyzeAndRun();\n43:   }\n44: \n45:   initDOM() {\n46:     // Simple Navigation Controls\n47:     this.stepProgressLabel = document.getElementById(\"stepProgressLabel\");\n48:     this.activeScopeBadge = document.getElementById(\"activeScopeBadge\");\n49:     this.btnPrev = document.getElementById(\"btnPrev\");\n50:     this.btnSubStep = document.getElementById(\"btnSubStep\");\n51:     this.btnNext = document.getElementById(\"btnNext\");\n52:     this.btnAutoPlay = document.getElementById(\"btnAutoPlay\");\n53:     this.btnRestart = document.getElementById(\"btnRestart\");\n54: \n55:     // Top Secondary Controls\n56:     this.btnEditCode = document.getElementById(\"btnEditCode\");\n57:     this.btnAnalyzeCode = document.getElementById(\"btnAnalyzeCode\");\n58:     this.btnToggleIterations = document.getElementById(\"btnToggleIterations\");\n59:     this.btnToggleAdvanced = document.getElementById(\"btnToggleAdvanced\");\n60:     this.advancedViewPanel = document.getElementById(\"advancedViewPanel\");\n61: \n62:     // Validation & Overview\n63:     this.validationBanner = document.getElementById(\"validationBanner\");\n64:     this.overviewText = document.getElementById(\"overviewText\");\n65: \n66:     // Area 1: Your Code\n67:     this.codeScopeIndicator = document.getElementById(\"codeScopeIndicator\");\n68:     this.codeLinesContainer = document.getElementById(\"codeLinesContainer\");\n69:     this.liveEditorWrap = document.getElementById(\"liveEditorWrap\");\n70:     this.codeTextarea = document.getElementById(\"codeTexta