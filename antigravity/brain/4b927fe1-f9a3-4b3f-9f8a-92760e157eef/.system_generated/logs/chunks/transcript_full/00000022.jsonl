;\n609:     }\n610:   }\n611: \n612:   /* =========================================================\n613:      AREA 1: YOUR CODE (Highlight ONLY the current line)\n614:      ========================================================= */\n615:   renderArea1Code(step) {\n616:     this.codeLinesContainer.innerHTML = \"\";\n617:     this.traceResult.rawLines.forEach((rawLine, idx) => {\n618:       const lineNum = idx + 1;\n619:       const isCurrent = step.line === lineNum;\n620: \n621:       const row = document.createElement(\"div\");\n622:       row.className = `code-row ${isCurrent ? \"is-current-line\" : \"is-dimmed\"}`;\n623: \n624:       row.innerHTML = `\n625:         <div class=\"code-gutter\">${lineNum}</div>\n626:         <div class=\"code-syntax\">${this.highlightPythonSyntax(rawLine)}</div>\n627:       `;\n628: \n629:       row.addEventListener(\"click\", () => {\n630:         const targetIdx = this.traceResult.steps.findIndex((s) => s.line === lineNum);\n631:         if (targetIdx !== -1) {\n632:           this.stopAutoPlay();\n633:           this.goToStep(targetIdx);\n634:         }\n635:       });\n636: \n637:       this.codeLinesContainer.appendChild(row);\n638:     });\n639:   }\n640: \n641:   highlightPythonSyntax(line) {\n642:     if (!line) return \" \";\n643:     let commentPart = \"\";\n644:     let codePart = line;\n645:     const hashIdx = line.indexOf(\"#\");\n646:     if (hashIdx !== -1) {\n647:       codePart = line.slice(0, hashIdx);\n648:       commentPart = `<span class=\"syn-com\">${this.escapeHTML(line.slice(hashIdx))}</span>`;\n649:     }\n650: \n651:     const tokenRegex = /(\".*?\"|'.*?'|\\b(?:class|def|return|if|elif|else|for|while|in|break|continue|and|or|not|True|False|None|self)\\b|\\b(?:print|range|len|min|max|abs|sum|list|int|float|str|bool|round|enumerate|sorted|reversed|set|dict)\\b|\\b\\d+(?:\\.\\d+)?\\b)/g;\n652:     const highlighted = this.escapeHTML(codePart).replace(tokenRegex, (match) => {\n653:       if (match.startsWith('\"') || match.startsWith(\"'\")) {\n654:         return `<span class=\"syn-str\">${match}</span>`;\n655:       }\n656:       if (/^(class|def|return|if|elif|else|for|while|in|break|continue|and|or|not|True|False|None|self)$/.test(match)) {\n657:         return `<span class=\"syn-kw\">${match}</span>`;\n658:       }\n659:       if (/^(print|range|len|min|max|abs|sum|list|int|float|str|bool|round|enumerate|sorted|reversed|set|dict)$/.test(match)) {\n660:         return `<span class=\"syn-bi\">${match}</span>`;\n661:       }\n662:       if (/^\\d/.test(match)) {\n663:         return `<span class=\"syn-num\">${match}</span>`;\n664:       }\n665:       return match;\n666:     });\n667: \n668:     return highlighted + commentPart;\n669:   }\n670: \n671:   /* =========================================================\n672:      AREA 2: TEACHING AREA, QUICK ITERATION BAR & THONNY STEPPER\n673:      ========================================================= */\n674:   renderArea2Teaching(step) {\n675:     const lesson = step.teacherLesson;\n676: \n677:     // Render Quick Iteration / Phase Pills Bar\n678:     this.renderQuickIterationBar();\n679: \n680:     this.teachStepTitle.textContent = lesson.title;\n681:     this.teachCodeBox.innerHTML = this.highlightPythonSyntax(step.codeText);\n682: \n683:     // Render Thonny Step-by-Step Expression Evaluator\n684:     this.renderThonnyExpressionStepper(step);\n685: \n686:     // Calculation Breakdown Card\n687:     if (lesson.calculationCard) {\n688:       const c = lesson.calculationCard;\n689:       this.teachCalculationBox.classList.remove(\"hidden\");\n690: \n691:       if (c.currentNumber !== null && c.currentNumber !== undefined) {\n692:         this.calcCurrentNumRow.classList.remove(\"hidden\");\n693:         this.calcCurrentNumVal.textContent = c.currentNumber;\n694:       } else {\n695:         this.calcCurrentNumRow.classList.add(\"hidden\");\n696:       }\n697: \n698:       this.calcBeforeVal.textContent = c.before;\n699:       this.calcFormulaVal.textContent = c.calculation;\n700:       this.calcAfterVal.textContent = c.after;\n701:     } else {\n702:       this.teachCalculationBox.classList.add(\"hidden\");\n703:     }\n704: \n705:     this.teachMeaningText.innerHTML = this.formatMarkdown(lesson.whatItMeans);\n706:     this.teachVarsNowBox.textContent = lesson.variableValuesNow;\n707:     this.teachNextText.innerHTML = this.formatMarkdown(lesson.whatHappensNext);\n708: \n709:     if (lesson.finalBanner) {\n710:       this.finalAnswerBanner.classList.remove(\"hidden\");\n711:       this.finalAnswerHeading.textContent = `Final answer: ${lesson.finalBanner.answer}`;\n712:       this.finalAnswerDetail.innerHTML = this.formatMarkdown(lesson.finalBanner.summary);\n713:     } else {\n714:       this.finalAnswerBanner.classList.add(\"hidden\");\n715:     }\n716:   }\n717: \n718:   renderQuickIterationBar() {\n719:     if (!this.iterationPillsBar) return;\n720:     this.iterationPillsBar.innerHTML = \"\";\n721: \n722:     const activeGroupIdx = this.stepToGroupIdx.get(this.currentStepIdx) ?? 0;\n723:     const activeGroup = this.iterationGroups[activeGroupIdx];\n724: \n725:     if (this.activeIterationBadge && activeGroup) {\n726:       this.activeIterationBadge.textContent = `${activeGroup.badge} (${activeGroupIdx + 1}/${this.iterationGroups.length})`;\n727:     }\n728: \n729:     this.iterationGroups.forEach((grp, gIdx) => {\n730:       const btn = document.createElement(\"button\");\n731:       btn.type = \"button\";\n732:       const isActive = gIdx === activeGroupIdx;\n733:       const isPast = gIdx < activeGroupIdx;\n734:       btn.className = `iter-pill-btn ${isActive ? \"is-active-iter-pill\" : isPast ? \"is-past-iter-pill\" : \"\"}`;\n735:       btn.textContent = grp.pillLabel;\n736:       btn.title = `${grp.title} (Steps ${grp.startStepIdx + 1}–${grp.endStepIdx + 1})`;\n737:       btn.addEventListener(\"click\", () => {\n738:         this.stopAutoPlay();\n739:         this.goToStep(grp.startStepIdx);\n740:       });\n741:       this.iterationPillsBar.appendChild(btn);\n742:     });\n743:   }\n744: \n745:   renderThonnyExpressionStepper(step) {\n746:     if (!this.thonnyExprBox) return;\n747:     const frames =\n748:       step.exprFrames && step.exprFrames.length\n749:         ? step.exprFrames\n750:         : [{ expr: step.codeText, focus: \"Execute statement\", shortCircuited: false }];\n751: \n752:     const subIdx = Math.max(0, Math.min(this.currentSubStepIdx, frames.length - 1));\n753:     const activeFrame = frames[subIdx];\n754:     const hasShortCircuit = frames.some((f) => f.shortCircuited);\n755: \n756:     this.thonnyExprBox.classList.toggle(\"is-short-circuited\", Boolean(activeFrame.shortCircuited || hasShortCircuit));\n757:     this.thonnySubStepCounter.textContent = `Sub-Expr ${subIdx + 1} of ${frames.length}`;\n758:     this.thonnyLiveCode.innerHTML = this.highlightPythonSyntax(activeFrame.expr);\n759:     this.thonnyFocusNote.innerHTML = this.formatMarkdown(\n760:       activeFrame.shortCircuited\n761:         ? `⚡ **Short-Circuit Activated:** ${activeFrame.focus}`\n762:         : `🔍 **Sub-Expression Step:** ${activeFrame.focus}`\n763:     );\n764: \n765:     this.thonnyTrailChips.innerHTML = \"\";\n766:     frames.forEach((frame, idx) => {\n767:       if (idx > 0) {\n768:         const arrow = document.createElement(\"span\");\n769:         arrow.className = \"thonny-arrow\";\n770:         arrow.textContent = \"→\";\n771:         this.thonnyTrailChips.appendChild(arrow);\n772:       }\n773:       const chip = document.createElement(\"button\");\n774:       chip.type = \"button\";\n775:       chip.className = `thonny-chip ${idx === subIdx ? \"is-active-substep\" : \"\"} ${\n776:         frame.shortCircuited ? \"is-sc-chip\" : \"\"\n777:       }`;\n778:       chip.textContent = frame.expr;\n779:       chip.title = frame.focus;\n780:       chip.addEventListener(\"click\", () => {\nThe above content does NOT show the entire