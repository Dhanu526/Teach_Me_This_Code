token: \"//\", label: \"//\", desc: \"Floor division: divides and rounds down to a whole integer index.\" },\n17:   { token: \"+=\", label: \"+=\", desc: \"Adds a number to the existing variable and binds the name to the new value's address.\" },\n18:   { token: \"-=\", label: \"-=\", desc: \"Subtracts a number from the existing variable.\" },\n19:   { token: \">=\", label: \">=\", desc: \"Asks: 'Is the left number greater than or equal to the right number?'\" },\n20:   { token: \"<=\", label: \"<=\", desc: \"Asks: 'Is the left number less than or equal to the right number?'\" },\n21:   { token: \"==\", label: \"==\", desc: \"Asks: 'Are these two values equal?'\" },\n22:   { token: \"<\", label: \"<\", desc: \"Asks: 'Is the left number smaller than the right number?'\" },\n23:   { token: \">\", label: \">\", desc: \"Asks: 'Is the left number larger than the right number?'\" },\n24:   { token: \"=\", label: \"=\", desc: \"Evaluates the right side first and points the variable name on the left to its heap address.\" },\n25:   { token: \"[\", label: \"arr[i]\", desc: \"Looks up the item at index `i` inside the list object on the heap.\" },\n26:   { token: \"return\", label: \"return\", desc: \"Finishes the local function scope and sends back the final answer.\" }\n27: ];\n28: \n29: class RuleBasedExplainer {\n30:   enrichTraceWithExplanations(traceResult) {\n31:     if (!traceResult || !traceResult.steps) return traceResult;\n32:     const steps = traceResult.steps;\n33: \n34:     const bestSubarrayInfo = this.computeBestSubarray(traceResult);\n35: \n36:     for (let i = 0; i < steps.length; i++) {\n37:       const step = steps[i];\n38:       const prevStep = i > 0 ? steps[i - 1] : null;\n39:       const nextStep = i + 1 < steps.length ? steps[i + 1] : null;\n40: \n41:       step.teacherLesson = this.buildTeacherLesson(step, prevStep, nextStep, bestSubarrayInfo);\n42:       step.teachingSubsteps = this.buildTeachingSubsteps(step, prevStep, nextStep, bestSubarrayInfo);\n43:       step.explanations = this.buildStepExplanation(step, prevStep, nextStep);\n44:     }\n45: \n46:     traceResult.bestSubarrayInfo = bestSubarrayInfo;\n47:     traceResult.executionSummary = this.buildExecutionSummary(traceResult);\n48:     return traceResult;\n49:   }\n50: \n51:   computeBestSubarray(traceResult) {\n52:     const steps = traceResult.steps || [];\n53:     if (!steps.length) return null;\n54: \n55:     let numsArr = null;\n56:     for (const s of steps) {\n57:       const numsRow = (s.variables || []).find((v) => v.name === \"nums\" && Array.isArray(v.rawValue));\n58:       if (numsRow) {\n59:         numsArr = numsRow.rawValue;\n60:         break;\n61:       }\n62:     }\n63:     if (!numsArr || !numsArr.length) return null;\n64: \n65:     let bestSum = numsArr[0];\n66:     let bestStart = 0;\n67:     let bestEnd = 0;\n68:     let currentSum = 0;\n69:     let currentStart = 0;\n70: \n71:     for (let i = 0; i < numsArr.length; i++) {\n72:       if (currentSum === 0) currentStart = i;\n73:       currentSum += numsArr[i];\n74:       if (currentSum >= bestSum) {\n75:         bestSum = currentSum;\n76:         bestStart = currentStart;\n77:         bestEnd = i;\n78:       }\n79:       if (currentSum < 0) {\n80:         currentSum = 0;\n81:       }\n82:     }\n83: \n84:     return {\n85:       subarray: numsArr.slice(bestStart, bestEnd + 1),\n86:       startIndex: bestStart,\n87:       endIndex: bestEnd,\n88:       maxSum: bestSum\n89:     };\n90:   }\n91: \n92:   buildTeacherLesson(step, prevStep, nextStep, bestSubarrayInfo) {\n93:     const n = step.stepIndex;\n94:     const op = step.operationDetail || {};\n95:     const cond = step.condition;\n96:     const nextSentence = this.buildFriendlyWhatNext(step, nextStep);\n97:     const relevantVarsNow = this.formatRelevantVariablesNow(step);\n98:     const exprFrames = step.exprFrames || [];\n99:     const scFrame = exprFrames.find((f) => f.shortCircuited);\n100: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
