:       \"Math and Number Theory\",\r\n27:       \"Recursion\"\r\n28:     ],\r\n29:     \"summary\": \"Find indices of two numbers that add up to a target using a dictionary for instant lookups.\",\r\n30:     \"examples\": [\r\n31:       {\r\n32:         \"input\": \"nums = [2, 7, 11, 15]\",\r\n33:         \"output\": \"Computed via twoSum(nums, 9)\",\r\n34:         \"explanation\": \"Step through the execution in the visualizer to inspect how variables mutate to produce the result.\"\r\n35:       }\r\n36:     ],\r\n37:     \"constraints\": [\r\n38:       \"1 <= nums.length <= 10^4\",\r\n39:       \"-10^4 <= nums[i] <= 10^4\",\r\n40:       \"Memory limit: 256 MB, Time limit: 2.0 seconds\"\r\n41:     ],\r\n42:     \"prerequisites\": [\r\n43:       \"Array Indexing & Iteration\",\r\n44:       \"Hash Map / Dict Key Lookup\",\r\n45:       \"Recursive Call Stack & Base Cases\"\r\n46:     ],\r\n47:     \"referenceSolution\": \"def twoSum(nums, target):\\n    prevMap = {}\\n    for i in range(len(nums)):\\n        diff = target - nums[i]\\n        if diff in prevMap:\\n            return [prevMap[diff], i]\\n        prevMap[nums[i]] = i\\n    return []\\n\\nnums = [2, 7, 11, 15]\\nprint(\\\"Indices:\\\", twoSum(nums, 9))\",\r\n48:     \"verificationStatus\": \"Verified\"\r\n49:   },\r\n50:   {\r\n51:     \"id\": 2,\r\n52:     \"leetcodeNumber\": 217,\r\n53:     \"title\": \"Contains Duplicate\",\r\n54:     \"difficulty\": \"Easy\",\r\n55:     \"topic\": \"Arrays & Hashing\",\r\n56:     \"pattern\": \"Hash Set\",\r\n57:     \"description\": \"Determine if any value appears at least twice in the array using a set.\",\r\n58:     \"timeComplexity\": \"O(n)\",\r\n59:     \"spaceComplexity\": \"O(n)\",\r\n60:     \"starterCode\": \"def containsDuplicate(nums):\\n    seen = set()\\n    for n in nums:\\n        if n in seen:\\n            return True\\n        seen.add(n)\\n    return False\\n\\nprint(\\\"Has duplicate:\\\", containsDuplicate([1, 2, 3, 1]))\",\r\nThe above content