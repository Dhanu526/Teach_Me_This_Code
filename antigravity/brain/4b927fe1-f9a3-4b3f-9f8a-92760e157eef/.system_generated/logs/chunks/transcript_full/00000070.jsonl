.btnViewVisualizer && this.btnViewDsa) {\r\n624:         this.btnViewVisualizer.addEventListener('click', () => this.switchView('visualizer'));\r\n625:         this.btnViewDsa.addEventListener('click', () => this.switchView('dsa'));\r\n626:       }\r\n627: \r\n628:       if (this.dsaContainer) {\r\n629:         this.dsaContainer.addEventListener('click', (e) => {\r\n630:           // Tab switcher buttons\r\n631:           const tabBtn = e.target.closest('[data-dsa-tab]');\r\n632:           if (tabBtn) {\r\n633:             this.currentSubTab = tabBtn.getAttribute('data-dsa-tab');\r\n634:             this.render();\r\n635:             return;\r\n636:           }\r\n637: \r\n638:           // Open Dedicated Topic Page\r\n639:           const openTopicBtn = e.target.closest('[data-open-topic]');\r\n640:           if (openTopicBtn) {\r\n641:             const topic = openTopicBtn.getAttribute('data-open-topic');\r\n642:             this.openTopicDetailPage(topic);\r\n643:             return;\r\n644:           }\r\n645: \r\n646:           // Bookmark button\r\n647:           const bookmarkBtn = e.target.closest('[data-action=\"toggle-bookmark\"]');\r\n648:           if (bookmarkBtn) {\r\n649:             const id = parseInt(bookmarkBtn.getAttribute('data-id'), 10);\r\n650:             if (!isNaN(id)) this.toggleBookmark(id);\r\n651:             return;\r\n652:           }\r\n653: \r\n654:           // Toggle Solved button\r\n655:           const toggleSolvedBtn = e.target.closest('[data-action=\"toggle-solved\"]');\r\n656:           if (toggleSolvedBtn) {\r\n657:             const id = parseInt(toggleSolvedBtn.getAttribute('data-id'), 10);\r\n658:             if (!isNaN(id)) this.toggleSolved(id);\r\n659:             return;\r\n660:           }\r\n661: \r\n662:           // Solve & Visualize button\r\n663:           const solveBtn = e.target.closest('[data-action=\"solve-visualize\"]');\r\n664:           if (solveBtn) {\r\n665:             const id = parseInt(solveBtn.getAttribute('data-id'), 10);\r\n666:             if (!isNaN(id)) this.loadAndVisualizeProblem(id);\r\n667:             return;\r\n668:           }\r\n669: \r\n670:           // Explore Roadmap Phase\r\n671:           const roadmapBtn = e.target.closest('[data-action=\"explore-phase\"]');\r\n672:           if (roadmapBtn) {\r\n673:             const phaseNum = parseInt(roadmapBtn.getAttribute('data-phase'), 10);\r\n674:             const phase = ROADMAP_PHASES.find(p => p.phase === phaseNum);\r\n675:             if (phase && phase.topics.length > 0) {\r\n676:               this.openTopicDetailPage(phase.topics[0]);\r\n677:             }\r\n678:             return;\r\n679:           }\r\n680: \r\n681:           // Status filter chips\r\n682:           const statusChip = e.target.closest('[data-filter-status]');\r\n683:           if (statusChip) {\r\n684:             this.selectedStatus = statusChip.getAttribute('data-filter-status');\r\n685:             this.currentPage = 1;\r\n686:             this.renderProblemTableOnly();\r\n687:             this.updateFilterPillUI('[data-filter-status]', this.selectedStatus);\r\n688:             return;\r\n689:           }\r\n690: \r\n691:           // Difficulty filter chips\r\n692:           const diffChip = e.target.closest('[data-filter-diff-chip]');\r\n693:           if (diffChip) {\r\n694:             this.selectedDifficulty = diffChip.getAttribute('data-filter-diff-chip');\r\n695:             this.currentPage = 1;\r\n696:             this.renderProblemTableOnly();\r\n697:             this.updateFilterPillUI('[data-filter-diff-chip]', this.selectedDifficulty);\r\n698:             return;\r\n699:           }\r\n700: \r\n701:           // Topic Category filter chips (in Topic Library)\r\n702:           const catChip = e.target.closest('[data-filter-category]');\r\n703:           if (catChip) {\r\n704:             this.selectedCategory = catChip.getAttribute('data-filter-category');\r\n705:             this.renderTopicGridOnly();\r\n706:             this.updateFilterPillUI('[data-filter-category]', this.selectedCategory);\r\n707:             return;\r\n708:           }\r\n709: \r\n710:           // Clear filters button\r\n711:           const clearBtn = e.target.closest('[data-action=\"clear-filters\"]');\r\n712:           if (clearBtn) {\r\n713:             this.searchQuery = '';\r\n714:             this.selectedTopic = 'all';\r\n715:             this.selectedDifficulty = 'all';\r\n716:             this.selectedPattern = 'all';\r\n717:             this.selectedStatus = 'all';\r\n718:             this.currentPage = 1;\r\n719:             this.render();\r\n720:             return;\r\n721:           }\r\n722: \r\n723:           // Back to Topics Library from detail\r\n724:           const backToTopicsBtn = e.target.closest('#btnBackToTopicsList');\r\n725:           if (backToTopicsBtn) {\r\n726:             this.currentSubTab = 'topics';\r\n727:             this.render();\r\n728:             return;\r\n729:           }\r\n730: \r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
