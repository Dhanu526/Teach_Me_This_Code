/span>\n61:           <button id=\"btnAnalyzeCode\" class=\"btn-small-primary hidden\">▶ Run Code</button>\n62:         </div>\n63:       </div>\n64: \n65:       <div id=\"codeLinesContainer\" class=\"code-view\"></div>\n66: \n67:       <!-- Code Editor Textarea when user clicks \"Paste / Edit Code\" -->\n68:       <div id=\"liveEditorWrap\" class=\"live-editor-wrap hidden\">\n69:         <textarea id=\"codeTextarea\" class=\"code-textarea\" placeholder=\"Paste any Python code here...\" spellcheck=\"false\"></textarea>\n70:         <div class=\"editor-input-bar\">\n71:           <label class=\"drawer-label\" for=\"inputPlaygroundField\">Optional Function Input:</label>\n72:           <input id=\"inputPlaygroundField\" type=\"text\" class=\"drawer-input\" placeholder=\"e.g. nums = [-2, 1, -3, 4] (leave empty if your code calls itself)\" spellcheck=\"false\" />\n73:         </div>\n74:       </div>\n75:     </section>\n76: \n77:     <!-- AREA 2: TEACHING AREA & THONNY EXPRESSION STEPPER (CENTER) -->\n78:     <section class=\"area-card area-teaching\" aria-label=\"Step-by-Step Explanation\">\n79:       <div class=\"teaching-card-inner\">\n80: \n81:         <!-- Step Heading -->\n82:         <div class=\"teach-header-row\">\n83:           <h1 id=\"teachStepTitle\" class=\"teach-step-title\">Step 1: Create the variable</h1>\n84:           <span id=\"teachScopeBadge\" class=\"scope-pill scope-global\">GLOBAL SCOPE</span>\n85:         </div>\n86: \n87:         <!-- Current Code Line Box -->\n88:         <div class=\"teach-section\">\n89:           <div class=\"teach-label\">Code:</div>\n90:           <div id=\"teachCodeBox\" class=\"teach-code-box\">c = 0</div>\n91:         </div>\n92: \n93:         <!-- TASK 2.1, 2.2, 2.3: THONNY-STYLE STEP-BY-STEP SUB-EXPRESSION EVALUATOR -->\n94:         <div id=\"thonnyExprBox\" class=\"thonny-expr-card\">\n95:           <div class=\"thonny-expr-header\">\n96:             <span class=\"thonny-badge\">Thonny Expression Evaluator</span>\