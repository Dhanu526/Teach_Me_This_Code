ter-spacing: 0.03em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n\n.scope-global {\n  background: var(--global-teal-soft);\n  color: var(--global-teal);\n  border: 1px solid var(--global-teal-border);\n}\n\n.scope-local {\n  background: var(--local-purple-soft);\n  color: var(--local-purple);\n  border: 1px solid var(--local-purple-border);\n}\n\n.top-bar-secondary {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  width: 100%;\n  padding-top: 8px;\n  border-top: 1px solid var(--border-light);\n}\n\n.top-bar-hints {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.kbd-hint {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 12.5px;\n  color: var(--text-secondary);\n  background: var(--bg-subtle);\n  border: 1px solid var(--border-light);\n  padding: 3px 9px;\n  border-radius: 6px;\n  white-space: nowrap;\n}\n\n.kbd-hint kbd {\n  font-family: var(--font-mono);\n  font-size: 11.5px;\n  font-weight: 700;\n  background: #ffffff;\n  border: 1px solid var(--border-medium);\n  box-shadow: 0 1px 0 rgba(15, 23, 42, 0.08);\n  padding: 2px 5px;\n  border-radius: 4px;\n  color: var(--text-main);\n}\n\n.nav-controls {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n}\n\n.btn-nav {\n  font-family: var(--font-sans);\n  font-size: 14.5px;\n  font-weight: 600;\n  padding: 7px 15px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--border-medium);\n  background: var(--bg-card);\n  color: var(--text-main);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.btn-nav:hover:not(:disabled) {\n  background: var(--bg-subtle);\n  border-color: #94a3b8;\n}\n\n.btn-nav:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n\n.btn-substep {\n  background: #fffbeb;\n  border-color: #fcd34d;\n  color: #92400e;\n}\n\n.btn-substep:hover:not(:disabled) {\n  background: #fef3c7;\n  border-color: #f59e0b;\n}\n\n.btn-next-prominent {\n  background: 