 class=\"memory-wrapper\">\n          <div class=\"panel-header\">\n            <div class=\"panel-title\">\n              <span class=\"dot dot-cyan\"></span>\n              Variables, Memory &amp; Call Stack\n            </div>\n            <span id=\"frameCountBadge\" class=\"badge-ai\">1 Frame</span>\n          </div>\n          <div id=\"memoryScroll\" class=\"memory-scroll\"></div>\n        </div>\n\n      </div>\n    </section>\n\n    <!-- RIGHT PANEL: AI Tutor & Step-by-Step Explanation Panel -->\n    <section class=\"panel\">\n      <div class=\"panel-header\">\n        <div class=\"panel-title\">\n          <span class=\"dot dot-amber\"></span>\n          AI Execution Tutor &amp; Explanation\n        </div>\n      </div>\n\n      <div class=\"tutor-body\">\n        <!-- Explanation Depth Switcher -->\n        <div class=\"depth-selector\">\n          <button class=\"depth-btn\" data-depth=\"eli5\">🌱 ELI5 Analogy</button>\n          <button class=\"depth-btn active\" data-depth=\"beginner\">🎓 Beginner Logic</button>\n          <button class=\"depth-btn\" data-depth=\"deep\">⚙️ Under the Hood</button>\n        </div>\n\n        <!-- Current Step Hero Summary -->\n        <div class=\"step-hero-card\">\n          <div class=\"step-hero-header\">\n            <span id=\"eventBadge\" class=\"event-badge\">ASSIGN</span>\n            <span id=\"stepLineBadge\" class=\"step-line-badge\">Line 1</span>\n          </div>\n          <div id=\"stepCodePreview\" class=\"step-code-preview\">numbers = [4, 7, 10, 3, 8]</div>\n          <div id=\"evalBreakdownBox\" class=\"eval-breakdown-box\">numbers &lt;-- [4, 7, 10, 3, 8]</div>\n        </div>\n\n        <!-- What Just Happened -->\n        <div class=\"explanation-section\">\n          <div class=\"explanation-label\">💡 What Just Happened</div>\n          <div id=\"whatHappenedText\" class=\"explanation-text\"></div>\n        </div>\n\n        <!-- Why It Happened / Internal Mechanics -->\n        <div class=\"explanation-section\">\n          <div class=\"explanation-label\">🔍 Why It Happened</div>\n          <div id=\"whyHappenedText\" class=\"explanation-text\"></div>\n        </div>\n\n        <!-- What Happens Next -->\n        <div class=\"explanation-section\">\n          <div class=\"explanation-label\">⏭️ What Happens Next</div>\n          <div id=\"whatNextText\" class=\"explanation-text\"></div>\n        </div>\n\n        <!-- Optional Prediction Quiz Card -->\n        <div id=\"quizCard\" class=\"quiz-card hidden\">\n          <div class=\"explanation-label\" style=\"color:#d8b4fe;\">🧠 Active Learning Challenge</div>\n          <div id=\"quizQuestion\" class=\"explanation-text\"></div>\n          <div id=\"quizOptions\" class=\"quiz-options\"></div>\n        </div>\n      </div>\n\n      <!-- Interactive Ask AI Tutor Footer -->\n      <div class=\"ai-chat-section\">\n        <div class=\"quick-chips\">\n          <button class=\"chip-btn\" data-question=\"Why did this line happen?\">Why did this happen?</button>\n          <button class=\"chip-btn\" data-question=\"What variables are in memory right now?\">Explain memory state</button>\n          <button class=\"chip-btn\" data-question=\"What happens on the next step?\">What happens next?</button>\n        </div>\n        <div id=\"aiAnswerBubble\" class=\"ai-answer-bubble hidden\"></div>\n        <div class=\"chat-input-row\">\n          <input id=\"chatInput\" type=\"text\" class=\"chat-input\" placeholder=\"Ask AI Tutor about this step...\" />\n          <button id=\"btnAskAi\" class=\"btn btn-primary\">Ask</button>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <script src=\"tracer.js\"></script>\n  <script src=\"app.js\"></script>\n</body>\n</html>\n","Description":"Create main application HTML file index.html for the AI-Powered Code Flow Visualizer","Overwrite":true,"TargetFile":"C:\\Users\\CVT\\.gemini\\antigravity\\scratch\\code-flow-visualizer\\index.html","toolAction":"Creating application layout index.html","toolSummary":"Create index.html for Code Flow Visualizer"}}]}
