   : [];\n        const bodyRes = this.parseChildSuite(items, i + 1, item.indent);\n        nodes.push({\n          kind: \"DEF\",\n          line: item.line,\n          text: item.text,\n          funcName,\n          params,\n          body: bodyRes.nodes\n        });\n        i = bodyRes.nextIdx;\n      } else {\n        nodes.push({\n          kind: \"STMT\",\n          line: item.line,\n          text: item.text\n        });\n        i++;\n      }\n    }\n\n    return { nodes, nextIdx: i };\n  }\n\n  parseChildSuite(items, nextIdx, parentIndent) {\n    if (nextIdx >= items.length || items[nextIdx].indent <= parentIndent) {\n      return { nodes: [], nextIdx };\n    }\n    return this.buildASTBlock(items, nextIdx, items[nextIdx].indent);\n  }\n\n  executeBlock(nodes, callStack, functions, steps, stdout) {\n    for (const node of nodes) {\n      if (steps.length >= this.maxSteps) break;\n      const ret = this.executeNode(node, callStack, functions, steps, stdout);\n      if (ret && ret.returned) {\n        return ret;\n      }\n    }\n    return null;\n  }\n\n  analyzeConditionDetails(condExpr, scopeVars, functions, callStack, steps, stdout, line) {\n    const ops = [\"==\", \"!=\", \">=\", \"<=\", \">\", \"<\"];\n    for (const op of ops) {\n      const idx = condExpr.indexOf(op);\n      if (idx !== -1) {\n        const leftRaw = condExpr.slice(0, idx).trim();\n        const rightRaw = condExpr.slice(idx + op.length).trim();\n        const leftVal = this.evalExpr(leftRaw, scopeVars, functions, callStack, steps, stdout, line);\n        const rightVal = this.evalExpr(rightRaw, scopeVars, functions, callStack, steps, stdout, line);\n        const finalBool = Boolean(this.evalExpr(condExpr, scopeVars, functions, callStack, steps, stdout, line));\n        return {\n          leftExpr: leftRaw,\n          leftSub: this.substituteVarsInExpr(leftRaw, scopeVars),\n          leftVal: this.formatVal(leftVal),\n          operator: op,\n          rightExpr: rightRaw,\n     