stepIndex: steps.length + 1,\n        line: node.line,\n        codeText: text,\n        eventType: \"PRINT\",\n        scopes: this.snapshotScopes(callStack, null),\n        evalBreakdown: `print(${inner})  ==>  Console Output: \"${outputLine}\"`,\n        branchResult: null,\n        loopMechanics: null,\n        conditionMechanics: null,\n        functionMechanics: null,\n        stdout: [...stdout],\n        explanations: {\n          eli5: `Python looks up the current values of the items inside \\`print(...)\\` and displays **\\`${outputLine}\\`** in the Console Output box!`,\n          beginner: `**Console Output (\\`print\\`)**: Evaluates each argument inside \\`print(${inner})\\` and writes \\`\"${outputLine}\"\\` to standard output.`,\n          deep: `Evaluates argument expressions, converts objects to strings, and flushes \\`\"${outputLine}\\\\n\"\\` to \\`stdout\\`.`,\n          whyItHappened: `\\`print()\\` does not change any variables in memory; it simply displays values to the user.`\n        }\n      });\n      return null;\n    }\n\n    // 3. List .append() method\n    const appendMatch = text.match(/^([a-zA-Z_]\\w*)\\.append\\((.*)\\)$/);\n    if (appendMatch) {\n      const listName = appendMatch[1];\n      const argExpr = appendMatch[2].trim();\n      const itemVal = this.evalExpr(argExpr, activeFrame.vars, functions, callStack, steps, stdout, node.line);\n      const currentList = Array.isArray(activeFrame.vars[listName]) ? [...activeFrame.vars[listName]] : [];\n      const prevCopy = [...currentList];\n      currentList.push(itemVal);\n      activeFrame.prevVars[listName] = prevCopy;\n      activeFrame.vars[listName] = currentList;\n\n      steps.push({\n        stepIndex: steps.length + 1,\n        line: node.line,\n        codeText: text,\n        eventType: \"ASSIGN\",\n        scopes: this.snapshotScopes(callStack, {\n          name: listName,\n          status: \"updated\",\n          prevValue: prevCopy\n        }),\n        evalBreakdown: `${listName}.append(${this.formatVal(itemVal)})  ==>  ${this.formatVal(currentList)}`,\n        branchResult: null,\n        loopMechanics: null,\n        conditionMechanics: null,\n        functionMechanics: null,\n        stdout: [...stdout],\n        explanations: {\n          eli5: `Python tacks \\`${this.formatVal(itemVal)}\\` onto the end of the list \\`${listName}\\`!`,\n          beginner: `Mutates list \\`${listName}\\` in-place by appending \\`${this.formatVal(itemVal)}\\` at index ${currentList.length - 1}.`,\n          deep: `Invokes \\`list.append\\` method on \\`${listName}\\`, growing the list object to length ${currentList.length}.`,\n          whyItHappened: `\\`.append()\\` adds a new element to the end of an existing list.`\n        }\n      });\n      return null;\n    }\n\n    // 4. Augmented assignment (+=, -=, *=)\n    const augMatch = text.match(/^([a-zA-Z_]\\w*)\\s*(\\+=|-=|\\*=)\\s*(.+)$/);\n    if (augMatch) {\n      const varName = augMatch[1];\n      const op = augMatch[2][0];\n      const rhsExpr = augMatch[3].trim();\n      const fullExpr = `${varName} ${op} (${rhsExpr})`;\n      const prevVal = activeFrame.vars[varName];\n      const newVal = this.evalExpr(fullExpr, activeFrame.vars, functions, callStack, steps, stdout, node.line);\n      const substituted = `${this.formatVal(prevVal)} ${op} ${this.substituteVarsInExpr(rhsExpr, activeFrame.vars)}`;\n\n      activeFrame.prevVars[varName] = prevVal;\n      activeFrame.vars[varName] = newVal;\n\n      steps.push({\n        stepIndex: steps.length + 1,\n        line: node.line,\n        codeText: text,\n        eventType: \"ASSIGN\",\n        scopes: this.snapshotScopes(callStack, {\n          name: varName,\n          status: \"updated\",\n          prevValue: prevVal\n        }),\n        evalBreakdown: `${varName} = ${substituted}  ==>  ${this.formatVal(newVal)}`,\n        branchResult: null,\n        loopMechanics: null,\n        conditionMechanics: null,\n        functionMechanics: null,\n        stdout: [...stdout],\n        explanations: {\n          eli5: `Python takes the old value of \\`${varName}\\` (\\`${this.formatVal(prevVal)}\\`), updates it using \\`${op}\\`, and stores the new result \\`${this.formatVal(newVal)}\\` back into \\`${varName}\\`!`,\n          beginner: `Updates \\`${varName}\\` from \\`${this.formatVal(prevVal)}\\` to \\`${this.formatVal(newVal)}\\` by computing \\`${substituted}\\`.`,\n          deep: `Evaluates augmented assignment \\`${augMatch[2]}\\` on \\`${varName}\\` and rebinds the identifier to \\`${this.formatVal(newVal)}\\`.`,\n          whyItHappened: `\\`${augMatch[2]}\\` is shorthand for \\`${varName} = ${varName} ${op} ${rhsExpr}\\`.`\n        }\n      });\n      return null;\n    }\n\n    // 5. Standard assignment: varName = expr\n    const assignMatch = text.match(/^([a-zA-Z_]\\w*)\\s*=\\s*(.+)$/);\n    if (assignMatch && !text.includes(\"==\")) {\n      const varName = assignMatch[1];\n      const rhsExpr = assignMatch[2].trim();\n      const prevVal = activeFrame.vars[varName];\n      const isNew = !(varName in activeFrame.vars);\n      const substituted = this.substituteVarsInExpr(rhsExpr, activeFrame.vars);\n      const newVal = this.evalExpr(rhsExpr, activeFrame.vars, functions, callStack, steps, stdout, node.line);\n\n      activeFrame.prevVars[varName] = prevVal;\n      activeFrame.vars[varName] = newVal;\n\n      steps.push({\n        stepIndex: steps.length + 1,\n        line: node.line,\n        codeText: text,\n        eventType: \"ASSIGN\",\n        scopes: this.snapshotScopes(callStack, {\n          name: varName,\n          status: isNew ? \"new\" : \"updated\",\n          prevValue: prevVal\n        }),\n        evalBreakdown:\n          substituted !== rhsExpr\n            ? `${rhsExpr}  ==>  ${substituted}  ==>  ${this.formatVal(newVal)}   (stored in ${varName})`\n            : `${varName}  <--  ${this.formatVal(newVal)}`,\n        branchResult: null,\n        loopMechanics: null,\n        conditionMechanics: null,\n        functionMechanics: null,\n        stdout: [...stdout],\n        explanations: {\n          eli5: isNew\n            ? `Python creates a brand-new labeled box in memory called **\\`${varName}\\`** and puts **\\`${this.formatVal(newVal)}\\`** inside it!`\n            : `Python calculates the right side first (\\`${substituted}\\` = \\`${this.formatVal(newVal)}\\`), then replaces the old value in **\\`${varName}\\`** (was \\`${this.formatVal(prevVal)}\\`, now \\`${this.formatVal(newVal)}\\`).`,\n          beginner: isNew\n            ? `**New Variable Created**: Python evaluates the right-hand side (\\`${rhsExpr}\\` $\\\\rightarrow$ \\`${this.formatVal(newVal)}\\`) and stores it in a new variable \\`${varName}\\` (type \\`${this.getPythonType(newVal)}\\`).`\n            : `**Variable Updated**: Python evaluates \\`${rhsExpr}\\` using current memory values (\\`${substituted}\\` $\\\\rightarrow$ \\`${this.formatVal(newVal)}\\`) and overwrites \\`${varName}\\` from \\`${this.formatVal(prevVal)}\\` to \\`${this.formatVal(newVal)}\\`.`,\n          deep: `Evaluates RHS expression \\`${rhsExpr}\\` to object \\`${this.formatVal(newVal)}\\` (\\`${this.getPythonType(newVal)}\\`) and binds identifier \\`${varName}\\` in \\`${activeFrame.frameName}\\`.`,\n          whyItHappened: `Rule of \\`=\\` in Python: Always calculate the **Right-Hand Side** completely first, then store that answer in the variable name on the **Left-Hand Side**.`\n        }\n      });\n      return null;\n    }\n\n    return null;\n  }\n\n  evalExpr(expr, scopeVars, functions, callStack, steps, stdout, lineNum) {\n    const trimmed = expr.trim();\n\n    // Check range(...)\n    const rangeMatch = trimmed.match(/^range\\((.+)\\)$/);\n    if (rangeMatch) {\n      const parts = this.splitTopLevelArgs(rangeMatch[1]).map((a) =>\n        Number(this.evalExpr(a, scopeVars, functions, callStack, steps, stdout, lineNum))\n      );\n      let start = 0,\n        stop = 0,\n        step = 1;\n      if (parts.length === 1) {\n        stop = parts[0];\n      } else if (parts.length === 2) {\n        start = parts[0];\n        stop = parts[1];\n      } else if (parts.length >= 3) {\n        start = parts[0];\n        stop = parts[1];\n        step = parts[2] || 1;\n      }\n      const arr = [];\n      if (step > 0) {\n        for (let v = start; v < stop; v += step) arr.push(v);\n      } else if (step < 0) {\n        for (let v = start; v > stop; v += step) arr.push(v);\n      }\n      return arr;\n    }\n\n    // Check len(...)\n    const lenMatch = trimmed.match(/^len\\((.+)\\)$/);\n    if (lenMatch) {\n      const target = this.evalExpr(lenMatch[1], scopeVars, functions, callStack, steps, stdout, lineNum);\n      return target && typeof target.length === \"number\" ? target.length : 0;\n    }\n\n    // Check user-defined function call: funcName(arg1, arg2)\n    const callMatch = trimmed.match(/^([a-zA-Z_]\\w*)\\((.*)\\)$/);\n    if (callMatch && functions[callMatch[1]]) {\n      const fnNode = functions[callMatch[1]];\n      const rawArgs = callMatch[2].trim() ? this.splitTopLevelArgs(callMatch[2]) : [];\n      const argVals = rawArgs.map((a) =>\n        this.evalExpr(a, scopeVars, functions, callStack, steps, stdout, lineNum)\n      );\n\n      const newFrameVars = {};\n      const mappings = [];\n      fnNode.params.forEach((p, idx) => {\n        newFrameVars[p] = argVals[idx];\n        mappings.push({\n          argExpr: rawArgs[idx] || \"None\",\n          argVal: this.formatVal(argVals[idx]),\n          paramName: p\n        });\n      });\n\n      const newFrame = {\n        frameName: `${fnNode.funcName}(${fnNode.params.map((p, i) => `${p}=${this.formatVal(argVals[i])}`).join(\", \")})`,\n        vars: newFrameVars,\n        prevVars: {}\n      };\n\n      callStack.push(newFrame);\n\n      steps.push({\n        stepIndex: steps.length + 1,\n        line: fnNode.line,\n        codeText: fnNode.text,\n        eventType: \"FUNC_CALL\",\n        scopes: this.snapshotScopes(callStack, null),\n        evalBreakdown: `Function Call from Line ${lineNum}: ${fnNode.funcName}(${rawArgs.join(\", \")}) -> ${newFrame.frameName}`,\n        branchResult: null,\n        loopMechanics: null,\n        conditionMechanics: null,\n        functionMechanics: {\n          type: \"CALL\",\n          funcName: fnNode.funcName,\n          callerLine: lineNum,\n          mappings,\n          note: `Arguments from Line ${lineNum} are copied into the function's parameter variables inside a brand-new Call Stack Frame!`\n        },\n        stdout: [...stdout],\n        explanations: {\n          eli5: `**Calling Function \\`${fnNode.funcName}\\`**: Python pauses Line ${lineNum}, opens a fresh workspace for \\`${fnNode.funcName}\\`, and plugs your inputs into its parameters (${mappings.map((m) => `\\`${m.paramName} = ${m.argVal}\\``).join(\", \")})!`,\n          beginner: `**Function Call & Parameter Binding**: Line ${lineNum} called \\`${fnNode.funcName}(${rawArgs.join(\", \")})\\`. Python pushes a new frame \\`${newFrame.frameName}\\` onto the Call Stack and binds each argument to its matching parameter.`,\n          deep: `Pushes new stack frame for \\`${fnNode.funcName}\\`, binding formal parameters ${mappings.map((m) => `\\`${m.paramName}=${m.argVal}\\``).join(\", \")} in local scope.`,\n          whyItHappened: `When you call a function, Python passes the argument values into the function's parameters and runs the function's lines.`\n        }\n      });\n\n      const res = this.executeBlock(fnNode.body, callStack, functions, steps, stdout);\n      callStack.pop();\n      return res && res.returned ? res.value : null;\n    }\n\n    // Replace Python operators/keywords for safe JS expression evaluation\n    let jsExpr = trimmed\n      .replace(/\\/\\//g, \"___INTDIV___\")\n      .replace(/\\band\\b/g, \"&&\")\n      .replace(/\\bor\\b/g, \"||\")\n      .replace(/\\bnot\\s+/g, \"!\")\n      .replace(/\\bTrue\\b/g, \"true\")\n      .replace(/\\bFalse\\b/g, \"false\")\n      .replace(/\\bNone\\b/g, \"null\");\n\n    if (jsExpr.includes(\"___INTDIV___\")) {\n      const parts = jsExpr.split(\"___INTDIV___\");\n      if (parts.length === 2) {\n        jsExpr = `Math.floor((${parts[0]}) / (${parts[1]}))`;\n      }\n    }\n\n    const keys = Object.keys(scopeVars);\n    const vals = keys.map((k) => scopeVars[k]);\n    try {\n      const fn = new Function(...keys, `return (${jsExpr});`);\n      return fn(...vals);\n    } catch (e) {\n      throw { message: e.message, line: lineNum };\n    }\n  }\n\n  substituteVarsInExpr(expr, scopeVars) {\n    let result = expr;\n    const sortedNames = Object.keys(scopeVars).sort((a, b) => b.length - a.length);\n    for (const name of sortedNames) {\n      const regex = new RegExp(`\\\\b${name}\\\\b`, \"g\");\n      result = result.replace(regex, this.formatVal(scopeVars[name]));\n    }\n    return result;\n  }\n\n  splitTopLevelArgs(str) {\n    if (!str.trim()) return [];\n    const res = [];\n    let current = \"\";\n    let depth = 0;\n    let inSingle = false;\n    let inDouble = false;\n\n    for (let i = 0; i < str.length; i++) {\n      const ch = str[i];\n      if (ch === \"'\" && !inDouble) inSingle = !inSingle;\n      else if (ch === '\"' && !inSingle) inDouble = !inDouble;\n      else if (!inSingle && !inDouble) {\n        if (ch === \"(\" || ch === \"[\") depth++;\n        else if (ch === \")\" || ch === \"]\") depth--;\n        else if (ch === \",\" && depth === 0) {\n          res.push(current.trim());\n          current = \"\";\n          continue;\n        }\n      }\n      current += ch;\n    }\n    if (current.trim()) res.push(current.trim());\n    return res;\n  }\n\n  snapshotScopes(callStack, changedVarInfo) {\n    return callStack.map((frame, frameIdx) => {\n      const isTopFrame = frameIdx === callStack.length - 1;\n      const variables = Object.keys(frame.vars).map((varName) => {\n        const val = frame.vars[varName];\n        const isChangedHere = isTopFrame && changedVarInfo && changedVarInfo.name === varName;\n        return {\n          name: varName,\n          type: this.getPythonType(val),\n          value: Array.isArray(val) ? [...val] : val,\n          formattedValue: this.formatVal(val),\n          prevFormattedValue:\n            isChangedHere && changedVarInfo.prevValue !== undefined\n              ? this.formatVal(changedVarInfo.prevValue)\n              : null,\n          status: isChangedHere ? changedVarInfo.status : \"unchanged\"\n        };\n      });\n      return {\n        frameName: frame.frameName,\n        isActive: isTopFrame,\n        variables\n      };\n    });\n  }\n\n  getPythonType(val) {\n    if (val === null || val === undefined) return \"NoneType\";\n    if (Array.isArray(val)) return \"list\";\n    if (typeof val === \"boolean\") return \"bool\";\n    if (typeof val === \"number\") return Number.isInteger(val) ? \"int\" : \"float\";\n    if (typeof val === \"string\") return \"str\";\n    return typeof val;\n  }\n\n  formatVal(val) {\n    if (val === null || val === undefined) return \"None\";\n    if (typeof val === \"boolean\") return val ? \"True\" : \"False\";\n    if (typeof val === \"string\") return `\"${val}\"`;\n    if (Array.isArray(val)) return `[${val.map((v) => this.formatVal(v)).join(\", \")}]`;\n    return String(val);\n  }\n\n  describeUpcomingAction(nextStep) {\n    switch (nextStep.eventType) {\n      case \"ASSIGN\":\n        return \"calculate the right-hand side and update a variable in memory\";\n      case \"CONDITION\":\n        return \"evaluate a condition to True or False and decide whether to enter the block\";\n      case \"LOOP_ITER\":\n        return \"advance the loop to the next iteration\";\n      case \"LOOP_END\":\n        return \"finish the loop and move past the indented block\";\n      case \"PRINT\":\n        return \"display values in the Console Output\";\n      case \"FUNC_CALL\":\n        return \"pass arguments into parameters and enter the function\";\n      case \"RETURN\":\n        return \"return the computed result back to the caller\";\n      default:\n        return \"execute the statement\";\n    }\n  }\n\n  generateQuizForStep(currentStep, nextStep) {\n    if (!nextStep) return null;\n    if (nextStep.eventType === \"CONDITION\") {\n      return {\n        question: `Prediction Challenge: On Line ${nextStep.line} (\\`${nextStep.codeText}\\`), what will the condition evaluate to?`,\n        options: [\n          { label: \"True (Enter the indented block)\", isCorrect: nextStep.branchResult === true },\n          { label: \"False (Skip the indented block)\", isCorrect: nextStep.branchResult === false }\n        ],\n        explanation: nextStep.evalBreakdown\n      };\n    }\n    if (nextStep.eventType === \"ASSIGN\") {\n      const activeScope = nextStep.scopes[nextStep.scopes.length - 1];\n      const changed = activeScope.variables.find((v) => v.status !== \"unchanged\");\n      if (changed) {\n        const correctVal = changed.formattedValue;\n        const fake1 = typeof changed.value === \"number\" ? String(changed.value + 2) : `\"None\"`;\n        const fake2 = typeof changed.value === \"number\" ? String(changed.value * 2 + 1) : `0`;\n        const options = [\n          { label: `${changed.name} = ${correctVal}`, isCorrect: true },\n          { label: `${changed.name} = ${fake1}`, isCorrect: false },\n          { label: `${changed.name} = ${fake2}`, isCorrect: false }\n        ].sort(() => Math.random() - 0.5);\n        return {\n          question: `Prediction Challenge: After Line ${nextStep.line} (\\`${nextStep.codeText}\\`) runs, what will \\`${changed.name}\\` contain?`,\n          options,\n          explanation: nextStep.evalBreakdown\n        };\n      }\n    }\n    return null;\n  }\n\n  buildControlFlowGraph(statements) {\n    const nodes = [];\n    const edges = [];\n\n    const addNode = (id, label, type, line) => {\n      nodes.push({ id, label, type, line });\n      return id;\n    };\n\n    const startId = addNode(\"start\", \"START PROGRAM\", \"start\", 0);\n\n    const buildList = (stmts, prevIds) => {\n      let currentPrevs = prevIds;\n      for (const s of stmts) {\n        if (s.kind === \"IF_CHAIN\") {\n          const exitIds = [];\n          let condPrevIds = currentPrevs;\n          for (const br of s.branches) {\n            if (br.type === \"else\") {\n              const bodyEnd = buildList(br.body, condPrevIds);\n              exitIds.push(...bodyEnd);\n              condPrevIds = [];\n            } else {\n              const cid = addNode(`L${br.line}`, `${br.type.toUpperCase()}: ${br.condition}`, \"condition\", br.line);\n              condPrevIds.forEach((p) => edges.push({ from: p, to: cid }));\n              const bodyEnd = buildList(br.body, [cid]);\n              exitIds.push(...bodyEnd);\n              condPrevIds = [cid];\n            }\n          }\n          currentPrevs = [...exitIds, ...condPrevIds];\n        } else if (s.kind === \"FOR\" || s.kind === \"WHILE\") {\n          const label = s.kind === \"FOR\" ? `FOR ${s.iterVar} in ${s.iterExpr}` : `WHILE ${s.condition}`;\n          const loopId = addNode(`L${s.line}`, label, \"loop\", s.line);\n          currentPrevs.forEach((p) => edges.push({ from: p, to: loopId }));\n          const bodyEnd = buildList(s.body, [loopId]);\n          bodyEnd.forEach((b) => edges.push({ from: b, to: loopId, isBackEdge: true }));\n          currentPrevs = [loopId];\n        } else {\n          const nid = addNode(\n            `L${s.line}`,\n            s.text.length > 28 ? s.text.slice(0, 26) + \"..\" : s.text,\n            s.text.startsWith(\"print(\") ? \"output\" : s.kind === \"DEF\" ? \"func\" : \"stmt\",\n            s.line\n          );\n          currentPrevs.forEach((p) => edges.push({ from: p, to: nid }));\n          currentPrevs = [nid];\n        }\n      }\n      return currentPrevs;\n    };\n\n    const lastIds = buildList(statements, [startId]);\n    const endId = addNode(\"end\", \"END PROGRAM\", \"end\", 9999);\n    lastIds.forEach((p) => edges.push({ from: p, to: endId }));\n\n    return { nodes, edges };\n  }\n}\n\nwindow.PRESET_EXAMPLES = PRESET_EXAMPLES;\nwindow.PythonFlowTracer = PythonFlowTracer;\n","Description":"Upgrade tracer.js with Program Startup step, Next-Line Decision explanations, Loop Internals, Condition Evaluator, Function Parameter Binding, and Variable Timeline History","Overwrite":true,"TargetFile":"C:\\Users\\CVT\\.gemini\\antigravity\\scratch\\code-flow-visualizer\\tracer.js","toolAction":"Upgrading tracer.js with deep beginner mechanics","toolSummary":"Upgrade tracer.js with loop, condition, function, and timeline mechanics"}}]}
