:       (v) => this.formatVal(v),\n359:       (v) => this.getPythonType(v)\n360:     );\n361: \n362:     const statements = this.parseProgram(rawLines);\n363:     const cfg = this.buildControlFlowGraph(statements);\n364: \n365:     const steps = [];\n366:     const stdout = [];\n367:     const functions = {};\n368:     const classes = {};\n369:     const callStack = [\n370:       {\n371:         frameId: \"global\",\n372:         frameName: \"Global Scope\",\n373:         funcShortName: \"Global\",\n374:         scopeType: \"GLOBAL\",\n375:         vars: {},\n376:         prevVars: {}\n377:       }\n378:     ];\n379:     const loopStack = [];\n380: \n381:     Object.entries(inputVars).forEach(([k, v]) => {\n382:       const cloned = Array.isArray(v) ? [...v] : v;\n383:       callStack[0].vars[k] = cloned;\n384:       callStack[0].prevVars[k] = cloned;\n385:       this.heapTracker.getOrAllocate(cloned, 0);\n386:     });\n387: \n388:     let finalReturnVal = null;\n389: \n390:     try {\n391:       this.executeSuite(statements, callStack, functions, classes, steps, stdout, loopStack);\n392: \n393:       const fnNames = Object.keys(functions);\n394:       const onlyDefinitionsRan = steps.every(\n395:         (s) => s.eventType === \"CLASS_DEF\" || s.eventType === \"METHOD_DEF\" || s.eventType === \"FUNC_DEF\"\n396:       );\n397: \n398:       if (onlyDefinitionsRan && fnNames.length > 0) {\n399:         const fnNode = functions[fnNames[0]];\n400:         const argVals = this.resolveFunctionArguments(fnNode, callStack[0].vars);\n401:         const callRes = this.invokeFunctionNode(\n402:           fnNode,\n403:           argVals,\n404:           fnNode.params,\n405:           callStack,\n406:           functions,\n407:           classes,\n408:           steps,\n409:           stdout,\n410:           loopStack,\n411:           fnNode.line\n412:         );\n413:         if (callRes && callRes.returned) {\n414:           finalReturnVal = callRes.value;\n415:         }\n416