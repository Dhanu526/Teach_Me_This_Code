\n/* Extra-Compact Phones (<= 480px) */\n@media (max-width: 480px) {\n  .top-bar {\n    padding: 8px 10px;\n  }\n\n  .brand-area {\n    width: 100%;\n    justify-content: space-between;\n  }\n\n  .btn-nav {\n    font-size: 11px;\n    padding: 6px 2px;\n  }\n\n  .three-area-workspace {\n    padding: 10px;\n    gap: 12px;\n  }\n\n  .area-card {\n    padding: 12px;\n  }\n\n  .teach-step-title {\n    font-size: 16.5px;\n  }\n\n  .iterations-explorer-section,\n  .advanced-drawer {\n    margin: 0 10px 16px 10px;\n    padding: 12px;\n  }\n}\n","StartLine":1466,"TargetContent":"@media (max-width: 1180px) {\n  .three-area-workspace {\n    grid-template-columns: 1fr;\n  }\n  .advanced-grid {\n    grid-template-columns: 1fr 1fr;\n  }\n  .iter-step-row {\n    grid-template-columns: 70px 60px 1fr;\n  }\n}","TargetFile":"C:\\Users\\CVT\\.gemini\\antigravity\\scratch\\code-flow-visualizer\\app_build\\styles.css","toolAction":"Updating styles.css for mobile responsiveness","toolSummary":"Add mobile & tablet responsive styles to styles.css"}}]}
