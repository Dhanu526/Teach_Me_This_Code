     whyCondition,\n509:       whatNext: lesson.whatHappensNext\n510:     };\n511:   }\n512: \n513:   explainSymbolsInLine(codeText) {\n514:     const matches = [];\n515:     for (const item of PYTHON_SYMBOLS_LIBRARY) {\n516:       if (codeText.includes(item.token)) {\n517:         matches.push(`• \\`${item.label}\\`: ${item.desc}`);\n518:       }\n519:     }\n520:     return matches.length ? matches.slice(0, 3).join(\"<br>\") : \"• Standard Python statement.\";\n521:   }\n522: \n523:   buildExecutionSummary(traceResult) {\n524:     if (!traceResult.ok || !traceResult.steps.length) {\n525:       return `Stopped: ${traceResult.errorMessage || \"Check syntax or input.\"}`;\n526:     }\n527:     if (traceResult.finalResult !== null) {\n528:       return `Final Answer: **${traceResult.finalResult}** (${traceResult.steps.length} steps)`;\n529:     }\n530:     return `Completed in ${traceResult.steps.length} steps.`;\n531:   }\n532: }\n533: \n534: window.RuleBasedExplainer = RuleBasedExplainer;\n535: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
