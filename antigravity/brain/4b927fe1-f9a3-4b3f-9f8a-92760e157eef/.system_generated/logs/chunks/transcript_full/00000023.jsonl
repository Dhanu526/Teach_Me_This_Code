{"step_index":327,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-25T11:35:17Z","content":"Created At: 2026-10-25T17:05:17+05:30\nCompleted At: 2026-10-25T17:05:17+05:30\nFile Path: `file:///C:/Users/CVT/.gemini/antigravity/scratch/code-flow-visualizer/app_build/engine.js`\nTotal Lines: 2916\nTotal Bytes: 100543\nShowing lines 1 to 150\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // app_build/engine.js — Universal Offline Python Execution & Memory Visualizer Engine\n2: // Zero AI APIs. Supports:\n3: // - Full OOP: Classes, `__init__`, `self`, instance attributes (`self.items`), instance methods (`s.push(10)`, `self.is_empty()`)\n4: // - Full DSA & Standard Python: Lists, Dicts, Sets, Strings, Slicing, Comprehensions, Recursion, Loops, Short-Circuit (`and`/`or`)\n5: // - Thonny Visual Reference Model (`Name -> @Address -> Value`), Scope Isolation (`Global` vs. `Local`), and Visual GC\n6: \n7: const PRELOADED_PROGRAMS = {\n8:   max_subarray: {\n9:     title: \"Maximum Subarray (Kadane's Algorithm)\",\n10:     defaultInput: \"nums = [-2, 1, -3, 4, -1, 2, 1, -5, 4]\",\n11:     algorithmOverview:\n12:       \"This code finds the largest sum you can get from a continuous section of the list.\",\n13:     code: `class Solution:\n14:     def maxSubArray(self, nums: list[int]) -> int:\n15:         c = 0\n16:         ans = nums[0]\n17: \n18:         for i in range(len(nums)):\n19:             c += nums[i]\n20: \n21:             if c >= ans:\n22:                 ans = c\n23: \n24:             if c < 0:\n25:                 c = 0\n26: \n27:         return ans`\n28:   },\n29:   stack_class: {\n30:     title: \"Stack Data Structure (OOP Class & Methods)\",\n31:     defaultInput: \"\",\n32:     algorithmOverview:\n33:       \"This code defines a Stack data structure (Last-In, First-Out) using a Python class and tests push, pop, peek, size, and is_empty.\",\n34:     code: `class Stack:\n35:     def __init__(self):\n36:         self.items = []\n37: \n38:     def push(self, item):\n39:         self.items.append(item)\n40: \n41:     def pop(self):\n42:         if not self.is_empty():\n43:             return self.items.pop()\n44:         return None\n45: \n46:     def peek(self):\n47:         if not self.is_empty():\n48:             return self.items[-1]\n49:         return None\n50: \n51:     def is_empty(self):\n52:         return len(self.items) == 0\n53: \n54:     def size(self):\n55:         return len(self.items)\n56: \n57: \n58: # Example usage\n59: s = Stack()\n60: s.push(10)\n61: s.push(20)\n62: s.push(30)\n63: \n64: print(s.pop())    # 30\n65: print(s.peek())   # 20\n66: print(s.size())   # 2\n67: print(s.is_empty())  # False`\n68:   },\n69:   binary_search: {\n70:     title: \"Binary Search (Two Pointers: left, right, mid)\",\n71:     defaultInput: \"arr = [1, 3, 5, 7, 9, 11, 13], target = 7\",\n72:     algorithmOverview:\n73:       \"This code searches a sorted list for a target number by checking the middle index (mid) and cutting the search range (left to right) in half.\",\n74:     code: `def binary_search(arr, target):\n75:     left, right = 0, len(arr) - 1\n76: \n77:     while left <= right:\n78:         mid = (left + right) // 2\n79: \n80:         if arr[mid] == target:\n81:             return mid\n82:         elif arr[mid] < target:\n83:             left = mid + 1\n84:         else:\n85:             right = mid - 1\n86: \n87:     return -1`\n88:   },\n89:   recursion_factorial: {\n90:     title: \"Recursion & Call Stack Scopes (Factorial)\",\n91:     defaultInput: \"n = 4\",\n92:     algorithmOverview:\n93:       \"This code calculates the factorial of n (4 * 3 * 2 * 1 = 24) by creating isolated Local Scope frames on the call stack.\",\n94:     code: `def factorial(k: int) -> int:\n95:     if k <= 1:\n96:         return 1\n97:     sub = factorial(k - 1)\n98:     return k * sub\n99: \n100: ans = factorial(n)\n101: print(\"Factorial is:\", ans)`\n102:   }\n103: };\n104: \n105: function isPyInstance(val) {\n106:   return Boolean(val && typeof val === \"object\" && !Array.isArray(val) && val.__class__);\n107: }\n108: \n109: class MemoryHeapTracker {\n110:   constructor(formatValFn, getTypeFn) {\n111:     this.formatVal = formatValFn;\n112:     this.getType = getTypeFn;\n113:     this.scalarCounter = 0x1000;\n114:     this.containerCounter = 0x2000;\n115:     this.instanceCounter = 0x3000;\n116:     this.scalarPool = new Map();\n117:     this.containerWeakMap = new WeakMap();\n118:     this.heapRegistry = new Map();\n119:   }\n120: \n121:   getOrAllocate(val, stepIdx) {\n122:     const pyType = this.getType(val);\n123:     const valRepr = this.formatVal(val);\n124: \n125:     if (isPyInstance(val)) {\n126:       let addr = this.containerWeakMap.get(val);\n127:       if (!addr) {\n128:         addr = `@0x${this.instanceCounter.toString(16).toUpperCase().padStart(4, \"0\")}`;\n129:         this.instanceCounter += 0x40;\n130:         this.containerWeakMap.set(val, addr);\n131:       }\n132:       // Also ensure any list/dict attributes inside the instance are registered on the heap\n133:       const attrEntries = Object.entries(val).filter(([k]) => k !== \"__class__\");\n134:       for (const [, attrVal] of attrEntries) {\n135:         if (Array.isArray(attrVal) || (attrVal && typeof attrVal === \"object\")) {\n136:           this.getOrAllocate(attrVal, stepIdx);\n137:         }\n138:       }\n139:       this.heapRegistry.set(addr, {\n140:         address: addr,\n141:         type: `${val.__class__} object`,\n142:         repr: valRepr,\n143:         isMutable: true,\n144:         elements: attrEntries.map(([k, v]) => `${k}: ${this.formatVal(v)}`),\n145:         rawElements: { ...val },\n146:         lastTouchedStep: stepIdx\n147:       });\n148:       return addr;\n149:     }\n150: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
