-textarea {\n    min-height: 240px;\n    font-size: 13px;\n    padding: 10px;\n  }\n\n  /* Area 2: Teaching Area & Thonny Stepper */\n  .teaching-card-inner {\n    gap: 14px;\n  }\n\n  .iteration-jump-strip {\n    padding: 9px 11px;\n  }\n\n  .iteration-jump-header {\n    flex-wrap: wrap;\n    gap: 6px;\n  }\n\n  .iteration-jump-label {\n    font-size: 11px;\n  }\n\n  .iteration-pills-bar {\n    -webkit-overflow-scrolling: touch;\n    padding-bottom: 6px;\n  }\n\n  .iter-pill-btn {\n    padding: 6px 10px;\n    font-size: 11.5px;\n    touch-action: manipulation;\n  }\n\n  .teach-header-row {\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n\n  .teach-step-title {\n    font-size: 18px;\n    line-height: 1.3;\n  }\n\n  .teach-code-box {\n    font-size: 14px;\n    padding: 10px 12px;\n    overflow-x: auto;\n    white-space: pre-wrap;\n    word-break: break-word;\n  }\n\n  .thonny-expr-card {\n    padding: 11px 12px;\n  }\n\n  .thonny-expr-header {\n    flex-wrap: wrap;\n    gap: 6px;\n  }\n\n  .thonny-live-code {\n    font-size: 13.5px;\n    padding: 8px 10px;\n  }\n\n  .thonny-focus-note {\n    font-size: 12.5px;\n  }\n\n  .teach-calc-box {\n    padding: 11px 12px;\n  }\n\n  .calc-row {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 3px;\n    font-size: 13px;\n  }\n\n  .calc-label {\n    width: auto;\n    font-size: 11.5px;\n    text-transform: uppercase;\n    letter-spacing: 0.3px;\n  }\n\n  .calc-val {\n    word-break: break-word;\n  }\n\n  .teach-meaning-text {\n    font-size: 15px;\n    line-height: 1.55;\n  }\n\n  .teach-vars-now {\n    font-size: 13px;\n    padding: 9px 11px;\n    word-break: break-word;\n  }\n\n  .teach-next-text {\n    font-size: 13.5px;\n  }\n\n  .final-answer-heading {\n    font-size: 18px;\n  }\n\n  .final-answer-detail {\n    font-size: 14px;\n  }\n\n  /* Area 3: Scopes & Stack/Heap Memory Model */\n  .scope-var-row {\n    grid-template-columns: 1fr auto;\n    row-gap: 4px;\n    padding: 8px 10px;\n    font-size: 12.5px;\n  