  <span class=\"loop-pointer-indicator\">▲ pointer</span>\n980:           </div>\n981:         `;\n982:       })\n983:       .join(\"\");\n984: \n985:     this.visualLoopStrip.innerHTML = `\n986:       <div class=\"loop-strip-header\">\n987:         <span>Loop Pointer & List Elements (nums)</span>\n988:         <span class=\"loop-current-info-pill\">Pass ${passNum}/${total} • i = ${activeIdx} • nums[${activeIdx}] = ${activeVal}</span>\n989:       </div>\n990:       <div class=\"loop-track-scroll\">\n991:         ${cellsHTML}\n992:       </div>\n993:     `;\n994: \n995:     // Center active loop pointer in view\n996:     const activeEl = this.visualLoopStrip.querySelector(\".is-active-pointer\");\n997:     const scrollBox = this.visualLoopStrip.querySelector(\".loop-track-scroll\");\n998:     if (activeEl && scrollBox) {\n999:       const targetLeft =\n1000:         activeEl.offsetLeft - scrollBox.offsetLeft - scrollBox.clientWidth / 2 + activeEl.clientWidth / 2;\n1001:       scrollBox.scrollTo({ left: Math.max(0, targetLeft), behavior: \"smooth\" });\n1002:     }\n1003:   }\n1004: \n1005:   /* PHASE 3: Show comparisons using actual values, True/False badge, and highlight executing branch */\n1006:   renderVisualConditionGate(step, currentSubstep) {\n1007:     if (!this.visualConditionGate) return;\n1008:     const cond = step.condition;\n1009:     const op = step.operationDetail || {};\n1010:     const isWhileCheck = op.kind === \"while_check\";\n1011: \n1012:     if (!cond || (step.eventType !== \"CONDITION\" && !isWhileCheck)) {\n1013:       this.visualConditionGate.classList.add(\"hidden\");\n1014:       this.visualConditionGate.innerHTML = \"\";\n1015:       return;\n1016:     }\n1017: \n1018:     this.visualConditionGate.classList.remove(\"hidden\");\n1019:     const isTrue = Boolean(cond.result);\n1020:     const leftName = cond.leftExpr || \"Left\";\n1021:     const leftVal = cond.leftVal !== undefined ? cond.leftVal : \"\";\n1022:     const rightName = cond.rightExpr || \"Right\";\n1023:     const rightVal = cond.rightVal !== undefined ? cond.rightVal : \"\";\n1024:     const opSym = cond.operator || \"==\";\n1025: \n1026:     const isMaxCheck = cond.expr === \"c >= ans\" || (leftName === \"c\" && rightName === \"ans\");\n1027:     const isNegCheck = cond.expr === \"c < 0\" || (leftName === \"c\" && rightVal === \"0\" && opSym === \"<\");\n1028: \n1029:     let branch1Code = \"Enter branch\";\n1030:     let branch1Desc = `Condition is True: execute indented block`;\n1031:     let branch2Code = \"Skip branch\";\n1032:     let branch2Desc = `Condition is False: skip indented block`;\n1033: \n1034:     if (isWhileCheck) {\n1035:       branch1Code = `Enter loop body (Pass #${op.iteration || 1})`;\n1036:       branch1Desc = \"Condition is True: continue while loop\";\n1037:       branch2Code = \"Exit loop\";\n1038:       branch2Desc = \"Condition is False: terminate while loop\";\n1039:     } else if (isMaxCheck) {\n1040:       branch1Code = \"ans = c\";\n1041:       branch1Desc = `Update record: ans becomes ${leftVal}`;\n1042:       branch2Code = \"Keep ans\";\n1043:       branch2Desc = `ans preserves previous best sum of ${rightVal}`;\n1044:     } else if (isNegCheck) {\n1045:       branch1Code = \"c = 0\";\n1046:       branch1Desc = \"Reset negative sum to zero\";\n1047:       branch2Code = `Keep c = ${leftVal}`;\n1048:       branch2Desc = \"Keep running sum for future additions\";\n1049:     }\n1050: \n1051:     this.visualConditionGate.innerHTML = `\n1052:       <div class=\"cond-gate-header\">\n1053:         <span>Condition Comparison Gate & Decision</span>\n1054:         <span class=\"decision-badge ${isTrue ? \"is-true\" : \"is-false\"}\">\n1055:           ${isTrue ? \"✓ TRUE\" : \"✗ FALSE\"}\n1056:         </span>\n1057:       </div>\n1058:       <div class=\"cond-balance-row\">\n1059:         <div class=\"cond-val-box\">\n1060:           <span class=\"cond-val-name\">${this.escapeHTML(leftName)}</span>\n1061:     