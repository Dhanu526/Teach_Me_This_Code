 !inSingle) inDouble = !inDouble;\n2359:       else if (!inSingle && !inDouble) {\n2360:         if (ch === \"(\" || ch === \"[\") depth++;\n2361:         else if (ch === \")\" || ch === \"]\") depth--;\n2362:         else if (ch === \",\" && depth === 0) {\n2363:           res.push(current.trim());\n2364:           current = \"\";\n2365:           continue;\n2366:         }\n2367:       }\n2368:       current += ch;\n2369:     }\n2370:     if (current.trim()) res.push(current.trim());\n2371:     return res;\n2372:   }\n2373: \n2374:   getPythonType(val) {\n2375:     if (val === null || val === undefined) return \"NoneType\";\n2376:     if (Array.isArray(val)) return \"list\";\n2377:     if (typeof val === \"boolean\") return \"bool\";\n2378:     if (typeof val === \"number\") return Number.isInteger(val) ? \"int\" : \"float\";\n2379:     if (typeof val === \"string\") return \"str\";\n2380:     return typeof val;\n2381:   }\n2382: \n2383:   formatVal(val) {\n2384:     if (val === null || val === undefined) return \"None\";\n2385:     if (typeof val === \"boolean\") return val ? \"True\" : \"False\";\n2386:     if (typeof val === \"string\") return `\"${val}\"`;\n2387:     if (Array.isArray(val)) return `[${val.map((v) => this.formatVal(v)).join(\", \")}]`;\n2388:     return String(val);\n2389:   }\n2390: \n2391:   buildControlFlowGraph(statements) {\n2392:     const nodes = [];\n2393:     const edges = [];\n2394: \n2395:     const addNode = (id, label, type, line) => {\n2396:       nodes.push({ id, label, type, line });\n2397:       return id;\n2398:     };\n2399: \n2400:     const startId = addNode(\"start\", \"START\", \"start\", 0);\n2401: \n2402:     const buildList = (stmts, prevIds) => {\n2403:       let currentPrevs = prevIds;\n2404:       for (const s of stmts) {\n2405:         if (s.kind === \"CLASS\") {\n2406:           const cid = addNode(`L${s.line}`, `class ${s.className}`, \"class\", s.line);\n2407:           currentPrevs.forEach((p) => edges.push({ from: p, to: cid }));\n2408:           currentPrevs = buildList(s.body, [cid]);\n2409:         } else if (s.kind === \"DEF\") {\n2410:           const fid = addNode(`L${s.line}`, `def ${s.funcName}()`, \"func\", s.line);\n2411:           currentPrevs.forEach((p) => edges.push({ from: p, to: fid }));\n2412:           currentPrevs = buildList(s.body, [fid]);\n2413:         } else if (s.kind === \"IF_CHAIN\") {\n2414:           const exitIds = [];\n2415:           let condPrevIds = currentPrevs;\n2416:           for (const br of s.branches) {\n2417:             if (br.type === \"else\") {\n2418:               const bodyEnd = buildList(br.body, condPrevIds);\n2419:               exitIds.push(...bodyEnd);\n2420:               condPrevIds = [];\n2421:             } else {\n2422:               const cid = addNode(`L${br.line}`, `${br.condition} ?`, \"decision\", br.line);\n2423:               condPrevIds.forEach((p) => edges.push({ from: p, to: cid }));\n2424:               const bodyEnd = buildList(br.body, [cid]);\n2425:               exitIds.push(...bodyEnd);\n2426:               condPrevIds = [cid];\n2427:             }\n2428:           }\n2429:           currentPrevs = [...exitIds, ...condPrevIds];\n2430:         } else if (s.kind === \"FOR\" || s.kind === \"WHILE\") {\n2431:           const label =\n2432:             s.kind === \"FOR\"\n2433:               ? `for ${s.iterVar} in ${s.iterExpr}`\n2434:               : `while ${s.condition}`;\n2435:           const loopId = addNode(`L${s.line}`, label, \"loop\", s.line);\n2436:           currentPrevs.forEach((p) => edges.push({ from: p, to: loopId }));\n2437:           const bodyEnd = buildList(s.body, [loopId]);\n2438:           bodyEnd.forEach((b) => edges.push({ from: b, to: loopId, isBackEdge: true }));\n2439:           currentPrevs = [loopId];\n2440:         } else {\n2441:           const type = s.text.startsWith(\"return\") ? \"return\" : \"stmt\";\n2442:           const nid = addNode(\n2443:             `L${s.lin