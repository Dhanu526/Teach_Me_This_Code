{"step_index":165,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-10T12:15:26Z","content":"Created At: 2026-10-10T17:45:26+05:30\nCompleted At: 2026-10-10T17:45:26+05:30\nFile Path: `file:///C:/Users/CVT/.gemini/antigravity/scratch/code-flow-visualizer/app_build/engine.js`\nTotal Lines: 2465\nTotal Bytes: 80397\nShowing lines 1 to 220\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // app_build/engine.js — Thonny-Style Python Execution Engine\n2: // Zero AI APIs. Includes:\n3: // 1. Visual Reference Model (Name -> @Address -> Value Stack & Heap Memory Tracker)\n4: // 2. Step-by-Step Sub-Expression Evaluator with Short-Circuit ('and' / 'or') Handling\n5: // 3. Global vs. Local Variable Scope Isolation across the call stack\n6: // 4. Visual Garbage Collection (Reference counting & unreferenced heap object filtering)\n7: \n8: const PRELOADED_PROGRAMS = {\n9:   max_subarray: {\n10:     title: \"1. Maximum Subarray (Kadane's Algorithm — Default)\",\n11:     defaultInput: \"nums = [-2, 1, -3, 4, -1, 2, 1, -5, 4]\",\n12:     algorithmOverview:\n13:       \"This code finds the largest sum you can get from a continuous section of the list.\",\n14:     code: `class Solution:\n15:     def maxSubArray(self, nums: list[int]) -> int:\n16:         c = 0\n17:         ans = nums[0]\n18: \n19:         for i in range(len(nums)):\n20:             c += nums[i]\n21: \n22:             if c >= ans:\n23:                 ans = c\n24: \n25:             if c < 0:\n26:                 c = 0\n27: \n28:         return ans`\n29:   },\n30:   binary_search: {\n31:     title: \"2. Binary Search (Two Pointers: left, right, mid)\",\n32:     defaultInput: \"arr = [1, 3, 5, 7, 9, 11, 13], target = 7\",\n33:     algorithmOverview:\n34:       \"This code searches a sorted list for a target number by checking the middle index (`mid`) and cutting the search range (`left` to `right`) in half.\",\n35:     code: `def binary_search(arr, target):\n36:     left, right = 0, len(arr) - 1\n37: \n38:     while left <= right:\n39:         mid = (left + right) // 2\n40: \n41:         if arr[mid] == target:\n42:             return mid\n43:         elif arr[mid] < target:\n44:             left = mid + 1\n45:         else:\n46:             right = mid - 1\n47: \n48:     return -1`\n49:   },\n50:   short_circuit_search: {\n51:     title: \"3. Short-Circuit Guard: Safe Linear Scan (i < len(arr) and arr[i] == target)\",\n52:     defaultInput: \"arr = [2, 4, 6], target = 9\",\n53:     algorithmOverview:\n54:       \"Demonstrates short-circuit evaluation (`and`): when `i` reaches `len(arr)` (3), `i < len(arr)` is False so Python skips `arr[i]` and avoids an IndexError.\",\n55:     code: `def safe_check(arr, target):\n56:     i = 3\n57:     if i < len(arr) and arr[i] == target:\n58:         return i\n59:     return -1`\n60:   },\n61:   nested_loops: {\n62:     title: \"4. Nested Loops: Pair Sum Counter\",\n63:     defaultInput: \"nums = [1, 2, 3, 4]\",\n64:     algorithmOverview:\n65:       \"This code checks every pair of numbers in the list using two nested loops and counts how many pairs add up to an even number.\",\n66:     code: `pairs = 0\n67: total = 0\n68: \n69: for i in range(len(nums)):\n70:     for j in range(i + 1, len(nums)):\n71:         pair_sum = nums[i] + nums[j]\n72:         if pair_sum % 2 == 0:\n73:             pairs += 1\n74:             total += pair_sum\n75: \n76: print(\"Even pairs:\", pairs)\n77: print(\"Total sum:\", total)`\n78:   },\n79:   recursion_factorial: {\n80:     title: \"5. Recursion & Local Scopes: Factorial\",\n81:     defaultInput: \"n = 4\",\n82:     algorithmOverview:\n83:       \"This code calculates the factorial of `n` (4 * 3 * 2 * 1 = 24) by creating isolated Local Scope frames on the call stack.\",\n84:     code: `def factorial(k: int) -> int:\n85:     if k <= 1:\n86:         return 1\n87:     sub = factorial(k - 1)\n88:     return k * sub\n89: \n90: ans = factorial(n)\n91: print(\"Factorial is:\", ans)`\n92:   }\n93: };\n94: \n95: class MemoryHeapTracker {\n96:   constructor(formatValFn, getTypeFn) {\n97:     this.formatVal = formatValFn;\n98:     this.getType = getTypeFn;\n99:     this.scalarCounter = 0x1000;\n100:     this.containerCounter = 0x2000;\n101:     this.scalarPool = new Map(); // key: `${type}:${repr}` -> address\n102:     this.containerWeakMap = new WeakMap(); // Array reference -> address\n103:     this.heapRegistry = new Map(); // address -> metadata\n104:   }\n105: \n106:   getOrAllocate(val, stepIdx) {\n107:     const pyType = this.getType(val);\n108:     const valRepr = this.formatVal(val);\n109: \n110:     if (Array.isArray(val)) {\n111:       let addr = this.containerWeakMap.get(val);\n112:       if (!addr) {\n113:         addr = `@0x${this.containerCounter.toString(16).toUpperCase().padStart(4, \"0\")}`;\n114:         this.containerCounter += 0x40;\n115:         this.containerWeakMap.set(val, addr);\n116:       }\n117:       this.heapRegistry.set(addr, {\n118:         address: addr,\n119:         type: \"list\",\n120:         repr: valRepr,\n121:         isMutable: true,\n122:         elements: val.map((item) => this.formatVal(item)),\n123:         rawElements: [...val],\n124:         lastTouchedStep: stepIdx\n125:       });\n126:       return addr;\n127:     }\n128: \n129:     const key = `${pyType}:${valRepr}`;\n130:     let addr = this.scalarPool.get(key);\n131:     if (!addr) {\n132:       addr = `@0x${this.scalarCounter.toString(16).toUpperCase().padStart(4, \"0\")}`;\n133:       this.scalarCounter += 0x08;\n134:       this.scalarPool.set(key, addr);\n135:     }\n136:     this.heapRegistry.set(addr, {\n137:       address: addr,\n138:       type: pyType,\n139:       repr: valRepr,\n140:       isMutable: false,\n141:       elements: null,\n142:       rawElements: null,\n143:       lastTouchedStep: stepIdx\n144:     });\n145:     return addr;\n146:   }\n147: \n148:   captureSnapshot(scopeFrames, stepIdx, changedVars = []) {\n149:     const refCounts = new Map();\n150:     const referencedBy = new Map();\n151: \n152:     for (const addr of this.heapRegistry.keys()) {\n153:       refCounts.set(addr, 0);\n154:       referencedBy.set(addr, []);\n155:     }\n156: \n157:     for (const scope of scopeFrames) {\n158:       const scopeTag = scope.scopeType === \"GLOBAL\" ? \"Global\" : scope.funcShortName || scope.title;\n159:       for (const v of scope.variables) {\n160:         if (v.address && this.heapRegistry.has(v.address)) {\n161:           refCounts.set(v.address, (refCounts.get(v.address) || 0) + 1);\n162:           referencedBy.get(v.address).push(`${scopeTag}.${v.name}`);\n163:         }\n164:       }\n165:     }\n166: \n167:     const changedAddrSet = new Set(changedVars.map((c) => c.address).filter(Boolean));\n168:     const activeHeap = [];\n169:     const gcHeap = [];\n170: \n171:     for (const [addr, meta] of this.heapRegistry.entries()) {\n172:       const rc = refCounts.get(addr) || 0;\n173:       const entry = {\n174:         ...meta,\n175:         refCount: rc,\n176:         referencedBy: referencedBy.get(addr) || [],\n177:         isHighlighted: changedAddrSet.has(addr),\n178:         gcStatus: rc > 0 ? \"active\" : \"unreferenced\"\n179:       };\n180:       if (rc > 0) {\n181:         activeHeap.push(entry);\n182:       } else {\n183:         gcHeap.push(entry);\n184:       }\n185:     }\n186: \n187:     return {\n188:       stackScopes: scopeFrames,\n189:       heapObjects: activeHeap,\n190:       gcObjects: gcHeap.slice(-4), // Most recent unreferenced objects for Visual GC view\n191:       totalUnreferencedCount: gcHeap.length\n192:     };\n193:   }\n194: }\n195: \n196: class PythonExecutionEngine {\n197:   constructor() {\n198:     this.maxSteps = 400;\n199:   }\n200: \n201:   validateSupport(sourceCod