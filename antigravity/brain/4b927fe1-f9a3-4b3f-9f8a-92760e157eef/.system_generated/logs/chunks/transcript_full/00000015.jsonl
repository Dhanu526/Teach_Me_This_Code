               ? `<span class=\"changed-pill\">Changed</span>`\n582:                   : \"\";\n583:               const valPreview = Array.isArray(v.rawValue)\n584:                 ? `list[${v.rawValue.length}]`\n585:                 : `${v.type}: ${v.current}`;\n586:               return `\n587:                 <div class=\"scope-var-row ${isChanged ? \"var-row-changed\" : \"\"}\">\n588:                   <span class=\"var-name-cell\">${this.escapeHTML(v.name)}${pill}</span>\n589:                   <span class=\"ref-arrow-badge\" title=\"Variable '${this.escapeHTML(\n590:                     v.name\n591:                   )}' points to Heap Address ${this.escapeHTML(v.address || \"@0x1000\")}\">\n592:                     ──► ${this.escapeHTML(v.address || \"@0x1000\")}\n593:                   </span>\n594:                   <span class=\"var-val-preview\" title=\"${this.escapeHTML(v.current)}\">\n595:                     ${this.escapeHTML(valPreview)}\n596:                   </span>\n597:                 </div>\n598:               `;\n599:             })\n600:             .join(\"\");\n601:         }\n602: \n603:         card.innerHTML = `\n604:           <div class=\"scope-frame-header\">\n605:             <span>${this.escapeHTML(sc.title)}</span>\n606:             <span class=\"scope-active-tag\">${headerBadge}</span>\n607:           </div>\n608:           <div class=\"scope-vars-list\">${rowsHTML}</div>\n609:         `;\n610:         this.scopeFramesContainer.appendChild(card);\n611:       });\n612:     }\n613: \n614:     // 2. Render Heap Memory Objects + Task 3.3 Visual Garbage Collection\n615:     const activeHeap = memoryModel.heapObjects || [];\n616:     const gcHeap = memoryModel.gcObjects || [];\n617:     const totalGC = memoryModel.totalUnreferencedCount || gcHeap.length;\n618: \n619:     if (this.btnToggleGC) {\n620:       this.btnToggleGC.textContent = this.showGCObjects\n621:         ? `Hide GC'd (${totalGC})`\n622:         : `Show GC'd (${totalGC})`