t = `Scope: ${step.functionName} (${step.scopeType || \"LOCAL\"}) | Event: ${step.eventType} | Line ${step.line} | Step ${step.stepIndex}/${total}`;\n712:     this.advTechnicalText.innerHTML = this.formatMarkdown(step.explanations.whatTechnical);\n713:     this.advSymbolsText.innerHTML = this.formatMarkdown(step.explanations.symbolsMeaning);\n714: \n715:     const varsDetail = (step.variables || [])\n716:       .map(\n717:         (v) =>\n718:           `• <code>${v.name}</code> → <code>${v.address || \"@0x1000\"}</code> (${v.type}): ${\n719:             v.previous\n720:           } → <strong>${v.current}</strong> [${v.status}]`\n721:       )\n722:       .join(\"<br>\");\n723:     this.advFullVarsText.innerHTML = varsDetail || \"No local variables.\";\n724: \n725:     this.renderFlowchartSVG(step);\n726:   }\n727: \n728:   renderFlowchartSVG(step) {\n729:     const cfg = this.traceResult.cfg;\n730:     if (!cfg || !cfg.nodes.length) return;\n731: \n732:     const nodeW = 185;\n733:     const nodeH = 30;\n734:     const vGap = 44;\n735:     const svgW = 320;\n736:     const svgH = Math.max(180, cfg.nodes.length * vGap + 30);\n737: \n738:     const positions = {};\n739:     cfg.nodes.forEach((n, idx) => {\n740:       positions[n.id] = { x: svgW / 2, y: 26 + idx * vGap };\n741:     });\n742: \n743:     let edgesSVG = \"\";\n744:     cfg.edges.forEach((edge) => {\n745:       const p1 = positions[edge.from];\n746:       const p2 = positions[edge.to];\n747:       if (!p1 || !p2) return;\n748:       const stroke = edge.isBackEdge ? \"#2563eb\" : \"#cbd5e1\";\n749:       if (edge.isBackEdge || p2.y <= p1.y) {\n750:         edgesSVG += `<path d=\"M ${p1.x - nodeW / 2} ${p1.y} C 22 ${p1.y}, 22 ${p2.y}, ${p2.x - nodeW / 2} ${p2.y}\" fill=\"none\" stroke=\"${stroke}\" stroke-width=\"1.5\" stroke-dasharray=\"4 2\" />`;\n751:       } else {\n752:         edgesSVG += `<line x1=\"${p1.x}\" y1=\"${p1.y + nodeH / 2}\" x2=\"${p2.x}\" y2=\"${p2.y - nodeH / 2}\" stroke=\"${stroke}\" stroke-width=\"1.5\" />`;\n753:       }\n754:     });\n755: \n756:     let nodesSVG = \"\";\n757:     cfg.nodes.forEach((node) => {\n758:       const pos = positions[node.id];\n759:       const isCurrent = node.line === step.line;\n760:       const fill = isCurrent ? \"#dbeafe\" : \"#ffffff\";\n761:       const stroke = isCurrent ? \"#2563eb\" : \"#cbd5e1\";\n762:       nodesSVG += `\n763:         <g transform=\"translate(${pos.x - nodeW / 2}, ${pos.y - nodeH / 2})\">\n764:           <rect width=\"${nodeW}\" height=\"${nodeH}\" rx=\"6\" fill=\"${fill}\" stroke=\"${stroke}\" stroke-width=\"${isCurrent ? 2 : 1.2}\" />\n765:           <text x=\"${nodeW / 2}\" y=\"${nodeH / 2 + 4}\" text-anchor=\"middle\" fill=\"#0f172a\" font-family=\"JetBrains Mono, monospace\" font-size=\"10\" font-weight=\"${isCurrent ? \"700\" : \"500\"}\">\n766:             ${this.escapeHTML(node.label)}\n767:           </text>\n768:         </g>\n769:       `;\n770:     });\n771: \n772:     this.flowchartSvgWrap.innerHTML = `<svg width=\"${svgW}\" height=\"${svgH}\" viewBox=\"0 0 ${svgW} ${svgH}\">${edgesSVG}${nodesSVG}</svg>`;\n773:   }\n774: \n775:   formatMarkdown(str) {\n776:     if (!str) return \"\";\n777:     return String(str)\n778:       .replace(/&/g, \"&amp;\")\n779:       .replace(/</g, \"&lt;\")\n780:       .replace(/>/g, \"&gt;\")\n781:       .replace(/&lt;br&gt;/g, \"<br>\")\n782:       .replace(/\\*\\*(.+?)\\*\\*/g, \"<strong>$1</strong>\")\n783:       .replace(/`([^`]+)`/g, \"<code>$1</code>\");\n784:   }\n785: \n786:   escapeHTML(str) {\n787:     return String(str)\n788:       .replace(/&/g, \"&amp;\")\n789:       .replace(/</g, \"&lt;\")\n790:       .replace(/>/g, \"&gt;\");\n791:   }\n792: }\n793: \n794: window.addEventListener(\"DOMContentLoaded\", () => {\n795:   window.teachMeApp = new TeachMeCodeApp();\n796: });\n797: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool