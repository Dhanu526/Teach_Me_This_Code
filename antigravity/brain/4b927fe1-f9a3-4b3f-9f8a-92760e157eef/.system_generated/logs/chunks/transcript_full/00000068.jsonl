ilestoneId: 1\r\n231:     },\r\n232:     {\r\n233:       phase: 2,\r\n234:       title: 'Phase 2: Sequential Pointers & Sliding Windows',\r\n235:       topics: ['Two Pointers', 'Sliding Window', 'Prefix Sum'],\r\n236:       description: 'Traverse sorted sequences with converging pointers and maintain dynamic or fixed contiguous windows.',\r\n237:       milestone: '3Sum (LC 15) & Longest Substring Without Repeating (LC 3)',\r\n238:       milestoneId: 31\r\n239:     },\r\n240:     {\r\n241:       phase: 3,\r\n242:       title: 'Phase 3: Linear State & Monotonic Data Structures',\r\n243:       topics: ['Stacks', 'Linked Lists', 'Queues and Deques', 'Monotonic Stack and Queue'],\r\n244:       description: 'Maintain LIFO state, monotonic stacks for next-greater-element, pointer redirection, and cycle detection.',\r\n245:       milestone: 'Valid Parentheses (LC 20) & Reverse Linked List (LC 206)',\r\n246:       milestoneId: 69\r\n247:     },\r\n248:     {\r\n249:       phase: 4,\r\n250:       title: 'Phase 4: Divide-and-Conquer & Space Pruning',\r\n251:       topics: ['Binary Search', 'Sorting'],\r\n252:       description: 'Achieve logarithmic O(log n) efficiency on sorted spaces, rotated arrays, and binary search on solution domains.',\r\n253:       milestone: 'Binary Search (LC 704) & Search in Rotated Array (LC 33)',\r\n254:       milestoneId: 89\r\n255:     },\r\n256:     {\r\n257:       phase: 5,\r\n258:       title: 'Phase 5: Hierarchical Structures & Priority Queues',\r\n259:       topics: ['Trees and Binary Trees', 'Binary Search Trees', 'Tries', 'Heaps and Priority Queues'],\r\n260:       description: 'Explore recursive tree traversals (DFS/BFS), binary search tree properties, prefix trees, and min/max heap scheduling.',\r\n261:       milestone: 'Maximum Depth of Binary Tree (LC 104) & Kth Largest Element (LC 215)',\r\n262:       milestoneId: 131\r\n263:     },\r\n264:     {\r\n265:       phase: 6,\r\n266:       title: 'Phase 6: Exhaustive Search & State-Space Ba