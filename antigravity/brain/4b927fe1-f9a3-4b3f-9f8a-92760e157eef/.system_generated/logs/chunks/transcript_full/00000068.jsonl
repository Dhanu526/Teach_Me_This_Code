{"step_index":2051,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-27T07:49:47Z","content":"Created At: 2026-10-27T13:19:47+05:30\nCompleted At: 2026-10-27T13:19:47+05:30\nFile Path: `file:///C:/Users/CVT/.gemini/antigravity/scratch/code-flow-visualizer/app_build/dsa_dashboard.js`\nTotal Lines: 2236\nTotal Bytes: 99142\nShowing lines 351 to 550\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n351: \r\n352:     saveProgress() {\r\n353:       try {\r\n354:         localStorage.setItem(STORAGE_KEY, JSON.stringify(this.progress));\r\n355:       } catch (e) {\r\n356:         console.warn('Could not save DSA progress to localStorage:', e);\r\n357:       }\r\n358:     }\r\n359: \r\n360:     getProblemStatus(id) {\r\n361:       if (this.progress.solved.includes(id)) return 'solved';\r\n362:       if (this.progress.attempted.includes(id)) return 'attempted';\r\n363:       return 'not_started';\r\n364:     }\r\n365: \r\n366:     isBookmarked(id) {\r\n367:       return this.progress.bookmarked.includes(id);\r\n368:     }\r\n369: \r\n370:     getNote(id) {\r\n371:       return (this.progress.notes && this.progress.notes[id]) || '';\r\n372:     }\r\n373: \r\n374:     hasNote(id) {\r\n375:       return Boolean(this.progress.notes && this.progress.notes[id] && this.progress.notes[id].trim().length > 0);\r\n376:     }\r\n377: \r\n378:     saveNote(id, noteText) {\r\n379:       if (!this.progress.notes) this.progress.notes = {};\r\n380:       const trimmed = String(noteText || '').trim();\r\n381:       if (trimmed) {\r\n382:         this.progress.notes[id] = trimmed;\r\n383:       } else {\r\n384:         delete this.progress.notes[id];\r\n385:       }\r\n386:       this.saveProgress();\r\n387:       this.renderProblemTableOnly();\r\n388:     }\r\n389: \r\n390:     toggleBookmark(id) {\r\n391:       const idx = this.progress.bookmarked.indexOf(id);\r\n392:       if (idx >= 0) {\r\n393:         this.progress.bookmarked.splice(idx, 1);\r\n394:       } else {\r\n395:         this.progress.bookmarked.push(id);\r\n396:       }\r\n397:       this.saveProgress();\r\n398:       this.render();\r\n399:     }\r\n400: \r\n401:     markAttempted(id) {\r\n402:       if (!this.progress.attempted.includes(id) && !this.progress.solved.includes(id)) {\r\n403:         this.progress.attempted.push(id);\r\n404:       }\r\n405:       this.progress.lastPracticedId = id;\r\n406:       this.addHistoryEntry(id, 'attempted');\r\n407:       this.saveProgress();\r\n408:       this.render();\r\n409:     }\r\n410: \r\n411:     markSolved(id) {\r\n412:       if (!this.progress.solved.includes(id)) {\r\n413:         this.progress.solved.push(id);\r\n414:       }\r\n415:       const attIdx = this.progress.attempted.indexOf(id);\r\n416:       if (attIdx >= 0) {\r\n417:         this.progress.attempted.splice(attIdx, 1);\r\n418:       }\r\n419:       this.progress.lastPracticedId = id;\r\n420:       this.addHistoryEntry(id, 'solved');\r\n421:       this.saveProgress();\r\n422:       this.render();\r\n423:       this.updateVisualizerActiveBanner();\r\n424:     }\r\n425: \r\n426:     toggleSolved(id) {\r\n427:       if (this.progress.solved.includes(id)) {\r\n428:         this.progress.solved = this.progress.solved.filter(x => x !== id);\r\n429:         if (!this.progress.attempted.includes(id)) {\r\n430:           this.progress.attempted.push(id);\r\n431:         }\r\n432:       } else {\r\n433:         this.markSolved(id);\r\n434:       }\r\n435:       this.saveProgress();\r\n436:       this.render();\r\n437:       this.updateVisualizerActiveBanner();\r\n438:     }\r\n439: \r\n440:     addHistoryEntry(id, action) {\r\n441:       const p = this.problemsById.get(id);\r\n442:       if (!p) return;\r\n443:       this.progress.history = this.progress.history.filter(h => h.problemId !== id);\r\n444:       this.progress.history.unshift({\r\n445:         problemId: id,\r\n446:         timestamp: Date.now(),\r\n447:         action: action\r\n448:       });\r\n449:       if (this.progress.history.length > 40) {\r\n450:         this.progress.history = this.progress.history.slice(0, 40);\r\n451:       }\r\n452:     }\r\n453: \r\n454:     // -------------------------------------------------------------------------\r\n455:     // COMPUTED STATS & METRICS\r\n456:     // -------------------------------------------------------------------------\r\n457:     computeStats() {\r\n458:       const total = this.problems.length;\r\n459:       const solvedCount = this.progress.solved.length;\r\n460:       const attemptedCount = this.progress.attempted.filter(id => !this.progress.solved.includes(id)).length;\r\n461:       const notStartedCount = Math.max(0, total - (solvedCount + attemptedCount));\r\n462:       const bookmarkedCount = this.progress.bookmarked.length;\r\n463:       const pctSolved = total > 0 ? ((solvedCount / total) * 100).toFixed(1) : '0.0';\r\n464: \r\n465:       const diffMap = {\r\n466:         Easy: { total: 0, solved: 0 },\r\n467:         Medium: { total: 0, solved: 0 },\r\n468:         Hard: { total: 0, solved: 0 }\r\n469:       };\r\n470:       this.problems.forEach(p => {\r\n471:         if (diffMap[p.difficulty]) {\r\n472:           diffMap[p.difficulty].total++;\r\n473:           if (this.progress.solved.includes(p.id)) {\r\n474:             diffMap[p.difficulty].solved++;\r\n475:           }\r\n476:         }\r\n477:       });\r\n478: \r\n479:       return {\r\n480:         total,\r\n481:         solvedCount,\r\n482:         attemptedCount,\r\n483:         notStartedCount,\r\n484:         bookmarkedCount,\r\n485:         pctSolved,\r\n486:         diffMap\r\n487:       };\r\n488:     }\r\n489: \r\n490:     computeTopicStats(topicName) {\r\n491:       const matchingProblems = this.problems.filter(p => {\r\n492:         return (p.topics && p.topics.includes(topicName)) || p.topic === topicName;\r\n493:       });\r\n494: \r\n495:       const total = matchingProblems.length;\r\n496:       let solved = 0;\r\n497:       let attempted = 0;\r\n498:       const diffMap = {\r\n499:         Easy: { total: 0, solved: 0 },\r\n500:         Medium: { total: 0, solved: 0 },\r\n501:         Hard: { total: 0, solved: 0 }\r\n502:       };\r\n503: \r\n504:       const patternSet = new Set();\r\n505: \r\n506:       matchingProblems.forEach(p => {\r\n507:         if (p.pattern) patternSet.add(p.pattern);\r\n508:         if (diffMap[p.difficulty]) {\r\n509:           diffMap[p.difficulty].total++;\r\n510:           if (this.progress.solved.includes(p.id)) {\r\n511:             diffMap[p.difficulty].solved++;\r\n512:           }\r\n513:         }\r\n514: \r\n515:         if (this.progress.solved.includes(p.id)) {\r\n516:           solved++;\r\n517:         } else if (this.progress.attempted.includes(p.id)) {\r\n518:           attempted++;\r\n519:         }\r\n520:       });\r\n521: \r\n522:       const notStarted = Math.max(0, total - (solved + attempted));\r\n523:       const pct = total > 0 ? (solved / total) * 100 : 0;\r\n524: \r\n525:       // Recommended next problem is the first unsolved problem in this topic\r\n526:       let recommendedProblem = matchingProblems.find(p => !this.progress.solved.includes(p.id));\r\n527:       if (!recommendedProblem && matchingProblems.length > 0) {\r\n528:         recommendedProblem = matchingProblems[0];\r\n529:       }\r\n530: \r\n531:       return {\r\n532:         name: topicName,\r\n533:         total,\r\n534:         solved,\r\n535:         attempted,\r\n536:         notStarted,\r\n537:         pct,\r\n538:         diffMap,\r\n539:         recommendedProblem,\r\n540:         patterns: Array.from(patternSet).sort()\r\n541:       };\r\n542:     }\r\n543: \r\n544:     getAllAlgorithmicPatterns() {\r\n545:       const patterns = new Set();\r\n546:       this.problems.forEach(p => {\r\n547:         if (p.pattern) patterns.add(p.pattern);\r\n548:       });\r\n549:       return Array.from(patterns).sort();\r\n550:     }\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
