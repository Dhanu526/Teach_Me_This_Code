 this.selectedTopic = 'all';\r\n303:       this.selectedDifficulty = 'all';\r\n304:       this.selectedPattern = 'all';\r\n305:       this.selectedStatus = 'all';\r\n306:       this.selectedSort = 'lc_asc';\r\n307:       this.currentPage = 1;\r\n308:       this.pageSize = 25;\r\n309: \r\n310:       // Topic Library filter state\r\n311:       this.topicSearchQuery = '';\r\n312:       this.selectedCategory = 'all';\r\n313: \r\n314:       this.activeVisualizerProblemId = null;\r\n315: \r\n316:       this.progress = this.loadProgress();\r\n317:       this.initDOM();\r\n318:       this.bindEvents();\r\n319:       this.render();\r\n320:     }\r\n321: \r\n322:     // -------------------------------------------------------------------------\r\n323:     // LOCAL STORAGE PROGRESS (Real Data Only — Zero Fake Numbers)\r\n324:     // -------------------------------------------------------------------------\r\n325:     loadProgress() {\r\n326:       try {\r\n327:         const raw = localStorage.getItem(STORAGE_KEY);\r\n328:         if (raw) {\r\n329:           const parsed = JSON.parse(raw);\r\n330:           return {\r\n331:             solved: Array.isArray(parsed.solved) ? parsed.solved : [],\r\n332:             attempted: Array.isArray(parsed.attempted) ? parsed.attempted : [],\r\n333:             bookmarked: Array.isArray(parsed.bookmarked) ? parsed.bookmarked : [],\r\n334:             history: Array.isArray(parsed.history) ? parsed.history : [],\r\n335:             notes: (parsed.notes && typeof parsed.notes === 'object') ? parsed.notes : {},\r\n336:             lastPracticedId: parsed.lastPracticedId || null\r\n337:           };\r\n338:         }\r\n339:       } catch (e) {\r\n340:         console.warn('Could not read DSA progress from localStorage:', e);\r\n341:       }\r\n342:       return {\r\n343:         solved: [],\r\n344:         attempted: [],\r\n345:         bookmarked: [],\r\n346:         history: [],\r\n347:         notes: {},\r\n348:         lastPracticedId: n