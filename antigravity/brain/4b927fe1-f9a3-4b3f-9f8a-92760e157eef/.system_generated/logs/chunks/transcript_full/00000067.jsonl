ogress.solved.includes(p.id);\n2013:       const isBookmarked = this.isBookmarked(p.id);\n2014:       const diffClass = p.difficulty.toLowerCase();\n2015: \n2016:       const existing = document.getElementById('dsaProblemModal');\n2017:       if (existing) existing.remove();\n2018: \n2019:       const topicChips = (p.topics && p.topics.length > 0 ? p.topics : [p.topic]).map(t => {\n2020:         return `<button class=\"mini-topic-chip\" data-open-topic=\"${this.escapeHTML(t)}\">📂 ${this.escapeHTML(t)}</button>`;\n2021:       }).join(' ');\n2022: \n2023:       const modal = document.createElement('div');\n2024:       modal.id = 'dsaProblemModal';\n2025:       modal.className = 'dsa-modal-backdrop';\n2026:       modal.innerHTML = `\n2027:         <div class=\"dsa-modal-card\">\n2028:           <div class=\"dsa-modal-header\">\n2029:             <div class=\"dsa-modal-title-row\">\n2030:               <span class=\"lc-badge\">LeetCode #${p.leetcodeNumber}</span>\n2031:               <h2 class=\"dsa-modal-title\">${this.escapeHTML(p.title)}</h2>\n2032:               <span class=\"diff-badge diff-${diffClass}\">${p.difficulty}</span>\n2033:             </div>\n2034:             <button class=\"dsa-modal-close-btn\" id=\"btnModalClose\">✕</button>\n2035:           </div>\n2036: \n2037:           <div class=\"dsa-modal-body\">\n2038:             <div class=\"dsa-modal-tags\">\n2039:               ${topicChips}\n2040:               <span class=\"pattern-tag\">🧩 Pattern: ${this.escapeHTML(p.pattern)}</span>\n2041:               <span class=\"complexity-tag\">⏱ Time: ${p.timeComplexity}</span>\n2042:               <span class=\"complexity-tag\">💾 Space: ${p.spaceComplexity}</span>\n2043:             </div>\n2044: \n2045:             <div class=\"dsa-modal-section\">\n2046:               <h4 class=\"dsa-section-label\">Problem Statement</h4>\n2047:               <p class=\"dsa-desc-text\">${this.escapeHTML(p.description)}</p>\n2048:             </div>\n2049: \n2050:             <div class=\"dsa-modal-section\">\n2051:               <h4 class=\"dsa-section-label\">Runnable Python Solution</h4>\n2052:               <pre class=\"dsa-code-preview\"><code>${this.escapeHTML(p.starterCode)}</code></pre>\n2053:             </div>\n2054:           </div>\n2055: \n2056:           <div class=\"dsa-modal-footer\">\n2057:             <div class=\"modal-footer-left\">\n2058:               <button class=\"btn-hero-star ${isBookmarked ? 'active' : ''}\" data-action=\"toggle-bookmark\" data-id=\"${p.id}\">\n2059:                 ${isBookmarked ? '⭐ Bookmarked' : '☆ Bookmark'}\n2060:               </button>\n2061:               <button class=\"status-toggle-btn ${isSolved ? 'solved' : 'not-started'}\" data-action=\"toggle-solved\" data-id=\"${p.id}\">\n2062:                 ${isSolved ? '✅ Solved' : '⚪ Mark as Solved'}\n2063:               </button>\n2064:             </div>\n2065:             <div class=\"modal-footer-right\">\n2066:               <button class=\"btn-hero-primary\" data-action=\"solve-visualize\" data-id=\"${p.id}\">\n2067:                 ▶ Load & Step in Visualizer\n2068:               </button>\n2069:             </div>\n2070:           </div>\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
