 const recentOrders = orders.slice(-3);\n        const prefix = orders.length > 3 ? `..` : \"\";\n        const orderLabel = prefix + recentOrders.map((n) => `#${n}`).join(\",\");\n        inlineBadgeHTML += `<span class=\"exec-order-pill ${isCurrent ? \"latest-step\" : \"\"}\" title=\"Executed on step(s): ${orders.join(\", \")}\">${orderLabel}</span>`;\n      }\n\n      if (isCurrent) {\n        if (changedVar) {\n          inlineBadgeHTML += `<span class=\"inline-pill\">${changedVar.name} = ${changedVar.formattedValue}</span>`;\n        } else if (step.branchResult !== null) {\n          const cls = step.branchResult ? \"branch-true\" : \"branch-false\";\n          inlineBadgeHTML += `<span class=\"inline-pill ${cls}\">${step.branchResult ? \"✓ True\" : \"✗ False\"}</span>`;\n        }\n      }\n\n      row.innerHTML = `\n        <div class=\"line-gutter\">\n          <span class=\"line-arrow\" style=\"color:${arrowColor}\">${arrowSymbol}</span>\n          <span class=\"line-num\">${lineNum}</span>\n        </div>\n        <div class=\"line-code\">${this.escapeHTML(rawLine)}</div>\n        <div class=\"line-inline-values\">${inlineBadgeHTML}</div>\n      `;\n\n      row.addEventListener(\"click\", () => {\n        const targetIdx = this.traceResult.steps.findIndex(\n          (s, sIdx) => s.line === lineNum && sIdx > 0\n        );\n        if (targetIdx !== -1) {\n          this.pause();\n          this.goToStep(targetIdx);\n        }\n      });\n\n      this.codeTraceView.appendChild(row);\n    });\n  }\n\n  renderConsoleOutput(step) {\n    this.consoleBody.innerHTML = \"\";\n    if (!step.stdout || step.stdout.length === 0) {\n      this.consoleBody.innerHTML = `<div class=\"empty-state\">No console output printed yet at Step ${step.stepIndex}.</div>`;\n      return;\n    }\n\n    step.stdout.forEach((item) => {\n      const lineDiv = document.createElement(\"div\");\n      lineDiv.className = \"console-line\";\n      if (item.stepIndex === step.stepIndex) {\n        lineDiv.classList.add(\"new-output\");\n      }\n      lineDiv.innerHTML = `\n        <span class=\"console-step-tag\">[Step ${item.stepIndex} | L${item.line}]</span>\n        <span>${this.escapeHTML(item.text)}</span>\n      `;\n      this.consoleBody.appendChild(lineDiv);\n    });\n    this.consoleBody.scrollTop = this.consoleBody.scrollHeight;\n  }\n\n  renderFlowchartSVG(step) {\n    const cfg = this.traceResult.cfg;\n    if (!cfg || !cfg.nodes.length) return;\n\n    const nodeW = 195;\n    const nodeH = 36;\n    const vGap = 54;\n    const svgW = 360;\n    const svgH = Math.max(250, cfg.nodes.length * vGap + 40);\n\n    const positions = {};\n    cfg.nodes.forEach((n, idx) => {\n      positions[n.id] = {\n        x: svgW / 2,\n        y: 28 + idx * vGap\n      };\n    });\n\n    const activeNodeId = step.eventType === \"PROGRAM_START\" ? \"start\" : `L${step.line}`;\n    const nextNodeId = step.nextLine ? `L${step.nextLine}` : \"end\";\n\n    let edgesSVG = \"\";\n    cfg.edges.forEach((edge) => {\n      const p1 = positions[edge.from];\n      const p2 = positions[edge.to];\n      if (!p1 || !p2) return;\n\n      const isTransition = edge.from === activeNodeId && edge.to === nextNodeId;\n      const stroke = isTransition ? \"#f59e0b\" : edge.isBackEdge ? \"#6366f1\" : \"#334155\";\n      const strokeWidth = isTransition ? 2.5 : 1.5;\n\n      if (edge.isBackEdge || p2.y <= p1.y) {\n        const curveX = 34;\n        edgesSVG += `<path d=\"M ${p1.x - nodeW / 2} ${p1.y} C ${curveX} ${p1.y}, ${curveX} ${p2.y}, ${p2.x - nodeW / 2} ${p2.y}\" fill=\"none\" stroke=\"${stroke}\" stroke-width=\"${strokeWidth}\" stroke-dasharray=\"4 3\" />`;\n      } else {\n        edgesSVG += `<line x1=\"${p1.x}\" y1=\"${p1.y + nodeH / 2}\" x2=\"${p2.x}\" y2=\"${p2.y - nodeH / 2}\" stroke=\"${stroke}\" stroke-width=\"${strokeWidth}\" />`;\n      }\n    });\n\n    let nodesSVG = \"\";\n    cfg.nodes.forEach((node) => {\n      const pos = positions[node.id];\n      const isCurrent =\n        (step.eventType === \"PROGRAM_START\" && node.id === \"start\") ||\n        (step.eventType !== \"PROGRAM_START\" && node.line === step.line);\n      const isNext = node.line === step.nextLine && !isCurrent;\n\n      let fill = \"#1e293b\";\n      let stroke = \"#334155\";\n      if (node.type === \"start\" || node.type === \"end\") {\n        fill = \"#0f172a\";\n        stroke = \"#475569\";\n      } else if (node.type === \"condition\" || node.type === \"loop\") {\n        fill = \"#1e1b4b\";\n        stroke = \"#6366f1\";\n      }\n\n      if (isCurrent) {\n        fill = \"#312e81\";\n        stroke = \"#818cf8\";\n      } else if (isNext) {\n        stroke = \"#f59e0b\";\n      }\n\n      const rx = node.type === \"start\" || node.type === \"end\" ? 18 : 7;\n      nodesSVG += `\n        <g transform=\"translate(${pos.x - nodeW / 2}, ${pos.y - nodeH / 2})\" style=\"cursor:pointer\" data-line=\"${node.line}\">\n          <rect width=\"${nodeW}\" height=\"${nodeH}\" rx=\"${rx}\" fill=\"${fill}\" stroke=\"${stroke}\" stroke-width=\"${isCurrent ? 2.5 : 1.5}\" />\n          <text x=\"${nodeW / 2}\" y=\"${nodeH / 2 + 4}\" text-anchor=\"middle\" fill=\"#f8fafc\" font-family=\"JetBrains Mono, monospace\" font-size=\"11\" font-weight=\"${isCurrent ? \"700\" : \"500\"}\">\n            ${this.escapeHTML(node.label)}\n          </text>\n        </g>\n      `;\n    });\n\n    this.flowSvgContainer.innerHTML = `\n      <svg width=\"${svgW}\" height=\"${svgH}\" viewBox=\"0 0 ${svgW} ${svgH}\">\n        ${edgesSVG}\n        ${nodesSVG}\n      </svg>\n    `;\n  }\n\n  renderMemoryScopes(step) {\n    this.memoryScroll.innerHTML = \"\";\n    const scopes = step.scopes || [];\n    this.frameCountBadge.textContent = `${scopes.length} Frame${scopes.length > 1 ? \"s\" : \"\"}`;\n\n    [...scopes].reverse().forEach((scope) => {\n      const card = document.createElement(\"div\");\n      card.className = \"scope-card\";\n\n      const header = document.createElement(\"div\");\n      header.className = `scope-header ${scope.isActive ? \"active-frame\" : \"\"}`;\n      header.innerHTML = `\n        <span>${this.escapeHTML(scope.frameName)}</span>\n        <span>${scope.isActive ? \"● ACTIVE SCOPE\" : \"CALLER\"}</span>\n      `;\n      card.appendChild(header);\n\n      const varList = document.createElement(\"div\");\n      varList.className = \"var-list\";\n\n      if (scope.variables.length === 0) {\n        varList.innerHTML = `<div class=\"empty-state\" style=\"padding:8px;\">No variables stored in this frame yet.</div>`;\n      } else {\n        const idxVar = scope.variables.find((v) =>\n          [\"i\", \"idx\", \"index\", \"k\"].includes(v.name) && typeof v.value === \"number\"\n        );\n        const activeIdxVal = idxVar ? idxVar.value : null;\n\n        scope.variables.forEach((v) => {\n          const item = document.createElement(\"div\");\n          item.className = \"var-item\";\n          if (v.status === \"updated\") item.classList.add(\"var-changed\");\n          if (v.status === \"new\") item.classList.add(\"var-new\");\n\n          let badgeHTML = \"\";\n          if (v.status === \"new\") {\n            badgeHTML = `<span class=\"var-badge-change new\">NEW</span>`;\n          } else if (v.status === \"updated\") {\n            badgeHTML = `<span class=\"var-badge-change updated\">UPDATED</span>`;\n          }\n\n          let valDiffHTML = `<span class=\"var-curr-val\">${this.escapeHTML(v.formattedValue)}</span>`;\n          if (v.status === \"updated\" && v.prevFormattedValue !== null) {\n            valDiffHTML = `\n              <span class=\"var-prev-val\">${this.escapeHTML(v.prevFormattedValue)}</span>\n              <span class=\"var-arrow\">→</span>\n              <span class=\"var-curr-val\">${this.escapeHTML(v.formattedValue)}</span>\n            `;\n          }\n\n          let arrayVisualizerHTML = \"\";\n          if (Array.isArray(v.value)) {\n            const cells = v.value\n              .map((cellVal, cIdx) => {\n                const isPointed = activeIdxVal === cIdx;\n                return `\n                  <div class=\"array-cell ${isPointed ? \"active-index\" : \"\"}\">\n                    <span class=\"array-cell-idx\">[${cIdx}]</span>\n                    <span class=\"array-cell-val\">${this.escapeHTML(String(cellVal))}</span>\n                  </div>\n                `;\n              })\n              .join(\"\");\n            arrayVisualizerHTML = `<div class=\"array-cells\">${cells}</div>`;\n          }\n\n          item.innerHTML = `\n            <div class=\"var-top-row\">\n              <div class=\"var-name-group\">\n                <span class=\"var-name\">${this.escapeHTML(v.name)}</span>\n                <span class=\"var-type\">${v.type}</span>\n              </div>\n              ${badgeHTML}\n            </div>\n            <div class=\"var-value-row\">\n              ${valDiffHTML}\n            </div>\n            ${arrayVisualizerHTML}\n          `;\n          varList.appendChild(item);\n        });\n      }\n\n      card.appendChild(varList);\n      this.memoryScroll.appendChild(card);\n    });\n  }\n\n  renderVariableTimeline() {\n    if (!this.traceResult) return;\n    const history = this.traceResult.variableTimeline || [];\n    const currentStepNumber = this.currentStepIdx + 1;\n\n    if (history.length === 0) {\n      this.historyScroll.innerHTML = `<div class=\"empty-state\">No variable calculations recorded.</div>`;\n      return;\n    }\n\n    let rowsHTML = \"\";\n    history.forEach((h) => {\n      const isCurrent = h.stepIndex === currentStepNumber;\n      const isFuture = h.stepIndex > currentStepNumber;\n      const changeStr =\n        h.status === \"new\"\n          ? `<span style=\"color:#22d3ee\">init → ${this.escapeHTML(h.newVal)}</span>`\n          : `<span style=\"color:#94a3b8\">${this.escapeHTML(h.prevVal)}</span> → <strong style=\"color:#34d399\">${this.escapeHTML(h.newVal)}</strong>`;\n\n      rowsHTML += `\n        <tr class=\"${isCurrent ? \"active-history-row\" : \"\"}\" style=\"${isFuture ? \"opacity:0.4;\" : \"\"}\" data-step=\"${h.stepIndex - 1}\">\n          <td>#${h.stepIndex} (L${h.line})</td>\n          <td><strong>${this.escapeHTML(h.varName)}</strong></td>\n          <td>${changeStr}</td>\n          <td>${this.escapeHTML(h.evalBreakdown)}</td>\n        </tr>\n      `;\n    });\n\n    this.historyScroll.innerHTML = `\n      <div style=\"font-size:12px; color:#94a3b8; margin-bottom:6px;\">\n        Full step-by-step calculation trail showing how every variable and final answer is computed (click any row to jump to that step):\n      </div>\n      <table class=\"timeline-table\">\n        <thead>\n          <tr>\n            <th>Step</th>\n            <th>Variable</th>\n            <th>Value Change</th>\n            <th>How It Was Calculated</th>\n          </tr>\n        </thead>\n        <tbody>${rowsHTML}</tbody>\n      </table>\n    `;\n\n    this.historyScroll.querySelectorAll(\"tbody tr\").forEach((tr) => {\n      tr.addEventListener(\"click\", () => {\n        const idx = Number(tr.dataset.step);\n        this.pause();\n        this.goToStep(idx);\n      });\n    });\n  }\n\n  renderMechanicsCard(step) {\n    this.mechanicsContainer.innerHTML = \"\";\n    this.mechanicsContainer.classList.add(\"hidden\");\n\n    // 1. Loop Internals Visualizer\n    if (step.loopMechanics) {\n      const lm = step.loopMechanics;\n      this.mechanicsContainer.classList.remove(\"hidden\");\n\n      if (lm.loopType === \"for\") {\n        const boxesHTML = lm.items\n          .map((itemVal, idx) => {\n            const isCurrent = idx === lm.currentIndex;\n            const isPast = idx < lm.currentIndex;\n            const ptrLabel = isCurrent\n              ? `▼ ${lm.iterVar}`\n              : isPast\n              ? \"✓\"\n              : `[${idx}]`;\n            return `\n              <div class=\"loop-item-box ${isCurrent ? \"current-item\" : \"\"} ${isPast ? \"past-item\" : \"\"}\">\n                <span class=\"loop-item-ptr\">${this.escapeHTML(ptrLabel)}</span>\n                <span class=\"loop-item-val\">${this.escapeHTML(itemVal)}</span>\n              </div>\n            `;\n          })\n          .join(\"\");\n\n        this.mechanicsContainer.innerHTML = `\n          <div class=\"mechanics-card loop-card\">\n            <div class=\"explanation-label\" style=\"color:#22d3ee;\">🔄 How This For-Loop Works Internally</div>\n            <div class=\"explanation-text\">\n              ${\n                lm.currentValue === \"DONE\"\n                  ? `All <strong>${lm.totalItems}</strong> items in <code>${this.escapeHTML(lm.iterExpr)}</code> have been visited! Loop exits.`\n                  : `Pass <strong>${lm.currentIndex + 1} of ${lm.totalItems}</strong>: Python points at index <code>[${lm.currentIndex}]</code> and unpacks <code>${this.escapeHTML(lm.iterVar)} = ${this.escapeHTML(lm.currentValue)}</code>:`\n              }\n            </div>\n            <div class=\"loop-strip\">${boxesHTML}</div>\n          </div>\n        `;\n      } else {\n        this.mechanicsContainer.innerHTML = `\n          <div class=\"mechanics-card loop-card\">\n            <div class=\"explanation-label\" style=\"color:#22d3ee;\">🔄 How This While-Loop Works Internally</div>\n            <div class=\"explanation-text\">\n              Check #<strong>${lm.iteration}</strong>: Before running the loop body, Python tests <code>${this.escapeHTML(lm.condition)}</code> (${this.escapeHTML(lm.substituted)}) → <strong>${lm.isContinuing ? \"True (Keep Looping)\" : \"False (Stop Loop)\"}</strong>.\n            </div>\n          </div>\n        `;\n      }\n      return;\n    }\n\n    // 2. Condition Truth Evaluator Visualizer\n    if (step.conditionMechanics) {\n      const cm = step.conditionMechanics;\n      this.mechanicsContainer.classList.remove(\"hidden\");\n      this.mechanicsContainer.innerHTML = `\n        <div class=\"mechanics-card cond-card\">\n          <div class=\"explanation-label\" style=\"color:#fbbf24;\">⚖️ How This Condition Evaluates to True or False</div>\n          <div class=\"cond-eval-grid\">\n            <div class=\"cond-operand\">\n              <span class=\"cond-expr-label\">Left: ${this.escapeHTML(cm.leftExpr)}</span>\n              <span class=\"cond-expr-val\">${this.escapeHTML(cm.leftVal)}</span>\n            </div>\n            <span class=\"cond-op-badge\">${this.escapeHTML(cm.operator)}</span>\n            <div class=\"cond-operand\">\n              <span class=\"cond-expr-label\">Right: ${this.escapeHTML(cm.rightExpr)}</span>\n              <span class=\"cond-expr-val\">${this.escapeHTML(cm.rightVal)}</span>\n            </div>\n            <span class=\"cond-verdict ${cm.result ? \"verdict-true\" : \"verdict-false\"}\">\n              ${cm.result ? \"✓ TRUE\" : \"✗ FALSE\"}\n            </span>\n          </div>\n        </div>\n      `;\n      return;\n    }\n\n    // 3. Function Call / Parameter / Return Visualizer\n    if (step.functionMechanics) {\n      const fm = step.functionMechanics;\n      this.mechanicsContainer.classList.remove(\"hidden\");\n\n      let extraHTML = \"\";\n      if (fm.type === \"CALL\" && fm.mappings) {\n        extraHTML = `\n          <div class=\"param-map-list\">\n            ${fm.mappings\n              .map(\n                (m) => `\n              <div class=\"param-map-row\">\n                <span>Caller Argument: <code>${this.escapeHTML(m.argExpr)}</code> (${this.escapeHTML(m.argVal)})</span>\n                <span style=\"color:#a855f7;\">➔</span>\n                <span>Function Parameter: <strong><code>${this.escapeHTML(m.paramName)} = ${this.escapeHTML(m.argVal)}</code></strong></span>\n              </div>\n            `\n              )\n              .join(\"\")}\n          </div>\n        `;\n      } else if (fm.type === \"RETURN\") {\n        extraHTML = `\n          <div class=\"param-map-row\">\n            <span>Return Expression: <code>${this.escapeHTML(fm.returnExpr)}</code></span>\n            <span style=\"color:#34d399;\">➔</span>\n            <span>Sends Back Value: <strong><code>${this.escapeHTML(fm.returnValue)}</code></strong></span>\n          </div>\n        `;\n      }\n\n      this.mechanicsContainer.innerHTML = `\n        <div class=\"mechanics-card func-card\">\n          <div class=\"explanation-label\" style=\"color:#d8b4fe;\">📦 How Functions, Parameters &amp; Return Work</div>\n          <div class=\"explanation-text\">${this.formatMarkdownCode(fm.note)}</div>\n          ${extraHTML}\n        </div>\n      `;\n    }\n  }\n\n  renderAITutorPanel(step) {\n    this.eventBadge.textContent = step.eventType.replace(\"_\", \" \");\n    this.stepLineBadge.textContent = `Line ${step.line} (Step ${step.stepIndex})`;\n    this.stepCodePreview.textContent = step.codeText;\n    this.evalBreakdownBox.textContent = step.evalBreakdown;\n\n    this.renderMechanicsCard(step);\n\n    const mainExplanation =\n      step.explanations[this.explanationDepth] || step.explanations.beginner;\n\n    this.whatHappenedText.innerHTML = this.formatMarkdownCode(mainExplanation);\n    this.howNextDecidedText.innerHTML = this.formatMarkdownCode(\n      step.explanations.howNextLineDecided || \"\"\n    );\n    this.whyHappenedText.innerHTML = this.formatMarkdownCode(\n      step.explanations.whyItHappened || \"\"\n    );\n    this.whatNextText.innerHTML = this.formatMarkdownCode(\n      step.explanations.whatNext || \"\"\n    );\n\n    if (this.quizModeEnabled && step.quiz) {\n      this.quizCard.classList.remove(\"hidden\");\n      this.quizQuestion.innerHTML = this.formatMarkdownCode(step.quiz.question);\n      this.quizOptions.innerHTML = \"\";\n      step.quiz.options.forEach((opt) => {\n        const btn = document.createElement(\"button\");\n        btn.className = \"quiz-option-btn\";\n        btn.textContent = opt.label;\n        btn.addEventListener(\"click\", () => {\n          btn.classList.add(opt.isCorrect ? \"correct\" : \"wrong\");\n          btn.textContent = `${opt.label} ${opt.isCorrect ? \"✓ Correct!\" : \"✗ Try again\"}`;\n        });\n        this.quizOptions.appendChild(btn);\n      });\n    } else {\n      this.quizCard.classList.add(\"hidden\");\n    }\n  }\n\n  handleAskAI() {\n    const q = this.chatInput.value.trim();\n    if (!q || !this.traceResult) return;\n\n    const step = this.traceResult.steps[this.currentStepIdx];\n    const activeScope = step.scopes[step.scopes.length - 1];\n    const varsSummary = activeScope.variables\n      .map((v) => `\\`${v.name} = ${v.formattedValue}\\``)\n      .join(\", \");\n\n    let answer = \"\";\n    const lower = q.toLowerCase();\n\n    if (lower.includes(\"final\") || lower.includes(\"calculate\") || lower.includes(\"answer\")) {\n      const historyCount = this.traceResult.variableTimeline.length;\n      const lastStep = this.traceResult.steps[this.traceResult.steps.length - 1];\n      const finalOut =\n        lastStep.stdout && lastStep.stdout.length\n          ? lastStep.stdout.map((o) => `\\`${o.text}\\``).join(\", \")\n          : \"see variables in memory\";\n      answer = `**How the Final Answer Gets Calculated:** Across ${this.traceResult.steps.length} steps and ${historyCount} variable updates, Python builds the final result (${finalOut}). Click the **\"How Final Answer is Calculated\"** tab in the center panel to inspect every intermediate calculation!`;\n    } else if (lower.includes(\"next\") || lower.includes(\"decide\") || lower.includes(\"order\")) {\n      answer = `**How Python Decides Which Line Runs Next:** ${step.explanations.howNextLineDecided} (${step.explanations.whatNext})`;\n    } else if (lower.includes(\"loop\") || lower.includes(\"condition\") || lower.includes(\"true\") || lower.includes(\"false\")) {\n      answer = `**Internal Mechanics on Line ${step.line}:** ${step.explanations.beginner} Evaluation breakdown: \\`${step.evalBreakdown}\\`.`;\n    } else if (lower.includes(\"function\") || lower.includes(\"parameter\") || lower.includes(\"return\") || lower.includes(\"argument\")) {\n      answer = `**Functions, Parameters & Return:** When a function is called, arguments from the caller are copied into the function's parameter variables in a new Call Stack frame. When \\`return\\` runs, that value is sent back to the caller line!`;\n    } else {\n      answer = `**Senior Dev Mentor (Step ${step.stepIndex}, Line ${step.line}):** ${step.explanations.eli5} Current evaluation: \\`${step.evalBreakdown}\\`. Variables in memory right now: ${varsSummary || \"none yet\"}.`;\n    }\n\n    this.aiAnswerBubble.innerHTML = this.formatMarkdownCode(answer);\n    this.aiAnswerBubble.classList.remove(\"hidden\");\n    this.chatInput.value = \"\";\n  }\n\n  formatMarkdownCode(str) {\n    if (!str) return \"\";\n    return this.escapeHTML(str)\n      .replace(/\\*\\*(.+?)\\*\\*/g, \"<strong>$1</strong>\")\n      .replace(/`([^`]+)`/g, \"<code>$1</code>\");\n  }\n\n  escapeHTML(str) {\n    return String(str)\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\");\n  }\n}\n\nwindow.addEventListener(\"DOMContentLoaded\", () => {\n  window.visualizerApp = new CodeFlowVisualizerApp();\n});\n","Description":"Upgrade app.js with Step 2 Patient Senior Developer Mentor visualizers and Variable Calculation Timeline","Overwrite":true,"TargetFile":"C:\\Users\\CVT\\.gemini\\antigravity\\scratch\\code-flow-visualizer\\app.js","toolAction":"Upgrading app.js with Step 2 mentor features","toolSummary":"Upgrade app.js with Step 2 mentor visualizers and timeline"}}]}
