ration: underline;\n}\n\n.breadcrumb-sep {\n  color: var(--text-muted);\n}\n\n.breadcrumb-current {\n  font-weight: 700;\n  color: var(--text-main);\n}\n\n.topic-detail-hero {\n  background: var(--bg-card);\n  border: 1px solid var(--border-light);\n  border-radius: var(--radius-lg);\n  padding: 28px;\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  box-shadow: 0 4px 16px rgba(0,0,0,0.03);\n  border-top: 4px solid var(--topic-accent, #2563eb);\n}\n\n.topic-hero-main {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.topic-hero-icon-title {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n.hero-topic-icon {\n  font-size: 36px;\n  line-height: 1;\n}\n\n.hero-topic-title {\n  font-size: 24px;\n  font-weight: 800;\n  color: var(--text-main);\n  letter-spacing: -0.5px;\n}\n\n.topic-detail-desc {\n  font-size: 14.5px;\n  color: var(--text-secondary);\n  line-height: 1.5;\n  max-width: 900px;\n}\n\n.topic-detail-meta-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n  gap: 12px;\n}\n\n.topic-meta-box {\n  background: var(--bg-subtle);\n  border: 1px solid var(--border-light);\n  border-radius: var(--radius-sm);\n  padding: 12px 14px;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.meta-box-val {\n  font-size: 22px;\n  font-weight: 800;\n  color: var(--text-main);\n  line-height: 1;\n}\n\n.meta-box-lbl {\n  font-size: 11.5px;\n  color: var(--text-muted);\n  font-weight: 600;\n}\n\n.val-green { color: #10b981; }\n.val-amber { color: #f59e0b; }\n.val-gray { color: #64748b; }\n\n.topic-detail-diff-card {\n  background: var(--bg-subtle);\n  border: 1px solid var(--border-light);\n  border-radius: var(--radius-sm);\n  padding: 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.diff-card-heading {\n  font-size: 13px;\n  font-weight: 700;\n  color: var(--text-secondary);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.topic-detail-diff-bars {\n  display: grid;\n  grid-template-columns: 1fr 1fr 1fr;\n  gap: 16px;\n}\n\n@media (max-width: 768px) {\n  .topic-detail-diff-bars {\n    grid-template-columns: 1fr;\n  }\n}\n\n.topic-diff-col {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.diff-label-row {\n  display: flex;\n  justify-content: space-between;\n  font-size: 12px;\n}\n\n/* Recommended Next Problem Card in Topic */\n.topic-recommended-card {\n  background: linear-gradient(135deg, #ffffff 0%, #f0fdf4 100%);\n  border: 1.5px solid #86efac;\n  border-radius: var(--radius-md);\n  padding: 20px 24px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  box-shadow: 0 2px 8px rgba(16, 185, 129, 0.08);\n}\n\n.rec-card-tag {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  color: #065f46;\n  background: #d1fae5;\n  padding: 3px 8px;\n  border-radius: 999px;\n  width: fit-content;\n}\n\n.rec-card-title-row {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n\n.rec-card-title {\n  font-size: 17px;\n  font-weight: 700;\n  color: var(--text-main);\n}\n\n.rec-card-badges {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.rec-card-desc {\n  font-size: 13.5px;\n  color: var(--text-secondary);\n  line-height: 1.45;\n  margin: 4px 0 8px;\n  max-width: 860px;\n}\n\n.rec-card-actions {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n/* Pattern Select Dropdown */\n.pattern-select {\n  max-width: 220px;\n}\n\n/* Multi-Topic Chips in Table */\n.col-topics-multi {\n  min-width: 160px;\n}\n\n.multi-topics-wrap {\n  display: flex;\n  gap: 4px;\n  flex-wrap: wrap;\n  align-items: center;\n}\n\n.mini-topic-chip {\n  background: var(--bg-subtle);\n  border: 1px solid var(--border-light);\n  color: var(--text-secondary);\n  font-size: 11px;\n  font-weight: 600;\n  padding: 2px 6px;\n  border-radius: 4px;\n  cursor: pointer;\n  transition: all 0.15s;\n}\n\n.mini-topic-chip:hover {\n  background: var(--primary-blue-soft);\n  color: var(--primary-blue);\n  border-color: var(--primary-blue-border);\n}\n\n.more-topics-tag {\n  font-size: 10px;\n  font-weight: 700;\n  color: var(--text-muted);\n  background: #f1f5f9;\n  padding: 2px 5px;\n  border-radius: 4px;\n}\n\n.topic-highlight-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border-light);\n  border-radius: var(--radius-md);\n  padding: 16px 18px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.topic-highlight-card:hover {\n  border-color: var(--primary-blue);\n  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);\n  transform: translateY(-2px);\n}\n\"\"\"\n\nwith open(css_path, \"r\", encoding=\"utf-8\") as f:\n    existing_css = f.read()\n\nnew_css = existing_css + \"\\n\" + phase2_css\n\nwith open(tmp_path, \"w\", encoding=\"utf-8\") as f:\n    f.write(new_css)\n\nos.replace(tmp_path, css_path)\nprint(\"Successfully appended Phase 2 styles to styles.css!\")\n","Description":"Append Phase 2 styles to styles.css","Overwrite":true,"TargetFile":"C:\\Users\\CVT\\.gemini\\antigravity\\brain\\4b927fe1-f9a3-4b3f-9f8a-92760e157eef\\scratch\\append_phase2_styles.py","toolAction":"Writing append_phase2_styles.py","toolSummary":"Create append_phase2_styles.py"}}]}
