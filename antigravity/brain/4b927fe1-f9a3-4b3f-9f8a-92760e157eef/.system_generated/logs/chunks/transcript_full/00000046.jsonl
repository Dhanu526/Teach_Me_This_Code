st row = document.createElement(\"div\");\n775:       row.className = `code-row ${isCurrent ? \"is-current-line\" : \"is-dimmed\"}`;\n776:       if (isCurrent) {\n777:         activeRowEl = row;\n778:       }\n779: \n780:       row.innerHTML = `\n781:         <div class=\"code-gutter\">${lineNum}</div>\n782:         <div class=\"code-syntax\">${this.highlightPythonSyntax(rawLine)}${branchBadge}</div>\n783:       `;\n784: \n785:       row.addEventListener(\"click\", () => {\n786:         const targetIdx = this.traceResult.steps.findIndex((s) => s.line === lineNum);\n787:         if (targetIdx !== -1) {\n788:           this.stopAutoPlay();\n789:           this.goToStep(targetIdx, 0);\n790:         }\n791:       });\n792: \n793:       this.codeLinesContainer.appendChild(row);\n794:     });\n795: \n796:     // Keep the active line centered inside the scrollable code box on mobile/tablet\n797:     if (activeRowEl && this.codeLinesContainer.scrollHeight > this.codeLinesContainer.clientHeight) {\n798:       const container = this.codeLinesContainer;\n799:       const targetTop =\n800:         activeRowEl.offsetTop - container.offsetTop - container.clientHeight / 2 + activeRowEl.clientHeight / 2;\n801:       container.scrollTo({ top: Math.max(0, targetTop), behavior: \"smooth\" });\n802:     }\n803:   }\n804: \n805:   highlightPythonSyntax(line) {\n806:     if (!line) return \" \";\n807:     let commentPart = \"\";\n808:     let codePart = line;\n809:     const hashIdx = line.indexOf(\"#\");\n810:     if (hashIdx !== -1) {\n811:       codePart = line.slice(0, hashIdx);\n812:       commentPart = `<span class=\"syn-com\">${this.escapeHTML(line.slice(hashIdx))}</span>`;\n813:     }\n814: \n815:     const tokenRegex = /(\".*?\"|'.*?'|\\b(?:class|def|return|if|elif|else|for|while|in|break|continue|and|or|not|True|False|None|self)\\b|\\b(?:print|range|len|min|max|abs|sum|list|int|float|str|bool|round|enumerate|sorted|reversed|set|dict)\\b|\\b\\d+(?:\\.\\d+)?\\b)/g;\nThe above con