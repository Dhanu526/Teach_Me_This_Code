yle=\"font-size:12px; color:var(--text-secondary);\">${this.escapeHTML(branch2Desc)}</span>\n1060:         </div>\n1061:       </div>\n1062:     `;\n1063:   }\n1064: \n1065:   /* PHASE 2: Animate number moving into variable & show arithmetic calculation step by step */\n1066:   renderVisualCalcStage(step, currentSubstep) {\n1067:     if (!this.visualCalcStage) return;\n1068:     const op = step.operationDetail || {};\n1069:     const isAug = step.eventType === \"AUG_ASSIGN\";\n1070:     const isAssign = step.eventType === \"ASSIGN\";\n1071: \n1072:     if (!isAug && !isAssign) {\n1073:       this.visualCalcStage.classList.add(\"hidden\");\n1074:       this.visualCalcStage.innerHTML = \"\";\n1075:       return;\n1076:     }\n1077: \n1078:     this.visualCalcStage.classList.remove(\"hidden\");\n1079:     const target = op.target || \"c\";\n1080:     const beforeVal = op.beforeVal !== undefined ? op.beforeVal : \"0\";\n1081:     const afterVal = op.afterVal !== undefined ? op.afterVal : op.rhsVal || \"0\";\n1082:     const rhsVal = op.rhsVal !== undefined ? op.rhsVal : afterVal;\n1083:     const isCreated = Boolean(op.isCreated);\n1084:     const useBeforeVars = Boolean(currentSubstep && currentSubstep.varsBeforeStep);\n1085: \n1086:     let stageHTML = \"\";\n1087: \n1088:     if (isAug) {\n1089:       stageHTML = `\n1090:         <div class=\"calc-stage-header\">\n1091:           <span>Step-by-Step Arithmetic Calculation</span>\n1092:           <span class=\"calc-stage-badge\">Addition</span>\n1093:         </div>\n1094:         <div class=\"calc-equation-row\">\n1095:           <div class=\"calc-operand-chip\" title=\"Previous value of ${target}\">\n1096:             <span style=\"font-size:10px; display:block; color:var(--text-muted);\">${target}</span>\n1097:             <span>${beforeVal}</span>\n1098:           </div>\n1099:           <span class=\"calc-operator-chip\">+</span>\n1100:           <div class=\"calc-operand-chip\" title=\"List element at current ind