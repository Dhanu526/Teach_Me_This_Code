\r\n658: \r\n659:       if (this.dsaContainer) {\r\n660:         this.dsaContainer.addEventListener('click', (e) => {\r\n661:           // Tab switcher buttons\r\n662:           const tabBtn = e.target.closest('[data-dsa-tab]');\r\n663:           if (tabBtn) {\r\n664:             this.currentSubTab = tabBtn.getAttribute('data-dsa-tab');\r\n665:             this.render();\r\n666:             return;\r\n667:           }\r\n668: \r\n669:           // Open Dedicated Topic Page\r\n670:           const openTopicBtn = e.target.closest('[data-open-topic]');\r\n671:           if (openTopicBtn) {\r\n672:             const topic = openTopicBtn.getAttribute('data-open-topic');\r\n673:             this.openTopicDetailPage(topic);\r\n674:             return;\r\n675:           }\r\n676: \r\n677:           // Bookmark button\r\n678:           const bookmarkBtn = e.target.closest('[data-action=\"toggle-bookmark\"]');\r\n679:           if (bookmarkBtn) {\r\n680:             const id = parseInt(bookmarkBtn.getAttribute('data-id'), 10);\r\n681:             if (!isNaN(id)) this.toggleBookmark(id);\r\n682:             return;\r\n683:           }\r\n684: \r\n685:           // Review button (Phase 4)\r\n686:           const reviewBtn = e.target.closest('[data-action=\"toggle-review\"]');\r\n687:           if (reviewBtn) {\r\n688:             const id = parseInt(reviewBtn.getAttribute('data-id'), 10);\r\n689:             if (!isNaN(id)) this.toggleReview(id);\r\n690:             return;\r\n691:           }\r\n692: \r\n693:           // Bookmark only quick filter pill (Phase 4)\r\n694:           const bmFilterBtn = e.target.closest('[data-filter-bookmark-toggle]');\r\n695:           if (bmFilterBtn) {\r\n696:             this.onlyBookmarked = !this.onlyBookmarked;\r\n697:             this.currentPage = 1;\r\n698:             this.renderProblemTableOnly();\r\n699:             bmFilterBtn.classList.toggle('active', this.onlyBookmarked);\r\n700:             return;\r\n701:           }\r\n702: \r\n703:           // Import modal button (Phase 4)\r\n704:           const importBtn = e.target.closest('[data-action=\"open-import-modal\"]');\r\n705:           if (importBtn) {\r\n706:             this.showImportModal();\r\n707:             return;\r\n708:           }\r\n709: \r\n710:           // Metric card quick jumps\r\n711:           const metricReview = e.target.closest('[data-metric-action=\"filter-review\"]');\r\n712:           if (metricReview) {\r\n713:             this.currentSubTab = 'problems';\r\n714:             this.selectedStatus = 'review';\r\n715:             this.currentPage = 1;\r\n716:             this.render();\r\n717:             return;\r\n718:           }\r\n719:           const metricBookmarked = e.target.closest('[data-metric-action=\"filter-bookmarked\"]');\r\n720:           if (metricBookmarked) {\r\n721:             this.currentSubTab = 'problems';\r\n722:             this.selectedStatus = 'bookmarked';\r\n723:             this.currentPage = 1;\r\n724:             this.render();\r\n725:             return;\r\n726:           }\r\n727: \r\n728:           // Toggle Solved button\r\n729:           const toggleSolvedBtn = e.target.closest('[data-action=\"toggle-solved\"]');\r\n730:           if (toggleSolvedBtn) {\r\n731:             const id = parseInt(toggleSolvedBtn.getAttribute('data-id'), 10);\r\n732:             if (!isNaN(id)) this.toggleSolved(id);\r\n733:             return;\r\n734:           }\r\n735: \r\n736:           // Solve & Visualize button\r\n737:           const solveBtn = e.target.closest('[data-action=\"solve-visualize\"]');\r\n738:           if (solveBtn) {\r\n739:             const id = parseInt(solveBtn.getAttribute('data-id'), 10);\r\n740:             if (!isNaN(id)) this.loadAndVisualizeProblem(id);\r\n741:             return;\r\n742:           }\r\n743: \r\n744:           // Explore Roadmap Phase\r\n745:           const roadmapBtn = e.target.closest('[data-action=\"explore-phase\"]');\r\n746:           if (roadmapBtn) {\r\n747:             const phaseNum = parseInt(roadmapBtn.getAttribute('data-phase'), 10);\r\n748:             const phase = ROADMAP_PHASES.find(p => p.phase === phaseNum);\r\n749:             if (phase && phase.topics.length > 0) {\r\n750:               this.openTopicDetailPage(phase.topics[0]);\r\n751:             }\r\n752:             return;\r\n753:           }\r\n754: \r\n755:           // Status filter chips\r\n756:           const statusChip = e.target.closest('[data-filter-status]');\r\n757:           if (statusChip) {\r\n758:             this.selectedStatus = statusChip.getAttribute('data-filter-status');\r\n759:             this.currentPage = 1;\r\n760:             this.renderProblemTableOnly();\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
