\n  border: 1px solid #93c5fd;\n  animation: popIn calc(0.3s * var(--anim-speed-factor, 1)) ease;\n}\n\n.var-status-badge.is-updated {\n  background: #d1fae5;\n  color: #047857;\n  border: 1px solid #6ee7b7;\n  animation: popIn calc(0.3s * var(--anim-speed-factor, 1)) ease;\n}\n\n.var-status-badge.is-negative {\n  background: #fee2e2;\n  color: #b91c1c;\n  border: 1px solid #fca5a5;\n  animation: shake calc(0.5s * var(--anim-speed-factor, 1)) ease;\n}\n\n.var-box-val-slot {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 4px;\n  background: var(--bg-subtle);\n  border: 1px solid var(--border-light);\n  border-radius: 5px;\n  padding: 2px 6px;\n  min-height: 26px;\n}\n\n.var-box-value {\n  font-family: var(--font-mono);\n  font-size: 14px;\n  font-weight: 800;\n  color: var(--text-main);\n  animation: numPopIn calc(0.35s * var(--anim-speed-factor, 1)) cubic-bezier(0.175, 0.885, 0.32, 1.275);\n}\n\n.var-box-prev {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--text-muted);\n  white-space: nowrap;\n}\n\n.var-box-card.is-created {\n  border-color: #3b82f6;\n  background: #eff6ff;\n  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);\n  animation: varCreatedGlow calc(0.6s * var(--anim-speed-factor, 1)) ease;\n}\n\n.var-box-card.is-updated {\n  border-color: #10b981;\n  background: #ecfdf5;\n  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);\n  animation: varUpdatedGlow calc(0.6s * var(--anim-speed-factor, 1)) ease;\n}\n\n.var-box-card.is-negative-warning {\n  border-color: #f43f5e;\n  background: #fff1f2;\n  box-shadow: 0 0 0 3px rgba(244, 63, 94, 0.2);\n}\n\n.var-box-card.is-negative-warning .var-box-value {\n  color: #be123c;\n}\n\n/* 2. Number Moving Into Variable Stage (Phase 2) */\n.visual-calc-stage {\n  background: #f8fafc;\n  border: 1.5px solid #cbd5e1;\n  border-radius: var(--radius-md);\n  padding: 8px 12px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.calc-stage-header {\n  display: f