n    </section>\n\n    <!-- AREA 3: SCOPE ISOLATION & STACK/HEAP MEMORY VISUALIZER (RIGHT) -->\n    <section class=\"area-card area-variables\" aria-label=\"Scopes and Memory Reference Model\">\n      <div class=\"area-header-row\">\n        <h2 class=\"area-heading\">Scopes & Memory Model</h2>\n        <span class=\"ref-legend-pill\" title=\"Python variables store memory addresses pointing to Heap objects\">Name → @Addr → Value</span>\n      </div>\n\n      <!-- TASK 4.1 & 4.2: ISOLATED STACK SCOPES (GLOBAL vs. LOCAL) -->\n      <div class=\"memory-section-block\">\n        <div class=\"memory-section-title\">1. Stack Frames (Global vs. Local Scope Isolation)</div>\n        <div id=\"scopeFramesContainer\" class=\"scope-frames-container\"></div>\n      </div>\n\n      <!-- TASK 3.1, 3.2 & 3.3: HEAP MEMORY OBJECTS + VISUAL GARBAGE COLLECTION -->\n      <div class=\"memory-section-block\">\n        <div class=\"heap-header-row\">\n          <span class=\"memory-section-title\">2. Heap Memory (@Address → Object Value)</span>\n          <button id=\"btnToggleGC\" class=\"btn-gc-toggle\" title=\"Toggle unreferenced / garbage-collected objects from earlier loop steps\">\n            Show GC'd (0)\n          </button>\n        </div>\n        <div id=\"heapObjectsContainer\" class=\"heap-objects-container\"></div>\n      </div>\n\n      <!-- Clean Visual List Box for `nums` / `arr` / `s.items` -->\n      <div id=\"visualListsContainer\" class=\"visual-list-wrap\"></div>\n\n      <!-- Live Console Output (`print`) when program prints values -->\n      <div id=\"stdoutSection\" class=\"memory-section-block hidden\">\n        <div class=\"memory-section-title\">3. Console Output (print)</div>\n        <pre id=\"stdoutBox\" class=\"stdout-box\"></pre>\n      </div>\n    </section>\n\n  </main>\n\n  <!-- =========================================================\n       OPTIONAL ADVANCED VIEW DRAWER (Hidden by Default)\n       ========================================================= -->\n  <section id=\"advancedViewPanel\" class=\"advanced-drawer hidden\" aria-label=\"Advanced Debugging View\">\n    <div class=\"advanced-header\">\n      <strong>Advanced Debugging Details</strong>\n      <span id=\"advMetadataLabel\" class=\"adv-meta\"></span>\n    </div>\n    <div class=\"advanced-grid\">\n      <div class=\"adv-box\">\n        <div class=\"adv-title\">Technical Explanation</div>\n        <div id=\"advTechnicalText\" class=\"adv-body\"></div>\n      </div>\n      <div class=\"adv-box\">\n        <div class=\"adv-title\">Python Symbols on This Line</div>\n        <div id=\"advSymbolsText\" class=\"adv-body\"></div>\n      </div>\n      <div class=\"adv-box\">\n        <div class=\"adv-title\">Variables Before → After (With Addresses & Types)</div>\n        <div id=\"advFullVarsText\" class=\"adv-body\"></div>\n      </div>\n      <div class=\"adv-box\">\n        <div class=\"adv-title\">Execution Flowchart</div>\n        <div id=\"flowchartSvgWrap\" class=\"adv-flowchart\"></div>\n      </div>\n    </div>\n  </section>\n\n  <script src=\"engine.js\"></script>\n  <script src=\"explainer.js\"></script>\n  <script src=\"app.js\"></script>\n</body>\n</html>\n","Description":"Simplify app_build/index.html by removing the cluttered preset/input drawer and adding direct Paste/Edit Code + Console Output box","Overwrite":true,"TargetFile":"C:\\Users\\CVT\\.gemini\\antigravity\\scratch\\code-flow-visualizer\\app_build\\index.html","toolAction":"Updating app_build/index.html","toolSummary":"Update app_build/index.html"}}]}
