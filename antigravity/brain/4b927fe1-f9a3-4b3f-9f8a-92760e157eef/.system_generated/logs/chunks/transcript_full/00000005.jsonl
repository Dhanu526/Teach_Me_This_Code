padding: 4px 8px;\n  font-family: var(--font-mono);\n  font-size: 12px;\n  outline: none;\n}\n\n.playground-input:focus {\n  border-color: var(--accent-blue);\n}\n\n.btn-chip {\n  padding: 3px 8px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--border-subtle);\n  background: var(--bg-panel);\n  color: var(--text-secondary);\n  font-size: 11px;\n  font-family: var(--font-mono);\n  cursor: pointer;\n}\n\n.btn-chip:hover {\n  color: var(--text-primary);\n  border-color: var(--accent-blue);\n}\n\n/* Validation Banner */\n.validation-banner {\n  background: rgba(248, 81, 73, 0.15);\n  border-bottom: 1px solid var(--accent-red);\n  color: #ffa198;\n  padding: 8px 12px;\n  font-size: 12px;\n  font-family: var(--font-mono);\n}\n\n/* Algorithm Purpose Banner */\n.purpose-banner {\n  background: rgba(88, 166, 255, 0.08);\n  border: 1px solid rgba(88, 166, 255, 0.25);\n  border-radius: var(--radius-sm);\n  padding: 8px 10px;\n  font-size: 12px;\n  line-height: 1.45;\n  color: var(--text-primary);\n}\n\n.purpose-banner code {\n  font-family: var(--font-mono);\n  color: var(--accent-cyan);\n  background: var(--bg-elevated);\n  padding: 1px 4px;\n  border-radius: 3px;\n}\n\n/* Practice Mode Card */\n.practice-card {\n  background: rgba(188, 140, 255, 0.1);\n  border: 1px solid rgba(188, 140, 255, 0.4);\n  border-radius: var(--radius-md);\n  padding: 10px 12px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.practice-options {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.practice-opt-btn {\n  padding: 5px 10px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--border-subtle);\n  background: var(--bg-input);\n  color: var(--text-primary);\n  font-family: var(--font-mono);\n  font-size: 12px;\n  cursor: pointer;\n}\n\n.practice-opt-btn.correct {\n  border-color: var(--accent-green);\n  background: rgba(63, 185, 80, 0.2);\n  color: #7ee787;\n}\n\n.practice-opt-btn.wrong {\n  border-color: var(--accent-red);\n  background: rgba(248, 81, 73, 0.2);\n  color: #ffa198;\n}\n\n/* Visual List Array Strip */\n.list-strip-card {\n  background: var(--bg-input);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-sm);\n  padding: 8px 10px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.list-cells-row {\n  display: flex;\n  gap: 4px;\n  flex-wrap: wrap;\n}\n\n.list-cell {\n  background: var(--bg-elevated);\n  border: 1px solid var(--border-subtle);\n  border-radius: 4px;\n  min-width: 34px;\n  padding: 3px 5px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  font-family: var(--font-mono);\n}\n\n.list-cell.active-idx {\n  border-color: var(--accent-amber);\n  background: rgba(210, 153, 34, 0.2);\n}\n\n.list-cell-i {\n  font-size: 9.5px;\n  color: var(--text-muted);\n}\n\n.list-cell-v {\n  font-size: 12px;\n  font-weight: 700;\n  color: var(--text-primary);\n}\n\n/* Variable History Box */\n.var-history-box {\n  background: var(--bg-input);\n  border: 1px solid var(--accent-cyan);\n  border-radius: var(--radius-sm);\n  padding: 8px 10px;\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n/* Built-In Code Questions Section */\n.questions-section {\n  margin-top: auto;\n  border-top: 1px solid var(--border-subtle);\n  padding-top: 8px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.question-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px;\n}\n\n.q-chip {\n  padding: 4px 8px;\n  font-size: 11px;\n  border-radius: var(--radius-sm);\n  background: var(--bg-elevated);\n  border: 1px solid var(--border-subtle);\n  color: var(--text-secondary);\n  cursor: pointer;\n}\n\n.q-chip:hover,\n.q-chip.active {\n  color: var(--text-primary);\n  border-color: var(--accent-blue);\n  background: rgba(88, 166, 255, 0.14);\n}\n\n.question-answer-box {\n  background: var(--bg-input);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-sm);\n  padding: 8px 10px;\n  font-size: 12px;\n  line-height: 1.5;\n  color: var(--text-primary);\n  min-height: 54px;\n}\n\n.question-answer-box code {\n  font-family: var(--font-mono);\n  color: var(--accent-cyan);\n}\n\n/* 7-Card Beginner Explanation Grid */\n.explanation-cards-grid-7 {\n  flex: 1;\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  gap: 8px;\n  padding: 8px 12px;\n  overflow-y: auto;\n}\n","Description":"Append CSS styles for Input Playground, Validation Banner, Built-In Questions, Practice Mode, and 7-card Explanation Panel","Overwrite":false,"TargetFile":"C:\\Users\\CVT\\.gemini\\antigravity\\scratch\\code-flow-visualizer\\styles.css","toolAction":"Appending styles for Input Playground and Questions","toolSummary":"Append Input Playground and Built-In Questions styles to styles.css"}}]}
