6\" fill=\"${fill}\" stroke=\"${stroke}\" stroke-width=\"${isCurrent ? 2 : 1.2}\" />\n1622:           <text x=\"${nodeW / 2}\" y=\"${nodeH / 2 + 4}\" text-anchor=\"middle\" fill=\"#0f172a\" font-family=\"JetBrains Mono, monospace\" font-size=\"10\" font-weight=\"${isCurrent ? \"700\" : \"500\"}\">\n1623:             ${this.escapeHTML(node.label)}\n1624:           </text>\n1625:         </g>\n1626:       `;\n1627:     });\n1628: \n1629:     this.flowchartSvgWrap.innerHTML = `<svg width=\"${svgW}\" height=\"${svgH}\" viewBox=\"0 0 ${svgW} ${svgH}\">${edgesSVG}${nodesSVG}</svg>`;\n1630:   }\n1631: \n1632:   formatMarkdown(str) {\n1633:     if (!str) return \"\";\n1634:     return String(str)\n1635:       .replace(/&/g, \"&amp;\")\n1636:       .replace(/</g, \"&lt;\")\n1637:       .replace(/>/g, \"&gt;\")\n1638:       .replace(/&lt;br&gt;/g, \"<br>\")\n1639:       .replace(/\\*\\*(.+?)\\*\\*/g, \"<strong>$1</strong>\")\n1640:       .replace(/`([^`]+)`/g, \"<code>$1</code>\");\n1641:   }\n1642: \n1643:   escapeHTML(str) {\n1644:     return String(str)\n1645:       .replace(/&/g, \"&amp;\")\n1646:       .replace(/</g, \"&lt;\")\n1647:       .replace(/>/g, \"&gt;\");\n1648:   }\n1649: }\n1650: \n1651: window.addEventListener(\"DOMContentLoaded\", () => {\n1652:   window.teachMeApp = new TeachMeCodeApp();\n1653: });\n1654: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
