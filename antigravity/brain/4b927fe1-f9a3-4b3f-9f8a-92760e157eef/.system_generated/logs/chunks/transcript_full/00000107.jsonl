highlightPythonSyntax(rawLine)}${branchBadge}</div>\n847:       `;\n848: \n849:       row.addEventListener(\"click\", () => {\n850:         const targetIdx = this.traceResult.steps.findIndex((s) => s.line === lineNum);\n851:         if (targetIdx !== -1) {\n852:           this.stopAutoPlay();\n853:           this.goToStep(targetIdx, 0);\n854:         }\n855:       });\n856: \n857:       this.codeLinesContainer.appendChild(row);\n858:     });\n859: \n860:     // Keep the active line centered inside the scrollable code box on mobile/tablet\n861:     if (activeRowEl && this.codeLinesContainer.scrollHeight > this.codeLinesContainer.clientHeight) {\n862:       const container = this.codeLinesContainer;\n863:       const targetTop =\n864:         activeRowEl.offsetTop - container.offsetTop - container.clientHeight / 2 + activeRowEl.clientHeight / 2;\n865:       container.scrollTo({ top: Math.max(0, targetTop), behavior: \"smooth\" });\n866:     }\n867:   }\n868: \n869:   highlightPythonSyntax(line) {\n870:     if (!line) return \" \";\n871:     let commentPart = \"\";\n872:     let codePart = line;\n873:     const hashIdx = line.indexOf(\"#\");\n874:     if (hashIdx !== -1) {\n875:       codePart = line.slice(0, hashIdx);\n876:       commentPart = `<span class=\"syn-com\">${this.escapeHTML(line.slice(hashIdx))}</span>`;\n877:     }\n878: \n879:     const tokenRegex = /(\".*?\"|'.*?'|\\b(?:class|def|return|if|elif|else|for|while|in|break|continue|and|or|not|True|False|None|self)\\b|\\b(?:print|range|len|min|max|abs|sum|list|int|float|str|bool|round|enumerate|sorted|reversed|set|dict)\\b|\\b\\d+(?:\\.\\d+)?\\b)/g;\n880:     const highlighted = this.escapeHTML(codePart).replace(tokenRegex, (match) => {\n881:       if (match.startsWith('\"') || match.startsWith(\"'\")) {\n882:         return `<span class=\"syn-str\">${match}</span>`;\n883:       }\n884:       if (/^(class|def|return|if|elif|else|for|while|in|break|continue|and|or|not|True|False|None|self)$/.test(match)) {\n88