tStep.scopes.global.find(v => v.name === '__test_result__');\n34:     if (varObj) resultVal = varObj.rawValue;\n35:   }\n36: \n37:   let printedLines = lastStep.stdout || [];\n38:   return {\n39:     ok: true,\n40:     result: resultVal,\n41:     stdout: printedLines,\n42:     steps: trace.steps.length\n43:   };\n44: }\n45: \n46: const userTwoSum = `\n47: def twoSum(nums, target):\n48:     prevMap = {}\n49:     for i in range(len(nums)):\n50:         diff = target - nums[i]\n51:         if diff in prevMap:\n52:             return [prevMap[diff], i]\n53:         prevMap[nums[i]] = i\n54:     return []\n55: `;\n56: \n57: console.log(\"Running test 1: [2, 7, 11, 15], 9...\");\n58: const t1 = runPythonFunction(userTwoSum, \"twoSum\", [[2, 7, 11, 15], 9]);\n59: console.log(\"Test 1 Result:\", t1.result, \"Expected: [0, 1]\", \"Matches?\", JSON.stringify(t1.result) === JSON.stringify([0, 1]));\n60: \n61: console.log(\"Running test 2: [3, 2, 4], 6...\");\n62: const t2 = runPythonFunction(userTwoSum, \"twoSum\", [[3, 2, 4], 6]);\n63: console.log(\"Test 2 Result:\", t2.result, \"Expected: [1, 2]\", \"Matches?\", JSON.stringify(t2.result) === JSON.stringify([1, 2]));\n64: \n65: console.log(\"Running test 3: [3, 3], 6...\");\n66: const t3 = runPythonFunction(userTwoSum, \"twoSum\", [[3, 3], 6]);\n67: console.log(\"Test 3 Result:\", t3.result, \"Expected: [0, 1]\", \"Matches?\", JSON.stringify(t3.result) === JSON.stringify([0, 1]));\n68: \nThe above content shows the entire, complete file contents of the requested file.\n"}
