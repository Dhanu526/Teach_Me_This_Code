r(x) > 0).map(Number))] \n    : [];\n\n  const cleanReview = Array.isArray(prog.review) \n    ? [...new Set(prog.review.filter(x => Number.isInteger(Number(x)) && Number(x) > 0).map(Number))] \n    : [];\n\n  const cleanBookmarked = Array.isArray(prog.bookmarked) \n    ? [...new Set(prog.bookmarked.filter(x => Number.isInteger(Number(x)) && Number(x) > 0).map(Number))] \n    : [];\n\n  const cleanNotes = {};\n  if (prog.notes && typeof prog.notes === 'object' && !Array.isArray(prog.notes)) {\n    Object.keys(prog.notes).forEach(k => {\n      const pid = parseInt(k, 10);\n      if (pid > 0 && typeof prog.notes[k] === 'string') {\n        cleanNotes[pid] = prog.notes[k].trim();\n      }\n    });\n  }\n\n  let cleanStage = 1;\n  const rawStage = (data.roadmap && data.roadmap.activeStage) || prog.activeStage || data.activeStage;\n  if (rawStage) {\n    const sNum = parseInt(rawStage, 10);\n    if (!isNaN(sNum) && sNum >= 1 && sNum <= 10) cleanStage = sNum;\n    else warnings.push('Invalid activeStage (' + rawStage + ') clamped to 1.');\n  }\n\n  const cleanSettings = {};\n  const rawSettings = data.settings || {};\n  if (typeof rawSettings === 'object') {\n    if (['10', '25', '50', '100', 'all', 10, 25, 50, 100].includes(rawSettings.pageSize)) {\n      cleanSettings.pageSize = rawSettings.pageSize === 'all' ? 'all' : parseInt(rawSettings.pageSize, 10);\n    }\n    if (['order_asc', 'order_desc', 'title_asc', 'title_desc', 'diff_asc', 'diff_desc', 'lc_asc', 'lc_desc'].includes(rawSettings.selectedSort)) {\n      cleanSettings.selectedSort = rawSettings.selectedSort;\n    }\n    if (typeof rawSettings.codeFontSize === 'string') {\n      cleanSettings.codeFontSize = rawSettings.codeFontSize;\n    }\n  }\n\n  const cleanCode = {};\n  const rawCode = data.userCode || {};\n  if (typeof rawCode === 'object') {\n    Object.keys(rawCode).forEach(k => {\n      const pid = parseInt(k, 10);\n      if (pid > 0 && typeof rawCode[k] === 'string') {\n        cleanCode[pid] = rawCode[k];\n      }\n    });\n  }\n\n  const isValid = errors.length === 0 && (cleanSolved.length > 0 || cleanAttempted.length > 0 || cleanBookmarked.length > 0 || Object.keys(cleanNotes).length > 0 || Object.keys(cleanCode).length > 0);\n\n  if (!isValid && errors.length === 0) {\n    errors.push('Backup file contains no recognizable learning progress data.');\n  }\n\n  return {\n    isValid,\n    errors,\n    warnings,\n    stats: {\n      solvedCount: cleanSolved.length,\n      attemptedCount: cleanAttempted.length,\n      bookmarkedCount: cleanBookmarked.length,\n      reviewCount: cleanReview.length,\n      notesCount: Object.keys(cleanNotes).length,\n      userCodeCount: Object.keys(cleanCode).length,\n      activeStage: cleanStage\n    },\n    cleanData: {\n      solved: cleanSolved,\n      attempted: cleanAttempted,\n      review: cleanReview,\n      bookmarked: cleanBookmarked,\n      notes: cleanNotes,\n      history: Array.isArray(prog.history) ? prog.history.filter(h => h && h.problemId) : [],\n      lastPracticedId: prog.lastPracticedId || null,\n      lastOpenedProblemId: prog.lastOpenedProblemId || 1,\n      activeStage: cleanStage,\n      settings: cleanSettings,\n      userCode: cleanCode\n    }\n  };\n}\n\nconsole.log('Testing valid backup:');\nconsole.log(validateProgressImport({ progress: { solved: [1, 2], notes: { '1': 'good' } } }).isValid);\nconsole.log('Testing malformed string:');\nconsole.log(validateProgressImport('{invalid json').errors);\nconsole.log('Testing empty object:');\nconsole.log(validateProgressImport({}).errors);\n\"","Cwd":"C:/Users/CVT/.gemini/antigravity/scratch/code-flow-visualizer","IsDaemon":false,"WaitMsBeforeAsync":5000,"toolAction":"Prototyping validation logic","toolSummary":"Prototype validation logic"}}]}
