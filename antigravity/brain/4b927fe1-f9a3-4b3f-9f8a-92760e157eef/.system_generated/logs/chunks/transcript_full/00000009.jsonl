und) {\n1641:         status = found.status;\n1642:         prevStr = found.status === \"created\" ? \"—\" : this.formatVal(found.prevValue);\n1643:       }\n1644: \n1645:       return {\n1646:         name,\n1647:         previous: prevStr,\n1648:         current: this.formatVal(val),\n1649:         rawValue: Array.isArray(val) ? [...val] : val,\n1650:         type: this.getPythonType(val),\n1651:         status\n1652:       };\n1653:     });\n1654:   }\n1655: \n1656:   substituteVarsInExpr(expr, scopeVars) {\n1657:     let result = expr;\n1658:     const sortedNames = Object.keys(scopeVars).sort((a, b) => b.length - a.length);\n1659:     for (const name of sortedNames) {\n1660:       const regex = new RegExp(`\\\\b${name}\\\\b`, \"g\");\n1661:       result = result.replace(regex, this.formatVal(scopeVars[name]));\n1662:     }\n1663:     return result;\n1664:   }\n1665: \n1666:   splitTopLevelArgs(str) {\n1667:     if (!str.trim()) return [];\n1668:     const res = [];\n1669:     let current = \"\";\n1670:     let depth = 0;\n1671:     let inSingle = false;\n1672:     let inDouble = false;\n1673: \n1674:     for (let i = 0; i < str.length; i++) {\n1675:       const ch = str[i];\n1676:       if (ch === \"'\" && !inDouble) inSingle = !inSingle;\n1677:       else if (ch === '\"' && !inSingle) inDouble = !inDouble;\n1678:       else if (!inSingle && !inDouble) {\n1679:         if (ch === \"(\" || ch === \"[\") depth++;\n1680:         else if (ch === \")\" || ch === \"]\") depth--;\n1681:         else if (ch === \",\" && depth === 0) {\n1682:           res.push(current.trim());\n1683:           current = \"\";\n1684:           continue;\n1685:         }\n1686:       }\n1687:       current += ch;\n1688:     }\n1689:     if (current.trim()) res.push(current.trim());\n1690:     return res;\n1691:   }\n1692: \n1693:   getPythonType(val) {\n1694:     if (val === null || val === undefined) return \"NoneType\";\n1695:     if (Array.isArray(val)) return \"list\";\n1696:     if (typeof val === \"boolean\") return \"bool\";\n1697:     if (typeof val === \"number\") return Number.isInteger(val) ? \"int\" : \"float\";\n1698:     if (typeof val === \"string\") return \"str\";\n1699:     return typeof val;\n1700:   }\n1701: \n1702:   formatVal(val) {\n1703:     if (val === null || val === undefined) return \"None\";\n1704:     if (typeof val === \"boolean\") return val ? \"True\" : \"False\";\n1705:     if (typeof val === \"string\") return `\"${val}\"`;\n1706:     if (Array.isArray(val)) return `[${val.map((v) => this.formatVal(v)).join(\", \")}]`;\n1707:     return String(val);\n1708:   }\n1709: \n1710:   buildControlFlowGraph(statements) {\n1711:     const nodes = [];\n1712:     const edges = [];\n1713: \n1714:     const addNode = (id, label, type, line) => {\n1715:       nodes.push({ id, label, type, line });\n1716:       return id;\n1717:     };\n1718: \n1719:     const startId = addNode(\"start\", \"START\", \"start\", 0);\n1720: \n1721:     const buildList = (stmts, prevIds) => {\n1722:       let currentPrevs = prevIds;\n1723:       for (const s of stmts) {\n1724:         if (s.kind === \"CLASS\") {\n1725:           const cid = addNode(`L${s.line}`, `class ${s.className}`, \"class\", s.line);\n1726:           currentPrevs.forEach((p) => edges.push({ from: p, to: cid }));\n1727:           currentPrevs = buildList(s.body, [cid]);\n1728:         } else if (s.kind === \"DEF\") {\n1729:           const fid = addNode(`L${s.line}`, `def ${s.funcName}()`, \"func\", s.line);\n1730:           currentPrevs.forEach((p) => edges.push({ from: p, to: fid }));\n1731:           currentPrevs = buildList(s.body, [fid]);\n1732:         } else if (s.kind === \"IF_CHAIN\") {\n1733:           const exitIds = [];\n1734:           let condPrevIds = currentPrevs;\n1735:           for (const br of s.branches) {\n1736:             if (br.type === \"else\") {\n1737:               const bodyEnd = buildList(br.body, condPrevIds);\n1738:               exitIds.push(...bodyEnd);\n1739:               condPrevIds = [];\n1740:             } else {\n1741:               const cid = addNode(`L${br.line}`, `${br.condition} ?`, \"decision\", br.line);\n1742:               condPrevIds.forEach((p) => edges.push({ from: p, to: cid }));\n1743:               const bodyEnd = buildList(br.body, [cid]);\n1744:               exitIds.push(...bodyEnd);\n1745:               condPrevIds = [cid];\n1746:             }\n1747:           }\n1748:           currentPrevs = [...exitIds, ...condPrevIds];\n1749:         } else if (s.kind === \"FOR\" || s.kind === \"WHILE\") {\n1750:           const label =\n1751:             s.kind === \"FOR\"\n1752:               ? `for ${s.iterVar} in ${s.iterExpr}`\n1753:               : `while ${s.condition}`;\n1754:           const loopId = addNode(`L${s.line}`, label, \"loop\", s.line);\n1755:           currentPrevs.forEach((p) => edges.push({ from: p, to: loopId }));\n1756:           const bodyEnd = buildList(s.body, [loopId]);\n1757:           bodyEnd.forEach((b) => edges.push({ from: b, to: loopId, isBackEdge: true }));\n1758:           currentPrevs = [loopId];\n1759:         } else {\n1760:           const type = s.text.startsWith(\"return\") ? \"return\" : \"stmt\";\n1761:           const nid = addNode(\n1762:             `L${s.line}`,\n1763:             s.text.length > 26 ? s.text.slice(0, 24) + \"..\" : s.text,\n1764:             type,\n1765:             s.line\n1766:           );\n1767:           currentPrevs.forEach((p) => edges.push({ from: p, to: nid }));\n1768:           currentPrevs = [nid];\n1769:         }\n1770:       }\n1771:       return currentPrevs;\n1772:     };\n1773: \n1774:     const lastIds = buildList(statements, [startId]);\n1775:     const endId = addNode(\"end\", \"END\", \"end\", 9999);\n1776:     lastIds.forEach((p) => edges.push({ from: p, to: endId }));\n1777: \n1778:     return { nodes, edges };\n1779:   }\n1780: }\n1781: \n1782: window.PRELOADED_PROGRAMS = PRELOADED_PROGRAMS;\n1783: windo