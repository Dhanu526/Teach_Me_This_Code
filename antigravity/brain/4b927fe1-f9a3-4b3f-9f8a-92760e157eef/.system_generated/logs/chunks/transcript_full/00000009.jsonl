{"step_index":110,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-10T11:26:33Z","content":"Created At: 2026-10-10T16:56:33+05:30\nCompleted At: 2026-10-10T16:56:33+05:30\nFile Path: `file:///C:/Users/CVT/.gemini/antigravity/scratch/code-flow-visualizer/explainer.py`\nTotal Lines: 160\nTotal Bytes: 8339\nShowing lines 1 to 160\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: explainer.py — Rule-Based Teaching System & Built-In Code Questions Engine\n3: 100% deterministic, zero AI APIs. Generates beginner and technical explanations\n4: from actual runtime execution snapshots.\n5: \"\"\"\n6: \n7: from typing import Any, Dict, List\n8: \n9: PYTHON_SYMBOL_DICTIONARY = {\n10:     \"class\": \"`class` defines a blueprint that groups related functions (methods) together.\",\n11:     \"def\": \"`def` defines a function or method — a reusable block of code that runs when called.\",\n12:     \"return\": \"`return` stops the function immediately and sends a result value back to the caller.\",\n13:     \"for\": \"`for` starts a loop that repeats its indented block once for each item in a sequence.\",\n14:     \"while\": \"`while` starts a loop that keeps repeating as long as its condition remains `True`.\",\n15:     \"in\": \"`in` pairs a loop variable with the sequence of values it steps through.\",\n16:     \"range(\": \"`range(n)` generates a sequence of numbers starting from `0` up to `n - 1`.\",\n17:     \"len(\": \"`len(x)` counts and returns the total number of items inside list or string `x`.\",\n18:     \"+=\": \"`+=` adds the right-hand value to the variable on the left and stores the new total back in that variable.\",\n19:     \"-=\": \"`-=` subtracts the right-hand value from the variable on the left and updates it.\",\n20:     \">=\": \"`>=` tests whether the left value is greater than or equal to the right value (`True` or `False`).\",\n21:     \"<=\": \"`<=` tests whether the left value is less than or equal to the right value (`True` or `False`).\",\n22:     \"==\": \"`==` compares two values for equality (`True` if equal, `False` otherwise).\",\n23:     \"!=\": \"`!=` checks whether two values are different (`True` if not equal).\",\n24:     \"<\": \"`<` checks if the left value is strictly smaller than the right value.\",\n25:     \">\": \"`>` checks if the left value is strictly larger than the right value.\",\n26:     \"=\": \"`=` is the assignment operator: it calculates the right side first and stores it in the variable on the left.\",\n27:     \"[]\": \"Square brackets `[i]` access the element at index position `i` inside a list (starting at index `0`).\",\n28:     \"->\": \"`->` is a type hint showing what data type the function is expected to return.\",\n29: }\n30: \n31: \n32: def explain_symbols_in_line(code_text: str) -> str:\n33:     found = []\n34:     for sym, desc in PYTHON_SYMBOL_DICTIONARY.items():\n35:         if sym in code_text:\n36:             found.append(f\"• {desc}\")\n37:     if not found:\n38:         return \"• Standard Python expression evaluation.\"\n39:     return \"\\n\".join(found[:3])\n40: \n41: \n42: def generate_step_explanation(step: Dict[str, Any], prev_step: Dict[str, Any] = None) -> Dict[str, str]:\n43:     \"\"\"\n44:     Produces the 7 required Beginner Explanation fields (in both Beginner and Technical modes)\n45:     from a recorded execution step.\n46:     \"\"\"\n47:     code = step.get(\"codeText\", \"\").strip()\n48:     event = step.get(\"event\", \"line\")\n49:     cond = step.get(\"condition\")\n50:     op_detail = step.get(\"operationDetail\")\n51:     changed = step.get(\"changedSummary\", \"No variable values changed\")\n52:     before_vars = step.get(\"beforeVars\", {})\n53: \n54:     # 1. What the current line does (Beginner & Technical)\n55:     if code.startswith(\"class \"):\n56:         what_beg = f\"Creates a class named `{code.split()[1].rstrip(':')}`. Inside it are methods that can be called later.\"\n57:         what_tech = f\"Executes `ClassDef` statement `{code}`, creating the class namespace and binding its methods.\"\n58:     elif code.startswith(\"def \"):\n59:         what_beg = (\n60:             f\"Defines the method/function `{code}`. Python remembers the function body when it is defined, \"\n61:             f\"and starts executing the lines inside when the function is called.\"\n62:         )\n63:         what_tech = f\"Function header `{code}` reached (`{event}` event) in scope `{step.get('functionName')}`.\"\n64:     elif op_detail and op_detail.get(\"kind\") == \"aug_assign\":\n65:         t = op_detail[\"target\"]\n66:         b = op_detail[\"beforeVal\"]\n67:         rv = op_detail[\"rhsVal\"]\n68:         op = op_detail[\"op\"]\n69:         after_v = next((v[\"current\"] for v in step[\"variables\"] if v[\"name\"] == t), \"?\")\n70:         what_beg = (\n71:             f\"Python adds the current value `{rv}` (`{op_detail['rhsExpr']}`) to `{t}` (which was `{b}`): \"\n72:             f\"`{b} {op} ({rv}) = {after_v}`, and stores `{after_v}` back in `{t}`.\"\n73:         )\n74:         what_tech = (\n75:             f\"Augmented assignment `{code}` evaluates `{t} {op} {op_detail['rhsExpr']}` \"\n76:             f\"(`{b} {op} {rv} -> {after_v}`) and rebinds `{t}`.\"\n77:         )\n78:     elif cond:\n79:         res_str = \"True\" if cond[\"result\"] else \"False\"\n80:         what_beg = (\n81:             f\"Compares `{cond['expr']}` using current values: `{cond['leftVal']} {cond['operator']} {cond['rightVal']}`. \"\n82:             f\"The result is **{res_str}**.\"\n83:         )\n84:         what_tech = (\n85:             f\"Conditional branch predicate `{cond['expr']}` evaluates operands \"\n86:             f\"(`{cond['leftVal']}` {cond['operator']} `{cond['rightVal']}`) to boolean `{res_str}`.\"\n87:         )\n88:     elif code.startswith(\"for \"):\n89:         iter_num = step[\"loop\"][\"iteration\"] if step.get(\"loop\") else \"?\"\n90:         what_beg = f\"Runs loop check #{iter_num} for `{code}`, advancing the loop variable to the next sequence value.\"\n91:         what_tech = f\"For-loop header `{code}` advances iterator (pass #{iter_num}) and binds loop target variable.\"\n92:     elif code.startswith(\"return\"):\n93:         ret_v = step.get(\"returnValue\") or next(\n94:             (v[\"current\"] for v in step[\"variables\"] if v[\"name\"] in code), \"None\"\n95:         )\n96:         what_beg = f\"Sends the final calculated value `{ret_v}` back to the code that called this function.\"\n97:         what_tech = f\"`return` statement unwinds stack frame `{step.get('functionName')}` with return value `{ret_v}`.\"\n98:     elif \"=\" in code and not code.startswith((\"if \", \"elif \", \"while \")):\n99:         lhs = code.split(\"=\")[0].strip()\n100:         after_v = next((v[\"current\"] for v in step[\"variables\"] if v[\"name\"] == lhs), \"?\")\n101:         what_beg = f\"Variable `{lhs}` is assigned the value `{after_v}`.\"\n102:         what_tech = f\"Assignment statement `{code}` evaluates the right-hand expression and binds `{lhs} = {after_v}`.\"\n103:     else:\n104:         what_beg = f\"Executes statement `{code}` on line {step.get('line')}.\"\n105:         what_tech = f\"Executes AST statement at line {step.get('line')} in `{step.get('functionName')}`.\"\n106: \n107:     # 2. Symbols meaning\n108:     symbols_meaning = explain_symbols_in_line(code)\n109: \n110:     # 3. Why this line is executing\n111:     if not prev_step:\n112:         why_now = f\"Line {step.get('line')} is the first line executed when the program starts.\"\n113:     elif prev_step.get(\"condition\"):\n114:         prev_c = prev_step[\"condition\"]\n115:         if prev_c[\"result\"]:\n116:             why_now = f\"Because `{prev_c['expr']}