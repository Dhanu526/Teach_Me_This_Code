           const diffClass = sp.difficulty.toLowerCase();\r\n1988:                     return `\r\n1989:                       <div class=\"roadmap-starter-chip ${spSolved ? 'chip-solved' : ''}\">\r\n1990:                         <div class=\"starter-chip-top\">\r\n1991:                           <span class=\"lc-badge\">#${sp.leetcodeNumber}</span>\r\n1992:                           <span class=\"diff-badge diff-${diffClass}\">${sp.difficulty}</span>\r\n1993:                           ${spSolved ? '<span class=\"status-solved-dot\" title=\"Solved\">✓</span>' : ''}\r\n1994:                         </div>\r\n1995:                         <div class=\"starter-chip-title\">${this.escapeHTML(sp.title)}</div>\r\n1996:                         <div class=\"starter-chip-pattern\">${this.escapeHTML(sp.pattern)}</div>\r\n1997:                         <button class=\"btn-chip-visualize\" data-action=\"solve-visualize\" data-id=\"${sp.id}\">\r\n1998:                           ▶ Step\r\n1999:                         </button>\r\n2000:                       </div>\r\n2001:                     `;\r\n2002:                   }).join('')}\r\n2003:                 </div>\r\n2004:               </div>\r\n2005: \r\n2006:               <div class=\"roadmap-card-footer\">\r\n2007:                 <button class=\"btn-hero-primary\" data-action=\"explore-phase\" data-phase=\"${p.phase}\">\r\n2008:                   Explore Phase ${p.phase} Topics & Problems →\r\n2009:                 </button>\r\n2010:               </div>\r\n2011:             </div>\r\n2012:           </div>\r\n2013:         `;\r\n2014:       }).join('');\r\n2015: \r\n2016:       return `\r\n2017:         <div class=\"dsa-full-roadmap-wrap\">\r\n2018:           <div class=\"roadmap-intro-card\">\r\n2019:             <h2>🗺️ The 8-Phase Step-by-Step DSA Mastery Path</h2>\r\n2020:             <p>\r\n2021:               Designed for complete beginners and intermediate learners alike. Follow this structured pedagogical sequence