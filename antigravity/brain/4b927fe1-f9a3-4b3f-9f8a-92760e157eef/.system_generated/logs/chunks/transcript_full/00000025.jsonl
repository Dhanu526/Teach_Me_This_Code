   AREA 2: TEACHING AREA, QUICK ITERATION BAR & THONNY STEPPER\n686:      ========================================================= */\n687:   renderArea2Teaching(step) {\n688:     const lesson = step.teacherLesson;\n689: \n690:     // Render Quick Iteration / Phase Pills Bar\n691:     this.renderQuickIterationBar();\n692: \n693:     this.teachStepTitle.textContent = lesson.title;\n694:     this.teachCodeBox.innerHTML = this.highlightPythonSyntax(step.codeText);\n695: \n696:     // Render Thonny Step-by-Step Expression Evaluator\n697:     this.renderThonnyExpressionStepper(step);\n698: \n699:     // Calculation Breakdown Card\n700:     if (lesson.calculationCard) {\n701:       const c = lesson.calculationCard;\n702:       this.teachCalculationBox.classList.remove(\"hidden\");\n703: \n704:       if (c.currentNumber !== null && c.currentNumber !== undefined) {\n705:         this.calcCurrentNumRow.classList.remove(\"hidden\");\n706:         this.calcCurrentNumVal.textContent = c.currentNumber;\n707:       } else {\n708:         this.calcCurrentNumRow.classList.add(\"hidden\");\n709:       }\n710: \n711:       this.calcBeforeVal.textContent = c.before;\n712:       this.calcFormulaVal.textContent = c.calculation;\n713:       this.calcAfterVal.textContent = c.after;\n714:     } else {\n715:       this.teachCalculationBox.classList.add(\"hidden\");\n716:     }\n717: \n718:     this.teachMeaningText.innerHTML = this.formatMarkdown(lesson.whatItMeans);\n719:     this.teachVarsNowBox.textContent = lesson.variableValuesNow;\n720:     this.teachNextText.innerHTML = this.formatMarkdown(lesson.whatHappensNext);\n721: \n722:     if (lesson.finalBanner) {\n723:       this.finalAnswerBanner.classList.remove(\"hidden\");\n724:       this.finalAnswerHeading.textContent = `Final answer: ${lesson.finalBanner.answer}`;\n725:       this.finalAnswerDetail.innerHTML = this.formatMarkdown(lesson.finalBanner.summary);\n726:     } else {\n727:       this.finalAnswerBanner.classList.add(\"hidden\");\n728:     }\n729:   }\n730: \n731:   renderQuickIterationBar() {\n732:     if (!this.iterationPillsBar) return;\n733:     this.iterationPillsBar.innerHTML = \"\";\n734:     let activePillEl = null;\n735: \n736:     const activeGroupIdx = this.stepToGroupIdx.get(this.currentStepIdx) ?? 0;\n737:     const activeGroup = this.iterationGroups[activeGroupIdx];\n738: \n739:     if (this.activeIterationBadge && activeGroup) {\n740:       this.activeIterationBadge.textContent = `${activeGroup.badge} (${activeGroupIdx + 1}/${this.iterationGroups.length})`;\n741:     }\n742: \n743:     this.iterationGroups.forEach((grp, gIdx) => {\n744:       const btn = document.createElement(\"button\");\n745:       btn.type = \"button\";\n746:       const isActive = gIdx === activeGroupIdx;\n747:       const isPast = gIdx < activeGroupIdx;\n748:       btn.className = `iter-pill-btn ${isActive ? \"is-active-iter-pill\" : isPast ? \"is-past-iter-pill\" : \"\"}`;\n749:       if (isActive) {\n750:         activePillEl = btn;\n751:       }\n752:       btn.textContent = grp.pillLabel;\n753:       btn.title = `${grp.title} (Steps ${grp.startStepIdx + 1}–${grp.endStepIdx + 1})`;\n754:       btn.addEventListener(\"click\", () => {\n755:         this.stopAutoPlay();\n756:         this.goToStep(grp.startStepIdx);\n757:       });\n758:       this.iterationPillsBar.appendChild(btn);\n759:     });\n760: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
