showIterationsPanel = true;\n28: \n29:     this.currentStepIdx = 0;\n30:     this.currentSubstepIdx = 0;\n31:     this.currentSubStepIdx = 0;\n32:     this.showGCObjects = false;\n33:     this.animationsEnabled = true;\n34: \n35:     this.isPlaying = false;\n36:     this.playInterval = null;\n37:     this.playSpeedMs = 1200;\n38:     this.isEditing = false;\n39:     this.showAdvanced = false;\n40: \n41:     this.initDOM();\n42:     this.bindEvents();\n43:     this.codeTextarea.value = this.sourceCode;\n44:     this.analyzeAndRun();\n45:   }\n46: \n47:   initDOM() {\n48:     // Simple Navigation Controls\n49:     this.stepProgressLabel = document.getElementById(\"stepProgressLabel\");\n50:     this.activeScopeBadge = document.getElementById(\"activeScopeBadge\");\n51:     this.btnPrev = document.getElementById(\"btnPrev\");\n52:     this.btnSubStep = document.getElementById(\"btnSubStep\");\n53:     this.btnNext = document.getElementById(\"btnNext\");\n54:     this.btnAutoPlay = document.getElementById(\"btnAutoPlay\");\n55:     this.btnRestart = document.getElementById(\"btnRestart\");\n56: \n57:     // Top Secondary Controls\n58:     this.btnToggleAnim = document.getElementById(\"btnToggleAnim\");\n59:     this.btnEditCode = document.getElementById(\"btnEditCode\");\n60:     this.btnAnalyzeCode = document.getElementById(\"btnAnalyzeCode\");\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
