.showIterationsPanel = true;\n28: \n29:     this.currentStepIdx = 0;\n30:     this.currentSubStepIdx = 0;\n31:     this.showGCObjects = false;\n32: \n33:     this.isPlaying = false;\n34:     this.playInterval = nu\n<truncated 11763 bytes>\nZ_]\\w*)/gm)].map((m) => m[1]);\n284:     if (classMatches.length > 0) {\n285:       return `Visualizing class \\`${classMatches.join(\", \")}\\` and its methods (${funcMatches.join(\", \")}) step-by-step.`;\n286:     }\n287:     if (funcMatches.length > 0) {\n288:       return `Visualizing function \\`${funcMatches.join(\", \")}()\\` execution, iterations, local scope frames, and memory references.`;\n289:     }\n290:     return \"Visualizing your Python program step-by-step with Iterations, Stack Scopes, and Heap Memory addresses.\";\n291:   }\n292: \n293:   async analyzeAndRun() {\n294:     this.stopAutoPlay();\n295:     this.overviewText.textContent = this.buildDynamicOverview(this.sourceCode);\n296: \n297:     let rawTrace = this.engine.trace(this.sourceCode, this.inputCode);\n298: \n299:     // Hybrid execution: if running via server.py (http/https) and the browser engine hits complex Python syntax,\n300:     // automatically use the real Python `sys.settrace` + `ast` backend (`/api/trace`)!\n301:     if (!rawTrace.ok && window.location.protocol.startsWith(\"http\")) {\n302:       try {\n303:         const resp = await fetch(\"/api/trace\", {\n304:           method: \"POST\",\n305:           headers: { \"Content-Type\": \"application/json\" },\n306:           body: JSON.stringify({ sourceCode: this.sourceCode, inputCode: this.inputCode })\n307:         });\n308:         if (resp.ok) {\n309:           const backendTrace = await resp.json();\n310:           if (backendTrace && (backendTrace.ok || (backendTrace.steps && backendTrace.steps.length > 0))) {\n311:             rawTrace = backendTrace;\n312:           }\n313:         }\n314:       } catch (_) {\n315:         // Offline / static file mode: keep local browser trace result\n316:       }\n317:     }\n318: \n319:     this.traceResult = this.explainer.enrichTraceWithExplanations(rawTrace);\n320:     this.collapsedGroupIds.clear();\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
