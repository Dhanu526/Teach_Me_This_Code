{"step_index":1478,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-25T14:39:35Z","content":"Created At: 2026-10-25T20:09:35+05:30\nCompleted At: 2026-10-25T20:09:35+05:30\nFile Path: `file:///C:/Users/CVT/.gemini/antigravity/scratch/code-flow-visualizer/server.py`\nTotal Lines: 69\nTotal Bytes: 2565\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: server.py — Local HTTP Server & Execution API for Code Flow Visualizer\n3: Serves static frontend assets from `app_build/` and exposes `/api/validate` & `/api/trace`.\n4: Zero external dependencies or AI APIs required.\n5: Run: python server.py\n6: Open: http://127.0.0.1:8080\n7: \"\"\"\n8: \n9: import json\n10: import os\n11: from http.server import HTTPServer, SimpleHTTPRequestHandler\n12: from app_build.engine import trace_python_program, validate_python_support\n13: from app_build.explainer import generate_step_explanation\n14: \n15: PORT = 8080\n16: BASE_DIR = os.path.dirname(os.path.abspath(__file__))\n17: APP_BUILD_DIR = os.path.join(BASE_DIR, \"app_build\")\n18: \n19: \n20: class VisualizerRequestHandler(SimpleHTTPRequestHandler):\n21:     def __init__(self, *args, **kwargs):\n22:         super().__init__(*args, directory=APP_BUILD_DIR, **kwargs)\n23: \n24:     def _send_json(self, status_code: int, data: dict):\n25:         payload = json.dumps(data).encode(\"utf-8\")\n26:         self.send_response(status_code)\n27:         self.send_header(\"Content-Type\", \"application/json\")\n28:         self.send_header(\"Content-Length\", str(len(payload)))\n29:         self.end_headers()\n30:         self.wfile.write(payload)\n31: \n32:     def do_GET(self):\n33:         if self.path == \"/favicon.ico\":\n34:             self.send_response(204)\n35:             self.end_headers()\n36:             return\n37:         if self.path.startswith(\"/app_build/\"):\n38:             self.path = self.path[len(\"/app_build\") :]\n39:         super().do_GET()\n40: \n41:     def do_POST(self):\n42:         length = int(self.headers.get(\"Content-Length\", 0))\n43:         raw_body = self.rfile.read(length).decode(\"utf-8\") if length > 0 else \"{}\"\n44:         body = json.loads(raw_body)\n45: \n46:         if self.path == \"/api/validate\":\n47:             code = body.get(\"code\", \"\")\n48:             ok, msg, ln = validate_python_support(code)\n49:             self._send_json(200, {\"ok\": ok, \"errorMessage\": msg, \"errorLine\": ln})\n50:             return\n51: \n52:         if self.path == \"/api/trace\":\n53:             code = body.get(\"code\", \"\")\n54:             custom_input = body.get(\"input\", \"\")\n55:             result = trace_python_program(code, custom_input)\n56:             steps = result.get(\"steps\", [])\n57:             for idx, st in enumerate(steps):\n58:                 prev_st = steps[idx - 1] if idx > 0 else None\n59:                 st[\"explanations\"] = generate_step_explanation(st, prev_st)\n60:             self._send_json(200, result)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
