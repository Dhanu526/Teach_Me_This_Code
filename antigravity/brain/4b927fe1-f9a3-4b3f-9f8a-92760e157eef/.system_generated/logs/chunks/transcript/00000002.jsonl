   case \"what_happens_next\":\n492:         return lesson.whatHappensNext;\n493:       case \"what_symbol_means\":\n494:         return step.explanations.symbolsMeaning;\n495:       default:\n496:         return lesson.whatItMeans;\n497:     }\n498:   }\n499: }\n500: \n501: window.RuleBasedExplainer = RuleBasedExplainer;\n502: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
{"step_index":103,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-10T11:21:09Z","content":"Created At: 2026-10-10T16:51:09+05:30\nCompleted At: 2026-10-10T16:51:10+05:30\nFile Path: `file:///C:/Users/CVT/.gemini/antigravity/scratch/code-flow-visualizer/server.py`\nTotal Lines: 65\nTotal Bytes: 2280\nShowing lines 1 to 65\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: server.py — Local HTTP Server & Execution API for Code Flow Visualizer\n3: Zero external dependencies or AI APIs required.\n4: Run: python server.py\n5: Open: http://127.0.0.1:8080\n6: \"\"\"\n7: \n8: import json\n9: import os\n10: from http.server import HTTPServer, SimpleHTTPRequestHandler\n11: from engine import trace_python_program, validate_python_support\n12: from explainer import generate_step_explanation\n13: \n14: PORT = 8080\n15: BASE_DIR = os.path.dirname(os.path.abspath(__file__))\n16: \n17: \n18: class VisualizerRequestHandler(SimpleHTTPRequestHandler):\n19:     def __init__(self, *args, **kwargs):\n20:         super().__init__(*args, directory=BASE_DIR, **kwargs)\n21: \n22:     def _send_json(self, status_code: int, data: dict):\n23:         payload = json.dumps(data).encode(\"utf-8\")\n24:         self.send_response(status_code)\n25:         self.send_header(\"Content-Type\", \"application/json\")\n26:         self.send_header(\"Content-Length\", str(len(payload)))\n27:         self.end_headers()\n28:         self.wfile.write(payload)\n29: \n30:     def do_GET(self):\n31:         if self.path == \"/favicon.ico\":\n32:             self.send_response(204)\n33:             self.end_headers()\n34:             return\n35:         super().do_GET()\n36: \n37:     def do_POST(self):\n38:         length = int(self.headers.get(\"Content-Length\", 0))\n39:         raw_body = self.rfile.read(length).decode(\"utf-8\") if length > 0 else \"{}\"\n40:         body = json.loads(raw_body)\n41: \n42:         if self.path == \"/api/validate\":\n43:             code = body.get(\"code\", \"\")\n44:             ok, msg, ln = validate_python_support(code)\n45:             self._send_json(200, {\"ok\": ok, \"errorMessage\": msg, \"errorLine\": ln})\n46:             return\n47: \n48:         if self.path == \"/api/trace\":\n49:             code = body.get(\"code\", \"\")\n50:             custom_input = body.get(\"input\", \"\")\n51:             result = trace_python_program(code, custom_input)\n52:             steps = result.get(\"steps\", [])\n53:             for idx, st in enumerate(steps):\n54:                 prev_st = steps[idx - 1] if idx > 0 else None\n55:                 st[\"explanations\"] = generate_step_explanation(st, prev_st)\n56:             self._send_json(200, result)\n57:             return\n58: \n59:         self._send_json(404, {\"error\": \"Endpoint not found\"})\n60: \n61: \n62: if __name__ == \"__main__\":\n63:     print(f\"Code Flow Visualizer running locally at http://127.0.0.1:{PORT}\")\n64:     HTTPServer((\"127.0.0.1\", PORT), VisualizerRequestHandler).serve_forever()\n65: \nThe above content shows the entire, complete file contents of the requested file.\n"}
