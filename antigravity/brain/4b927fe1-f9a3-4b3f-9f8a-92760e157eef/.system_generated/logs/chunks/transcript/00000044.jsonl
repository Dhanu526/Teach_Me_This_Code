{"step_index":2272,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-27T10:16:40Z","content":"Created At: 2026-10-27T15:46:40+05:30\nCompleted At: 2026-10-27T15:46:40+05:30\nFile Path: `file:///C:/Users/CVT/.gemini/antigravity/brain/4b927fe1-f9a3-4b3f-9f8a-92760e157eef/scratch/test_runner_prototype.js`\nTotal Lines: 68\nTotal Bytes: 2455\nShowing lines 1 to 68\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: const fs = require('fs');\n2: const vm = require('vm');\n3: const path = require('path');\n4: \n5: const engineCode = fs.readFileSync(path.join(__dirname, '..', '..', '..', 'scratch', 'code-flow-visualizer', 'app_build', 'engine.js'), 'utf8');\n6: const sandbox = { console, Math, Number, String, Array, Object, Set, Map, JSON, Date, window: {} };\n7: vm.createContext(sandbox);\n8: vm.runInContext(engineCode, sandbox);\n9: \n10: const PythonExecutionEngine = sandbox.window.PythonExecutionEngine;\n11: const engine = new PythonExecutionEngine();\n12: \n13: // Prototype function runner\n14: function runPythonFunction(userCode, funcName, args) {\n15:   // Construct wrapper script that defines function and executes call\n16:   const argsJson = JSON.stringify(args).slice(1, -1); // strip [ and ]\n17:   const harness = `\n18: ${userCode}\n19: \n20: __test_result__ = ${funcName}(${argsJson})\n21: print(\"__RESULT__:\", __test_result__)\n22: `;\n23: \n24:   const trace = engine.trace(harness, \"\");\n25:   if (!trace.ok) {\n26:     return { ok: false, error: trace.error || \"Syntax / Execution Error\" };\n27:   }\n28: \n29:   // Find output from stdout or __test_result__ in global scope\n30:   const lastStep = trace.steps[trace.steps.length - 1];\n31:   let resultVal = null;\n32:   if (lastStep.scopes && lastStep.scopes.global) {\n33:     const varObj = lastStep.scopes.global.find(v => v.name === '__test_result__');\n34:     if (varObj) resultVal = varObj.rawValue;\n35:   }\n36: \n37:   let printedLines = lastStep.stdout || [];\n38:   return {\n39:     ok: true,\n40:     result: resultVal,\n41:     stdout: printedLines,\n42:     steps: trace.steps.length\n43:   };\n44: }\n45: \n46: const userTwoSum = `\n47: def twoSum(nums, target):\n48:     prevMap = {}\n49:     for i in range(len(nums)):\n50:         diff = target - nums[i]\n51:         if diff in prevMap:\n52:             return [prevMap[diff], i]\n53:         prevMap[nums[i]] = i\n54:     return []\n55: `;\n56: \n57: console.log(\"Running test 1: [2, 7, 11, 15], 9...\");\n58: const t1 = runPythonFunction(userTwoSum, \"twoSum\", [[2, 7, 11, 15], 9]);\n59: console.log(\"Test 1 Result:\", t1.result, \"Expected: [0, 1]\", \"Matches?\", JSON.stringify(t1.result) === JSON.stringify([0, 1]));\n60: \n61: console.log(\"Running test 2: [3, 2, 4], 6...\");\n62: const t2 = runPythonFunction(userTwoSum, \"twoSum\", [[3, 2, 4], 6]);\n63: console.log(\"Test 2 Result:\", t2.result, \"Expected: [1, 2]\", \"Matches?\", JSON.stringify(t2.result) === JSON.stringify([1, 2]));\n64: \n65: console.log(\"Running test 3: [3, 3], 6...\");\n66: const t3 = runPythonFunction(userTwoSum, \"twoSum\", [[3, 3], 6]);\n67: console.log(\"Test 3 Result:\", t3.result, \"Expected: [0, 1]\", \"Matches?\", JSON.stringify(t3.result) === JSON.stringify([0, 1]));\n68: \nThe above content shows the entire, complete file contents of the requested file.\n"}
