nslateY(-1px);\\n}\\n\\n.test-chip.active {\\n  background: #dbeafe;\\n  border-color: #2563eb;\\n  color: #1e40af;\\n  font-weight: 700;\\n  box-shadow: 0 1px 3px rgba(37, 99, 235, 0.15);\\n}\\n\\n.teach-next-box {\"","StartLine":"1305","TargetContent":"\"/* Optional Toggle: Disable animations if user toggles off */\\nbody.no-animations *,\\nbody.no-animations *::before,\\nbody.no-animations *::after {\\n  animation: none !important;\\n  transition: none !important;\\n}\\n\\n.teach-next-box {\"","TargetFile":"\"C:/Users/CVT/.gemini/antigravity/scratch/code-flow-visualizer/app_build/styles.css\"","toolAction":"\"Adding reduced motion and test inputs styles to styles.css\"","toolSummary":"\"Add reduced motion and test input styles\""}}]}
