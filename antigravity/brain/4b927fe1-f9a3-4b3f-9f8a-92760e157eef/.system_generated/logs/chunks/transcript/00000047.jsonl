\"ID {p['id']}: LC {p.get('leetcodeNumber')} - '{p['title']}' (Topic: {p.get('primaryTopic')})\\\")\\n    else:\\n        print(f\\\"NOT FOUND: {name} (LC {lc})\\\")\\n\"","Description":"\"Find IDs of canonical problems\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\CVT\\\\.gemini\\\\antigravity\\\\brain\\\\4b927fe1-f9a3-4b3f-9f8a-92760e157eef\\\\scratch\\\\find_canonical_ids.py\"","toolAction":"\"Writing find_canonical_ids.py\"","toolSummary":"\"Find canonical problem IDs\""}}]}
