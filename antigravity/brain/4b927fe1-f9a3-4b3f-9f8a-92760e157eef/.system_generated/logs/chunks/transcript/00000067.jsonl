headers()\n36:             return\n37:         if self.path.startswith(\"/app_build/\"):\n38:             self.path = self.path[len(\"/app_build\") :]\n39:         super().do_GET()\n40: \n41:     def do_POST(self):\n42:         length = int(self.headers.get(\"Content-Length\", 0))\n43:         raw_body = self.rfile.read(length).decode(\"utf-8\") if length > 0 else \"{}\"\n44:         body = json.loads(raw_body)\n45: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
